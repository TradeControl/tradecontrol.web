{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "OAuthBroker": {
    "AuthorityEnvironment": "sandbox",
    "CallbackPath": "/TaxHub/HmrcCallback",
    "StateContainerName": "oauth-broker-state",
    "EnvelopeKeyEnvironmentVariable": "OAUTH_BROKER_ENVELOPE_KEY",
    "AllowedReturnHosts": []
  }
}
