{
  "AllowedHosts": "alpha.example.test;beta.example.test",
  "Tenancy": {
    "SharedHostEnabled": true,
    "SeedOnStartup": false,
    "DirectorySource": "Catalogue",
    "CatalogueConnectionStringName": "TenantCatalogue",
    "TenantConnectionStringTemplateName": "TenantDatabaseTemplate",
    "CatalogueEnvironmentName": "integration",
    "CatalogueSchemaVersion": 2,
    "SupportedTenantSchemaVersions": [ "4.1.23" ]
  },
  "ConnectionStrings": {
    "TenantCatalogue": "supplied-by-protected-configuration",
    "TenantDatabaseTemplate": "Authentication=Active Directory Managed Identity;Encrypt=True;TrustServerCertificate=False;Connection Timeout=30"
  }
}
