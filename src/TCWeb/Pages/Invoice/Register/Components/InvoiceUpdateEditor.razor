@using MudBlazor
@using TradeControl.Web.Pages.Invoice.Register.Models

<MudPaper Class="pa-4 invoice-update-editor">
    <div class="invoice-update-heading">
        <div class="min-width-0">
            <MudText Typo="Typo.h6">Edit Invoice</MudText>
            @if (Model.Header is not null)
            {
                <MudText Typo="Typo.subtitle1" Class="text-truncate">@Model.Header.SubjectName</MudText>
                <MudText Typo="Typo.body2" Class="text-muted text-truncate">@DisplayText(Model.NamespacePath)</MudText>
            }
        </div>

        <MudButton Variant="Variant.Outlined"
                   Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.ArrowBack"
                   OnClick="OnBack">
            Back
        </MudButton>
    </div>

    <div class="invoice-update-nav" role="tablist" aria-label="Invoice editor sections">
        <button type="button"
                class="@GetSectionClass(InvoiceUpdateSection.Details)"
                role="tab"
                aria-selected="@(_activeSection == InvoiceUpdateSection.Details)"
                @onclick="() => _activeSection = InvoiceUpdateSection.Details">
            Details <span class="badge rounded-pill text-bg-light ms-1">@Model.Details.Count</span>
        </button>
        <button type="button"
                class="@GetSectionClass(InvoiceUpdateSection.Header)"
                role="tab"
                aria-selected="@(_activeSection == InvoiceUpdateSection.Header)"
                @onclick="() => _activeSection = InvoiceUpdateSection.Header">
            Header
        </button>
    </div>

    @if (_activeSection == InvoiceUpdateSection.Details)
    {
        <section class="invoice-update-section invoice-update-details" role="tabpanel">
            <div class="invoice-update-toolbar">
                <div>
                    <MudText Typo="Typo.h6">Invoice details</MudText>
                    <MudText Typo="Typo.body2" Class="text-muted">Items and values on this invoice.</MudText>
                </div>

                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.Add"
                           OnClick="OnAddItem">
                    New Item
                </MudButton>
            </div>

            @if (Model.Details.Count == 0)
            {
                <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">
                    This invoice does not have any details yet.
                </MudAlert>
            }
            else
            {
                <div class="invoice-detail-table">
                    <MudDataGrid T="TradeControl.Web.Models.Invoice_vwRegisterDetail"
                                 Items="Model.Details"
                                 Class="invoice-update-details-grid"
                                 Hover="true"
                                 Dense="true"
                                 Bordered="true"
                                 Striped="true"
                                 RowsPerPage="25">
                        <Columns>
                            <PropertyColumn Property="x => x.ProjectCode" Title="Project" />
                            <PropertyColumn Property="x => x.CashDescription" Title="Cash Code" />
                            <PropertyColumn Property="x => x.ItemReference" Title="Reference" />
                            <PropertyColumn Property="x => x.TaxValue" Title="Tax" Format="C" />
                            <PropertyColumn Property="x => x.TotalValue" Title="Total" Format="C" />
                            <PropertyColumn Property="x => x.InvoiceValue" Title="Invoice Value" Format="C" />

                            <TemplateColumn Title="Actions">
                                <CellTemplate>
                                    @if (!context.Item.IsProject)
                                    {
                                        <MudStack Row="true" Spacing="1">
                                            <MudIconButton Icon="@Icons.Material.Filled.Edit" Color="Color.Primary" Size="Size.Small"
                                                           aria-label="Edit item"
                                                           OnClick="@(() => OnEditItem.InvokeAsync(new InvoiceUpdateItemKey(context.Item.InvoiceNumber, context.Item.CashCode)))" />
                                            <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small"
                                                           aria-label="Delete item"
                                                           OnClick="@(() => OnDeleteItem.InvokeAsync(new InvoiceUpdateItemKey(context.Item.InvoiceNumber, context.Item.CashCode)))" />
                                        </MudStack>
                                    }
                                </CellTemplate>
                            </TemplateColumn>
                        </Columns>

                        <PagerContent>
                            <MudDataGridPager />
                        </PagerContent>
                    </MudDataGrid>
                </div>

                <div class="invoice-detail-cards">
                    @foreach (var item in Model.Details)
                    {
                        <article class="invoice-detail-card">
                            <div class="invoice-detail-card-heading">
                                <div class="min-width-0">
                                    <div class="fw-semibold text-truncate">@DisplayText(item.CashDescription)</div>
                                    <div class="small text-muted text-truncate">@DisplayText(item.ProjectCode)</div>
                                </div>

                                @if (!item.IsProject)
                                {
                                    <div class="d-flex flex-shrink-0">
                                        <MudIconButton Icon="@Icons.Material.Filled.Edit" Color="Color.Primary" Size="Size.Small"
                                                       aria-label="Edit item"
                                                       OnClick="@(() => OnEditItem.InvokeAsync(new InvoiceUpdateItemKey(item.InvoiceNumber, item.CashCode)))" />
                                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small"
                                                       aria-label="Delete item"
                                                       OnClick="@(() => OnDeleteItem.InvokeAsync(new InvoiceUpdateItemKey(item.InvoiceNumber, item.CashCode)))" />
                                    </div>
                                }
                            </div>

                            @if (!string.IsNullOrWhiteSpace(item.ItemReference))
                            {
                                <div class="small mt-2"><span class="text-muted">Reference:</span> @item.ItemReference</div>
                            }

                            <dl class="invoice-detail-values">
                                <div><dt>Net</dt><dd>@item.InvoiceValue.ToString("C")</dd></div>
                                <div><dt>Tax</dt><dd>@item.TaxValue.ToString("C")</dd></div>
                                <div><dt>Total</dt><dd>@item.TotalValue.ToString("C")</dd></div>
                            </dl>
                        </article>
                    }
                </div>
            }
        </section>
    }
    else
    {
        <section class="invoice-update-section invoice-update-header" role="tabpanel">
            <MudText Typo="Typo.h6" Class="mb-1">Invoice header</MudText>
            <MudText Typo="Typo.body2" Class="text-muted mb-3">Dates, status and customer-facing notes.</MudText>

            <MudGrid Spacing="2">
                <MudItem xs="12" md="6">
                    <MudSelect T="short" Label="Invoice Type" Value="_invoiceTypeCode" ValueChanged="HandleInvoiceTypeChangedAsync">
                        @foreach (var option in Model.InvoiceTypeOptions)
                        {
                            <MudSelectItem T="short" Value="@option.Value">@option.Label</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>

                <MudItem xs="12" md="6">
                    <MudSelect T="short" Label="Invoice Status" Value="_invoiceStatusCode" ValueChanged="HandleInvoiceStatusChangedAsync">
                        @foreach (var option in Model.InvoiceStatusOptions)
                        {
                            <MudSelectItem T="short" Value="@option.Value">@option.Label</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>

                <MudItem xs="12" sm="6" lg="4">
                    <MudDatePicker Label="Invoiced On" Date="_invoicedOn" DateChanged="HandleInvoicedOnChangedAsync" />
                </MudItem>

                <MudItem xs="12" sm="6" lg="4">
                    <MudDatePicker Label="Due On" Date="_dueOn" DateChanged="HandleDueOnChangedAsync" />
                </MudItem>

                <MudItem xs="12" sm="6" lg="4">
                    <MudDatePicker Label="Expected On" Date="_expectedOn" DateChanged="HandleExpectedOnChangedAsync" />
                </MudItem>

                <MudItem xs="12" md="8">
                    <MudTextField T="string" Label="Payment Terms" Value="_paymentTerms" ValueChanged="HandlePaymentTermsChangedAsync" />
                </MudItem>

                <MudItem xs="12" md="4" Class="d-flex align-items-end">
                    <MudCheckBox T="bool" Label="Sent" Value="_printed" ValueChanged="HandlePrintedChangedAsync" />
                </MudItem>

                <MudItem xs="12">
                    <MudTextField T="string" Label="Notes" Lines="3" Value="_notes" ValueChanged="HandleNotesChangedAsync" />
                </MudItem>

                <MudItem xs="12">
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Save" OnClick="SaveAsync">
                        Save Header
                    </MudButton>
                </MudItem>
            </MudGrid>
        </section>
    }
</MudPaper>

@code {
    [Parameter] public InvoiceUpdateEditModel Model { get; set; } = new();
    [Parameter] public EventCallback OnBack { get; set; }
    [Parameter] public EventCallback<InvoiceUpdateEditModel> OnSave { get; set; }
    [Parameter] public EventCallback OnAddItem { get; set; }
    [Parameter] public EventCallback<InvoiceUpdateItemKey> OnEditItem { get; set; }
    [Parameter] public EventCallback<InvoiceUpdateItemKey> OnDeleteItem { get; set; }

    private InvoiceUpdateSection _activeSection = InvoiceUpdateSection.Details;
    private short _invoiceTypeCode;
    private short _invoiceStatusCode;
    private DateTime? _invoicedOn;
    private DateTime? _dueOn;
    private DateTime? _expectedOn;
    private string _paymentTerms = string.Empty;
    private bool _printed;
    private string _notes = string.Empty;

    protected override void OnParametersSet()
    {
        _invoiceTypeCode = Model.InvoiceTypeCode;
        _invoiceStatusCode = Model.InvoiceStatusCode;
        _invoicedOn = Model.InvoicedOn;
        _dueOn = Model.DueOn;
        _expectedOn = Model.ExpectedOn;
        _paymentTerms = Model.PaymentTerms;
        _printed = Model.Printed;
        _notes = Model.Notes;
    }

    private string GetSectionClass(InvoiceUpdateSection section)
        => section == _activeSection ? "invoice-update-nav-button active" : "invoice-update-nav-button";

    private Task HandleInvoiceTypeChangedAsync(short value) { _invoiceTypeCode = value; return Task.CompletedTask; }
    private Task HandleInvoiceStatusChangedAsync(short value) { _invoiceStatusCode = value; return Task.CompletedTask; }
    private Task HandleInvoicedOnChangedAsync(DateTime? value) { _invoicedOn = value; return Task.CompletedTask; }
    private Task HandleDueOnChangedAsync(DateTime? value) { _dueOn = value; return Task.CompletedTask; }
    private Task HandleExpectedOnChangedAsync(DateTime? value) { _expectedOn = value; return Task.CompletedTask; }
    private Task HandlePaymentTermsChangedAsync(string value) { _paymentTerms = value ?? string.Empty; return Task.CompletedTask; }
    private Task HandlePrintedChangedAsync(bool value) { _printed = value; return Task.CompletedTask; }
    private Task HandleNotesChangedAsync(string value) { _notes = value ?? string.Empty; return Task.CompletedTask; }

    private Task SaveAsync()
    {
        Model.InvoiceTypeCode = _invoiceTypeCode;
        Model.InvoiceStatusCode = _invoiceStatusCode;
        Model.InvoicedOn = _invoicedOn ?? Model.InvoicedOn;
        Model.DueOn = _dueOn ?? Model.DueOn;
        Model.ExpectedOn = _expectedOn ?? Model.ExpectedOn;
        Model.PaymentTerms = _paymentTerms;
        Model.Printed = _printed;
        Model.Notes = _notes;
        return OnSave.InvokeAsync(Model);
    }

    private static string DisplayText(string? value) => string.IsNullOrWhiteSpace(value) ? "—" : value;

    private enum InvoiceUpdateSection { Details, Header }
}
