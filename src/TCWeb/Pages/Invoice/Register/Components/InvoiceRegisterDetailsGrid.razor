@using MudBlazor
@using Microsoft.AspNetCore.Components
@using TradeControl.Web.Models

<div class="tc-register-details-grid">
    @if (ShowNavigation)
    {
        <MudStack Class="mb-2" Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.ArrowBack"
                       OnClick="OnBack">
                Back
            </MudButton>
        </MudStack>
    }

    <MudPaper Class="pa-4 mb-2">
        <MudText Typo="Typo.h6">
            @if (!string.IsNullOrEmpty(InvoiceNumber))
            {
                <span>Invoice @InvoiceNumber Details</span>
            }
            else
            {
                <span>Invoice Details</span>
            }
        </MudText>
    </MudPaper>

    <div class="tc-grid-workspace">
        <div class="tc-grid-host">
            <MudDataGrid T="Invoice_vwRegisterDetail"
                         Class="tc-register-details-datagrid"
                         @ref="_grid"
                         Items="Items"
                         FixedHeader="true"
                         FixedFooter="true"
                         RowsPerPage="50"
                         Hover="true"
                         Dense="true"
                         Bordered="true"
                         Striped="true"
                         Filterable="true"
                         FilterMode="DataGridFilterMode.ColumnFilterMenu"
                         FilterCaseSensitivity="DataGridFilterCaseSensitivity.CaseInsensitive"
                         FilterChanged="OnFilterChanged">

                <Columns>
                    <PropertyColumn Property="x => x.ProjectCode" Title="Project" />
                    <PropertyColumn Property="x => x.ObjectCode" Title="Object" />
                    <PropertyColumn Property="x => x.CashCode" Title="Cash Code" />
                    <PropertyColumn Property="x => x.CashDescription" Title="Description" />
                    <PropertyColumn Property="x => x.ItemReference" Title="Reference" />
                    <PropertyColumn Property="x => x.Quantity" Title="Qty">
                        <FooterTemplate>
                            <b>@TotalQuantity</b>
                        </FooterTemplate>
                    </PropertyColumn>

                    <PropertyColumn Property="x => x.InvoiceValue" Title="Amount" Format="C">
                        <FooterTemplate>
                            <b>@TotalInvoiceValue.ToString("C")</b>
                        </FooterTemplate>
                    </PropertyColumn>

                    <PropertyColumn Property="x => x.TaxValue" Title="Tax" Format="C">
                        <FooterTemplate>
                            <b>@TotalTaxValue.ToString("C")</b>
                        </FooterTemplate>
                    </PropertyColumn>

                    <PropertyColumn Property="x => x.TotalValue" Title="Total" Format="C">
                        <FooterTemplate>
                            <b>@TotalValue.ToString("C")</b>
                        </FooterTemplate>
                    </PropertyColumn>
                </Columns>

                <PagerContent>
                    <MudDataGridPager />
                </PagerContent>
            </MudDataGrid>
        </div>
    </div>
</div>

@code {
    private MudDataGrid<Invoice_vwRegisterDetail>? _grid;

    [Parameter] public string? InvoiceNumber { get; set; }
    [Parameter] public List<Invoice_vwRegisterDetail> Items { get; set; } = [];
    [Parameter] public bool ShowNavigation { get; set; } = true;
    [Parameter] public EventCallback OnBack { get; set; }

    private List<Invoice_vwRegisterDetail> VisibleItems { get; set; } = [];

    private decimal TotalQuantity { get; set; }
    private decimal TotalInvoiceValue { get; set; }
    private decimal TotalTaxValue { get; set; }
    private decimal TotalValue { get; set; }

    protected override void OnParametersSet()
    {
        VisibleItems = Items.ToList();
        RecalculateTotals();
    }

    private void RecalculateTotals()
    {
        TotalQuantity = (decimal)VisibleItems.Sum(x => x.Quantity);
        TotalInvoiceValue = (decimal)VisibleItems.Sum(x => x.InvoiceValue);
        TotalTaxValue = (decimal)VisibleItems.Sum(x => x.TaxValue);
        TotalValue = (decimal)VisibleItems.Sum(x => x.TotalValue);
    }

    private void OnFilterChanged(IReadOnlyCollection<IFilterDefinition<Invoice_vwRegisterDetail>> _)
    {
        VisibleItems = _grid?.FilteredItems.ToList() ?? Items.ToList();
        RecalculateTotals();
        StateHasChanged();
    }
}
