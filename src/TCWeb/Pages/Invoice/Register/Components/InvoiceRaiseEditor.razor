@using MudBlazor
@using TradeControl.Web.Pages.Invoice.Register.Models
@using TradeControl.Web.Pages.Subject.Controls

<MudPaper Class="pa-4">
    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-4">
        <MudText Typo="Typo.h6">@(IsEditMode ? "Edit Entry" : "Raise Invoice")</MudText>
        <MudButton Variant="Variant.Outlined"
                   Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.ArrowBack"
                   OnClick="OnBack">
            Back
        </MudButton>
    </MudStack>

    <MudGrid Spacing="3">
        <MudItem xs="12">
            <label class="form-label">Namespace</label>
            <NamespaceSelector FilterText="@_namespacePath"
                               Suggestions="Model.NamespaceSuggestions"
                               IsLoadingSuggestions="IsLoadingNamespaceSuggestions"
                               ShowApplyButton="true"
                               ApplyButtonTitle="Apply namespace"
                               OnFilterChanged="HandleNamespaceFilterChangedAsync"
                               OnFilterCommitted="HandleNamespaceCommittedAsync" />
        </MudItem>

        <MudItem xs="12">
            <MudText Typo="Typo.body2" Class="text-muted">
                Subject: @DisplayText(Model.SubjectName)
            </MudText>
        </MudItem>

        <MudItem xs="12" md="6">
            <MudSelect T="short" Label="Invoice Type" Value="_invoiceTypeCode" ValueChanged="HandleInvoiceTypeChangedAsync">
                @foreach (var option in Model.InvoiceTypeOptions)
                {
                    <MudSelectItem T="short" Value="@option.Value">@option.Label</MudSelectItem>
                }
            </MudSelect>
        </MudItem>

        <MudItem xs="12" md="6">
            <MudSelect T="string" Label="Cash Code" Value="_cashCode" ValueChanged="HandleCashCodeChangedAsync">
                @foreach (var option in Model.CashCodeOptions)
                {
                    <MudSelectItem T="string" Value="@option.Value">@option.Label</MudSelectItem>
                }
            </MudSelect>
        </MudItem>

        <MudItem xs="12" md="6">
            <MudSelect T="string" Label="Tax Code" Value="_taxCode" ValueChanged="HandleTaxCodeChangedAsync">
                @foreach (var option in Model.TaxCodeOptions)
                {
                    <MudSelectItem T="string" Value="@option.Value">@option.Label</MudSelectItem>
                }
            </MudSelect>
        </MudItem>

        <MudItem xs="12" md="6">
            <MudDatePicker Label="Invoiced On"
                           Date="_invoicedOn"
                           DateChanged="HandleDateChangedAsync" />
        </MudItem>

        <MudItem xs="12" md="6">
            <MudTextField T="decimal"
                          Label="Total Value"
                          Value="_totalValue"
                          ValueChanged="HandleTotalValueChangedAsync" />
        </MudItem>

        <MudItem xs="12" md="6">
            <MudTextField T="decimal"
                          Label="Invoice Value"
                          Value="_invoiceValue"
                          ValueChanged="HandleInvoiceValueChangedAsync" />
        </MudItem>

        <MudItem xs="12">
            <MudTextField T="string"
                          Label="Reference"
                          Value="_itemReference"
                          ValueChanged="HandleReferenceChangedAsync" />
        </MudItem>

        <MudItem xs="12">
            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Save"
                       OnClick="SaveAsync">
                @(IsEditMode ? "Save Entry" : "Raise Entry")
            </MudButton>
        </MudItem>
    </MudGrid>
</MudPaper>

@code {
    [Parameter] public InvoiceRaiseEditModel Model { get; set; } = new();
    [Parameter] public bool IsEditMode { get; set; }
    [Parameter] public bool IsLoadingNamespaceSuggestions { get; set; }
    [Parameter] public EventCallback OnBack { get; set; }
    [Parameter] public EventCallback<string> OnNamespaceFilterChanged { get; set; }
    [Parameter] public EventCallback<string> OnNamespaceCommitted { get; set; }
    [Parameter] public EventCallback<string> OnCashCodeChanged { get; set; }
    [Parameter] public EventCallback<InvoiceRaiseEditModel> OnSave { get; set; }

    private string _namespacePath = string.Empty;
    private string _cashCode = string.Empty;
    private string _taxCode = string.Empty;
    private short _invoiceTypeCode;
    private DateTime? _invoicedOn;
    private decimal _totalValue;
    private decimal _invoiceValue;
    private string _itemReference = string.Empty;

    protected override void OnParametersSet()
    {
        _namespacePath = Model.NamespacePath;
        _cashCode = Model.CashCode;
        _taxCode = Model.TaxCode;
        _invoiceTypeCode = Model.InvoiceTypeCode;
        _invoicedOn = Model.InvoicedOn;
        _totalValue = Model.TotalValue;
        _invoiceValue = Model.InvoiceValue;
        _itemReference = Model.ItemReference;
    }

    private Task HandleNamespaceFilterChangedAsync(string value)
    {
        _namespacePath = value ?? string.Empty;
        return OnNamespaceFilterChanged.InvokeAsync(_namespacePath);
    }

    private Task HandleNamespaceCommittedAsync(string value)
    {
        _namespacePath = value ?? string.Empty;
        return OnNamespaceCommitted.InvokeAsync(_namespacePath);
    }

    private async Task HandleCashCodeChangedAsync(string value)
    {
        _cashCode = value;
        await OnCashCodeChanged.InvokeAsync(_cashCode);
    }

    private Task HandleTaxCodeChangedAsync(string value)
    {
        _taxCode = value;
        return Task.CompletedTask;
    }

    private Task HandleInvoiceTypeChangedAsync(short value)
    {
        _invoiceTypeCode = value;
        return Task.CompletedTask;
    }

    private Task HandleDateChangedAsync(DateTime? value)
    {
        _invoicedOn = value;
        return Task.CompletedTask;
    }

    private Task HandleTotalValueChangedAsync(decimal value)
    {
        _totalValue = value;
        return Task.CompletedTask;
    }

    private Task HandleInvoiceValueChangedAsync(decimal value)
    {
        _invoiceValue = value;
        return Task.CompletedTask;
    }

    private Task HandleReferenceChangedAsync(string value)
    {
        _itemReference = value ?? string.Empty;
        return Task.CompletedTask;
    }

    private Task SaveAsync()
    {
        var cashLabel = Model.CashCodeOptions.FirstOrDefault(option => option.Value == _cashCode)?.Label ?? string.Empty;

        Model.NamespacePath = _namespacePath;
        Model.CashCode = _cashCode;
        Model.CashDescription = cashLabel;
        Model.TaxCode = _taxCode;
        Model.InvoiceTypeCode = _invoiceTypeCode;
        Model.InvoicedOn = _invoicedOn ?? DateTime.Today;
        Model.TotalValue = _totalValue;
        Model.InvoiceValue = _invoiceValue;
        Model.ItemReference = _itemReference;

        return OnSave.InvokeAsync(Model);
    }

    private static string DisplayText(string? value)
        => string.IsNullOrWhiteSpace(value) ? "—" : value;
}
