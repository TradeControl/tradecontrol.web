    private async Task OpenRaisePostAsync(InvoiceEntryKey key)
    {
        WorkflowMessage = null;
        RaisePostModel = await WorkflowService.GetRaisePostAsync(key.EntryId);

        if (RaiseEditModel is not null
            && string.Equals(RaiseEditModel.EntryId, RaisePostModel.EntryId, StringComparison.OrdinalIgnoreCase)
            && !string.IsNullOrWhiteSpace(RaiseEditModel.NamespacePath))
        {
            var segments = RaiseEditModel.NamespacePath
                .Trim()
                .Trim('.')
                .Split('.', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);

            if (segments.Length > 0)
            {
                RaisePostModel.SubjectCode = segments[^1];
                RaisePostModel.ParentSubjectCode = segments.Length > 1 ? segments[^2] : string.Empty;
                RaisePostModel.NamespacePath = string.IsNullOrWhiteSpace(RaisePostModel.ParentSubjectCode)
                    ? RaisePostModel.SubjectCode
                    : $"{RaisePostModel.ParentSubjectCode}.{RaisePostModel.SubjectCode}";
            }
        }

        Workspace.Mode = WorkspaceMode.RaisePost;
    }

    private async Task HandleRaiseNamespaceFilterChangedAsync(string filterText)
    {
        RaiseEditModel.NamespacePath = filterText?.Trim() ?? string.Empty;

        if (string.IsNullOrWhiteSpace(RaiseEditModel.NamespacePath))
        {
            RaiseEditModel.NamespaceSuggestions = Array.Empty<NamespaceSelectorSuggestion>();
            _isLoadingRaiseNamespaceSuggestions = false;
            return;
        }

        _isLoadingRaiseNamespaceSuggestions = true;
        StateHasChanged();

        try
        {
            RaiseEditModel.NamespaceSuggestions = await WorkflowService.GetNamespaceSuggestionsAsync(
                RaiseEditModel.NamespacePath,
                NamespaceSuggestionPageSize);
        }
        finally
        {
            _isLoadingRaiseNamespaceSuggestions = false;
        }
    }

    private async Task HandleRaiseNamespaceCommittedAsync(string namespacePath)
    {
        var committedPath = namespacePath?.Trim().Trim('.') ?? string.Empty;
        RaiseEditModel.NamespacePath = committedPath;

        if (string.IsNullOrWhiteSpace(committedPath))
        {
            RaiseEditModel.SubjectCode = string.Empty;
            RaiseEditModel.ParentSubjectCode = string.Empty;
            RaiseEditModel.SubjectName = string.Empty;
            return;
        }

        var segments = committedPath
            .Split('.', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);

        RaiseEditModel.SubjectCode = segments.LastOrDefault() ?? string.Empty;
        RaiseEditModel.ParentSubjectCode = segments.Length > 1
            ? segments[^2]
            : string.Empty;

        var matchedSuggestion = RaiseEditModel.NamespaceSuggestions
            .FirstOrDefault(item => string.Equals(item.FullPath, committedPath, StringComparison.OrdinalIgnoreCase));

        if (matchedSuggestion is not null && !string.IsNullOrWhiteSpace(matchedSuggestion.DisplayLabel))
        {
            RaiseEditModel.SubjectName = matchedSuggestion.DisplayLabel;
        }

        await ApplyRaiseDefaultsAsync();
    }

    private async Task HandleRaiseCashCodeChangedAsync(string cashCode)
    {
        RaiseEditModel.CashCode = cashCode ?? string.Empty;
        await ApplyRaiseDefaultsAsync(includeCashCode: true);
    }

    private async Task ApplyRaiseDefaultsAsync(bool includeCashCode = false)
    {
        if (RaiseEditModel is null || string.IsNullOrWhiteSpace(RaiseEditModel.SubjectCode))
            return;

        var defaults = await WorkflowService.GetRaiseDefaultsAsync(
            RaiseEditModel.SubjectCode,
            RaiseEditModel.ParentSubjectCode,
            RaiseEditModel.EntryId,
            includeCashCode ? RaiseEditModel.CashCode : null);

        if (defaults is null)
            return;

        if (!string.IsNullOrWhiteSpace(defaults.TaxCode))
            RaiseEditModel.TaxCode = defaults.TaxCode;

        if (defaults.InvoiceTypeCode > 0)
            RaiseEditModel.InvoiceTypeCode = defaults.InvoiceTypeCode;

        if (!includeCashCode && !string.IsNullOrWhiteSpace(defaults.CashCode))
        {
            RaiseEditModel.CashCode = defaults.CashCode;
            RaiseEditModel.CashDescription = RaiseEditModel.CashCodeOptions
                .FirstOrDefault(option => option.Value == defaults.CashCode)?.Label ?? RaiseEditModel.CashDescription;
        }

        if (includeCashCode || !string.IsNullOrWhiteSpace(defaults.CashCode))
        {
            RaiseEditModel.TotalValue = defaults.TotalValue;
            RaiseEditModel.InvoiceValue = defaults.InvoiceValue;
            RaiseEditModel.ItemReference = defaults.ItemReference;
        }
    }

