@using System.Linq
@using MudBlazor
@using TradeControl.Web.AppServices
@using TradeControl.Web.AppServices.InvoiceRegister
@using TradeControl.Web.Models
@using TradeControl.Web.Pages.Invoice.Register.Components
@using TradeControl.Web.Pages.Invoice.Register.Models
@using TradeControl.Web.Pages.Subject.Controls
@using Wangkanai.Detection.Models

@inject Wangkanai.Detection.Services.IDetectionService Detection
@inject IInvoiceRegisterService InvoiceRegisterService
@inject IInvoiceRegisterLookupService InvoiceRegisterLookupService
@inject ISubjectBrowserService SubjectBrowserService

<MudThemeProvider />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

@if (_isMobile)
{
    @if (_mobileView == InvoiceRegisterMobileView.Navigation)
    {
        <div class="tc-register tc-register-mobile">
            <div class="tc-register-frame border rounded bg-white p-3 tc-register-shell">
                <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
                    <div>
                        <h1 class="h4 mb-1">Invoice Register</h1>
                        <div class="text-muted small">@GetSubtitle()</div>
                    </div>

                    <div class="small text-muted">
                        @GetResultCountText()
                    </div>
                </div>

                <div class="flex-grow-1 overflow-auto" style="min-height:0;">
                    <InvoiceRegisterSidebar Years="_years"
                                            Periods="_periods"
                                            CashCodeOptions="_cashCodeOptions"
                                            InvoiceTypeOptions="_invoiceTypeOptions"
                                            InvoiceStatusOptions="_invoiceStatusOptions"
                                            NamespaceSuggestions="_namespaceSuggestions"
                                            IsLoadingNamespaceSuggestions="_isLoadingNamespaceSuggestions"
                                            SelectedYearNumber="_selectedYearNumber"
                                            SelectedPeriodStartOn="_selectedPeriodStartOn"
                                            SelectedInvoiceTypeCode="_selectedInvoiceTypeCode"
                                            SelectedInvoiceStatusCode="_selectedInvoiceStatusCode"
                                            SelectedViewMode="_selectedViewMode"
                                            SearchText="@(_searchText ?? string.Empty)"
                                            NamespaceFilter="@(_namespaceFilter ?? string.Empty)"
                                            CashCodeFilter="_cashCodeFilter"
                                            OnYearSelected="HandleYearSelectedAsync"
                                            OnPeriodSelected="HandlePeriodSelectedAsync"
                                            OnInvoiceTypeChanged="HandleInvoiceTypeChangedAsync"
                                            OnInvoiceStatusChanged="HandleInvoiceStatusChangedAsync"
                                            OnViewChanged="HandleViewChangedAsync"
                                            OnSearchTextChanged="HandleSearchTextChangedAsync"
                                            OnNamespaceFilterChanged="HandleNamespaceFilterChangedAsync"
                                            OnNamespaceFilterCommitted="HandleNamespaceFilterCommittedAsync"
                                            OnCashCodeChanged="HandleCashCodeChangedAsync"
                                            OnClearFilters="HandleClearFiltersAsync" />
                </div>

                <div class="border-top mt-3 pt-3 d-flex justify-content-end">
                    <MudButton Variant="Variant.Filled"
                               Color="Color.Primary"
                               StartIcon="@Icons.Material.Filled.TableRows"
                               OnClick="ShowRegisterAsync">
                        Open register
                    </MudButton>
                </div>
            </div>
        </div>
    }
    else if (_mobileView == InvoiceRegisterMobileView.Register)
    {
        <div class="tc-register tc-register-mobile">
            <div class="tc-register-frame border rounded bg-white p-2 tc-register-shell">
                <MudStack Class="mb-2" Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                    <MudButton Variant="Variant.Outlined"
                               Color="Color.Primary"
                               StartIcon="@Icons.Material.Filled.ArrowBack"
                               OnClick="ShowNavigationAsync">
                        Filters
                    </MudButton>

                    <MudText Typo="Typo.body2">@GetSubtitle()</MudText>
                </MudStack>

                @if (_selectedViewMode == InvoiceRegisterViewMode.Headers)
                {
                    <InvoiceRegisterGrid Invoices="RegisterResult.Headers"
                                         SelectedInvoice="Workspace.SelectedKey"
                                         CurrentPage="Filter.PageNumber - 1"
                                         RowsPerPage="Filter.PageSize"
                                         OnSelectInvoice="ShowDetailsGridAsync"
                                         OnOpenPanel="ShowDetailPanelAsync"
                                         OnCurrentPageChanged="OnCurrentPageChangedAsync"
                                         OnRowsPerPageChanged="OnRowsPerPageChangedAsync" />
                }
                else if (_selectedViewMode == InvoiceRegisterViewMode.Lines)
                {
                    <InvoiceRegisterDetailsGrid InvoiceNumber="@null"
                                                Items="RegisterResult.Details"
                                                ShowNavigation="false" />
                }
                else if (_selectedViewMode == InvoiceRegisterViewMode.CashCodes)
                {
                    <InvoiceRegisterCashCodeGrid Items="RegisterResult.CashCodes" />
                }
            </div>
        </div>
    }
    else if (_mobileView == InvoiceRegisterMobileView.DetailGrid)
    {
        <div class="tc-register tc-register-mobile">
            <div class="tc-register-frame border rounded bg-white p-2 tc-register-shell">
                <MudStack Class="mb-2" Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                    <MudButton Variant="Variant.Filled"
                               Color="Color.Primary"
                               StartIcon="@Icons.Material.Filled.ArrowBack"
                               OnClick="BackToRegisterAsync">
                        Back
                    </MudButton>
                </MudStack>

                <InvoiceRegisterDetailsGrid InvoiceNumber="@Workspace.SelectedKey"
                                            Items="RegisterResult.Details"
                                            ShowNavigation="false" />
            </div>
        </div>
    }
    else if (_mobileView == InvoiceRegisterMobileView.DetailPanel)
    {
        <div class="tc-register tc-register-mobile">
            <div class="tc-register-frame border rounded bg-white p-2 tc-register-shell">
                <InvoiceDetailPanel Header="RegisterResult.SelectedHeader"
                                    DetailItems="RegisterResult.Details"
                                    ChangeLogItems="RegisterResult.ChangeLog"
                                    OnBack="BackToRegisterAsync" />
            </div>
        </div>
    }
}
else
{
    <div class="tc-register">
        <div class="tc-register-frame border rounded bg-white tc-register-shell">
            <div class="tc-register-desktop-layout">
                <aside class="tc-register-sidebar-host border-end @(_isSidebarCollapsed ? "tc-register-sidebar-collapsed" : null)">
                    <div class="tc-register-sidebar-header">
                        @if (!_isSidebarCollapsed)
                        {
                            <div class="min-w-0 tc-register-sidebar-title">
                                <div class="fw-semibold">Invoice Register</div>
                                <div class="small text-muted text-truncate">@GetSubtitle()</div>
                            </div>
                        }

                        <MudIconButton Icon="@(_isSidebarCollapsed ? Icons.Material.Filled.ChevronRight : Icons.Material.Filled.ChevronLeft)"
                                       Size="Size.Small"
                                       Color="Color.Default"
                                       Class="tc-register-sidebar-toggle"
                                       OnClick="ToggleSidebar" />
                    </div>

                    @if (!_isSidebarCollapsed)
                    {
                        <div class="tc-register-sidebar-body">
                            <InvoiceRegisterSidebar Years="_years"
                                                    Periods="_periods"
                                                    CashCodeOptions="_cashCodeOptions"
                                                    InvoiceTypeOptions="_invoiceTypeOptions"
                                                    InvoiceStatusOptions="_invoiceStatusOptions"
                                                    NamespaceSuggestions="_namespaceSuggestions"
                                                    IsLoadingNamespaceSuggestions="_isLoadingNamespaceSuggestions"
                                                    SelectedYearNumber="_selectedYearNumber"
                                                    SelectedPeriodStartOn="_selectedPeriodStartOn"
                                                    SelectedInvoiceTypeCode="_selectedInvoiceTypeCode"
                                                    SelectedInvoiceStatusCode="_selectedInvoiceStatusCode"
                                                    SelectedViewMode="_selectedViewMode"
                                                    SearchText="@(_searchText ?? string.Empty)"
                                                    NamespaceFilter="@(_namespaceFilter ?? string.Empty)"
                                                    CashCodeFilter="_cashCodeFilter"
                                                    OnYearSelected="HandleYearSelectedAsync"
                                                    OnPeriodSelected="HandlePeriodSelectedAsync"
                                                    OnInvoiceTypeChanged="HandleInvoiceTypeChangedAsync"
                                                    OnInvoiceStatusChanged="HandleInvoiceStatusChangedAsync"
                                                    OnViewChanged="HandleViewChangedAsync"
                                                    OnSearchTextChanged="HandleSearchTextChangedAsync"
                                                    OnNamespaceFilterChanged="HandleNamespaceFilterChangedAsync"
                                                    OnNamespaceFilterCommitted="HandleNamespaceFilterCommittedAsync"
                                                    OnCashCodeChanged="HandleCashCodeChangedAsync"
                                                    OnClearFilters="HandleClearFiltersAsync" />
                        </div>
                    }
                </aside>

                <section class="tc-register-main-host">
                    @if (Workspace.Mode == WorkspaceMode.Register)
                    {
                        <div class="tc-register-main-header">
                            <div>
                                <h1 class="h4 mb-1">Invoice Register</h1>
                                <div class="text-muted small">@GetSubtitle()</div>
                            </div>

                            <div class="small text-muted">
                                @GetResultCountText()
                            </div>
                        </div>

                        <div class="tc-register-main-body">
                            @if (_selectedViewMode == InvoiceRegisterViewMode.Headers)
                            {
                                <InvoiceRegisterGrid Invoices="RegisterResult.Headers"
                                                     SelectedInvoice="Workspace.SelectedKey"
                                                     CurrentPage="Filter.PageNumber - 1"
                                                     RowsPerPage="Filter.PageSize"
                                                     OnSelectInvoice="ShowDetailsGridAsync"
                                                     OnOpenPanel="ShowDetailPanelAsync"
                                                     OnCurrentPageChanged="OnCurrentPageChangedAsync"
                                                     OnRowsPerPageChanged="OnRowsPerPageChangedAsync" />
                            }
                            else if (_selectedViewMode == InvoiceRegisterViewMode.Lines)
                            {
                                <InvoiceRegisterDetailsGrid InvoiceNumber="@null"
                                                            Items="RegisterResult.Details"
                                                            ShowNavigation="false" />
                            }
                            else if (_selectedViewMode == InvoiceRegisterViewMode.CashCodes)
                            {
                                <InvoiceRegisterCashCodeGrid Items="RegisterResult.CashCodes" />
                            }
                        </div>
                    }
                    else if (Workspace.Mode == WorkspaceMode.DetailGrid)
                    {
                        <MudStack Class="mb-2" Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                            <MudButton Variant="Variant.Filled"
                                       Color="Color.Primary"
                                       StartIcon="@Icons.Material.Filled.ArrowBack"
                                       OnClick="ShowRegisterModeAsync">
                                Back
                            </MudButton>
                        </MudStack>

                        <div class="tc-register-main-body">
                            <InvoiceRegisterDetailsGrid InvoiceNumber="@Workspace.SelectedKey"
                                                        Items="RegisterResult.Details"
                                                        ShowNavigation="false" />
                        </div>
                    }
                    else if (Workspace.Mode == WorkspaceMode.DetailPanel)
                    {
                        <div class="tc-register-main-body">
                            <InvoiceDetailPanel Header="RegisterResult.SelectedHeader"
                                                DetailItems="RegisterResult.Details"
                                                ChangeLogItems="RegisterResult.ChangeLog"
                                                OnBack="ShowRegisterModeAsync" />
                        </div>
                    }
                </section>
            </div>
        </div>
    </div>
}

<style>
    .tc-register {
        min-height: 100vh;
        display: flex;
        flex-direction: column;
    }

    .tc-register-shell {
        min-height: 0;
        display: flex;
        flex-direction: column;
        overflow: hidden;
    }

    .tc-register-desktop-layout {
        display: flex;
        flex: 1 1 auto;
        min-height: 0;
        min-width: 0;
        flex-direction: row;
        align-items: stretch;
    }

    .tc-register-sidebar-host {
        width: 340px;
        min-width: 340px;
        max-width: 340px;
        flex: 0 0 340px;
        display: flex;
        flex-direction: column;
        background: var(--tc-section-bg);
        overflow: hidden;
        transition: width 0.2s ease, min-width 0.2s ease, max-width 0.2s ease, flex-basis 0.2s ease;
    }

    .tc-register-sidebar-collapsed {
        width: 56px;
        min-width: 56px;
        max-width: 56px;
        flex-basis: 56px;
    }

    .tc-register-sidebar-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 0.5rem;
        padding: 0.75rem;
        border-bottom: 1px solid #dee2e6;
        min-width: 0;
    }

    .tc-register-sidebar-title {
        flex: 1 1 auto;
        min-width: 0;
    }

    .tc-register-sidebar-toggle {
        flex: 0 0 auto;
        margin-left: auto;
    }

    .tc-register-sidebar-collapsed .tc-register-sidebar-header {
        justify-content: center;
        padding-left: 0.25rem;
        padding-right: 0.25rem;
    }

    .tc-register-sidebar-body {
        flex: 1 1 auto;
        min-height: 0;
        overflow: auto;
        padding: 0.75rem;
    }

    .tc-register-main-host {
        flex: 1 1 auto;
        min-width: 0;
        min-height: 0;
        display: flex;
        flex-direction: column;
        overflow: hidden;
        padding: 0.5rem;
    }

    .tc-register-main-header {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 1rem;
        padding: 0.25rem 0.25rem 0.75rem 0.25rem;
        flex: 0 0 auto;
    }

    .tc-register-main-body {
        flex: 1 1 auto;
        min-height: 0;
        min-width: 0;
        display: flex;
        flex-direction: column;
        overflow: hidden;
    }

    .tc-register-mobile .tc-register-frame {
        min-height: 100vh;
    }
</style>

@code
{
    private const int NamespaceSuggestionPageSize = 12;

    private readonly WorkspaceState<string> Workspace = new();
    private readonly InvoiceFilterModel Filter = new();

    private enum InvoiceRegisterMobileView
    {
        Navigation,
        Register,
        DetailGrid,
        DetailPanel
    }

    private bool _isMobile;
    private bool _isSidebarCollapsed;
    private bool _isLoadingNamespaceSuggestions;
    private string _namespaceFilter = string.Empty;
    private string _cashCodeFilter = string.Empty;
    private string _searchText = string.Empty;
    private short? _selectedYearNumber;
    private short? _selectedInvoiceTypeCode;
    private short? _selectedInvoiceStatusCode;
    private DateTime? _selectedPeriodStartOn;
    private DateTime? _defaultPeriodStartOn;
    private short? _defaultYearNumber;
    private InvoiceRegisterViewMode _selectedViewMode = InvoiceRegisterViewMode.Headers;
    private InvoiceRegisterMobileView _mobileView = InvoiceRegisterMobileView.Navigation;
    private IReadOnlyList<InvoiceRegisterYearOption> _years = Array.Empty<InvoiceRegisterYearOption>();
    private IReadOnlyList<InvoiceRegisterPeriodOption> _periods = Array.Empty<InvoiceRegisterPeriodOption>();
    private IReadOnlyList<InvoiceRegisterSelectOption> _cashCodeOptions = Array.Empty<InvoiceRegisterSelectOption>();
    private IReadOnlyList<InvoiceRegisterInvoiceTypeOption> _invoiceTypeOptions = Array.Empty<InvoiceRegisterInvoiceTypeOption>();
    private IReadOnlyList<InvoiceRegisterInvoiceStatusOption> _invoiceStatusOptions = Array.Empty<InvoiceRegisterInvoiceStatusOption>();
    private IReadOnlyList<NamespaceSelectorSuggestion> _namespaceSuggestions = Array.Empty<NamespaceSelectorSuggestion>();

    private InvoiceRegisterResult RegisterResult { get; set; } = new();

    protected override async Task OnInitializedAsync()
    {
        _isMobile = Detection.Device.Type == Device.Mobile;
        await InitializeShellAsync();
    }

    private async Task InitializeShellAsync()
    {
        _cashCodeOptions = await InvoiceRegisterLookupService.GetCashCodeOptionsAsync();
        _years = await InvoiceRegisterLookupService.GetYearsAsync();
        _invoiceTypeOptions = InvoiceRegisterOptionCatalog.GetInvoiceTypeOptions();
        _invoiceStatusOptions = InvoiceRegisterOptionCatalog.GetInvoiceStatusOptions();

        var defaultPeriod = await InvoiceRegisterLookupService.GetDefaultPeriodAsync();
        _defaultYearNumber = defaultPeriod?.YearNumber ?? _years.FirstOrDefault()?.YearNumber;
        _defaultPeriodStartOn = defaultPeriod?.StartOn;

        await ResetFiltersToDefaultAsync();
        await LoadRegisterAsync();
    }

    private async Task ResetFiltersToDefaultAsync()
    {
        _selectedYearNumber = _defaultYearNumber;
        _selectedPeriodStartOn = _defaultPeriodStartOn;
        _selectedInvoiceTypeCode = null;
        _selectedInvoiceStatusCode = null;
        _selectedViewMode = InvoiceRegisterViewMode.Headers;
        _searchText = string.Empty;
        _namespaceFilter = string.Empty;
        _cashCodeFilter = string.Empty;
        _namespaceSuggestions = Array.Empty<NamespaceSelectorSuggestion>();

        await LoadPeriodsAsync(_selectedYearNumber);

        if (_selectedPeriodStartOn.HasValue
            && !_periods.Any(period => period.StartOn == _selectedPeriodStartOn.Value))
        {
            _selectedPeriodStartOn = _periods.FirstOrDefault()?.StartOn;
        }

        Filter.PageNumber = 1;
        Workspace.SelectedKey = null;
        Workspace.Mode = WorkspaceMode.Register;
    }

    private async Task LoadPeriodsAsync(short? yearNumber)
    {
        if (!yearNumber.HasValue || yearNumber.Value <= 0)
        {
            _periods = Array.Empty<InvoiceRegisterPeriodOption>();
            _selectedPeriodStartOn = null;
            return;
        }

        _periods = await InvoiceRegisterLookupService.GetPeriodsAsync(yearNumber.Value);

        if (_periods.Count == 0)
        {
            _selectedPeriodStartOn = null;
            return;
        }

        if (_selectedPeriodStartOn.HasValue
            && _periods.Any(period => period.StartOn == _selectedPeriodStartOn.Value))
        {
            return;
        }

        _selectedPeriodStartOn = _periods[0].StartOn;
    }

    private void ApplyCurrentFilterState()
    {
        Filter.SearchText = string.IsNullOrWhiteSpace(_searchText) ? null : _searchText;
        Filter.Namespace = string.IsNullOrWhiteSpace(_namespaceFilter) ? null : _namespaceFilter;
        Filter.CashCode = string.IsNullOrWhiteSpace(_cashCodeFilter) ? null : _cashCodeFilter;
        Filter.InvoiceType = _selectedInvoiceTypeCode?.ToString();
        Filter.InvoiceStatus = _selectedInvoiceStatusCode?.ToString();
        Filter.SelectedInvoiceNumber = Workspace.SelectedKey;

        if (_selectedYearNumber.HasValue && _selectedYearNumber.Value > 0)
        {
            Filter.PeriodYear = _selectedYearNumber.Value;
        }
        else
        {
            Filter.PeriodYear = null;
        }

        if (_selectedPeriodStartOn.HasValue)
        {
            var selectedPeriod = _periods.FirstOrDefault(period => period.StartOn == _selectedPeriodStartOn.Value);
            Filter.PeriodMonth = selectedPeriod?.MonthNumber;
        }
        else
        {
            Filter.PeriodMonth = null;
        }
    }

    private async Task LoadRegisterAsync()
    {
        ApplyCurrentFilterState();
        RegisterResult = await InvoiceRegisterService.QueryAsync(Filter);
    }

    private Task ToggleSidebar()
    {
        _isSidebarCollapsed = !_isSidebarCollapsed;
        return Task.CompletedTask;
    }

    private Task ShowNavigationAsync()
    {
        _mobileView = InvoiceRegisterMobileView.Navigation;
        return Task.CompletedTask;
    }

    private Task ShowRegisterAsync()
    {
        Workspace.Mode = WorkspaceMode.Register;
        _mobileView = InvoiceRegisterMobileView.Register;
        return Task.CompletedTask;
    }

    private Task ShowRegisterModeAsync()
    {
        Workspace.Mode = WorkspaceMode.Register;

        if (_isMobile)
        {
            _mobileView = InvoiceRegisterMobileView.Register;
        }

        return Task.CompletedTask;
    }

    private Task BackToRegisterAsync()
    {
        Workspace.Mode = WorkspaceMode.Register;
        _mobileView = InvoiceRegisterMobileView.Register;
        return Task.CompletedTask;
    }

    private async Task ShowDetailsGridAsync(string invoiceNumber)
    {
        if (_selectedViewMode != InvoiceRegisterViewMode.Headers)
        {
            return;
        }

        Workspace.SelectedKey = invoiceNumber;
        Workspace.Mode = WorkspaceMode.DetailGrid;
        Filter.SelectedInvoiceNumber = invoiceNumber;
        await LoadRegisterAsync();

        if (_isMobile)
        {
            _mobileView = InvoiceRegisterMobileView.DetailGrid;
        }
    }

    private async Task ShowDetailPanelAsync(string invoiceNumber)
    {
        if (_selectedViewMode != InvoiceRegisterViewMode.Headers)
        {
            return;
        }

        Workspace.SelectedKey = invoiceNumber;
        Workspace.Mode = WorkspaceMode.DetailPanel;
        Filter.SelectedInvoiceNumber = invoiceNumber;
        await LoadRegisterAsync();

        if (_isMobile)
        {
            _mobileView = InvoiceRegisterMobileView.DetailPanel;
        }
    }

    private async Task HandleYearSelectedAsync(short yearNumber)
    {
        _selectedYearNumber = yearNumber > 0 ? yearNumber : null;
        await LoadPeriodsAsync(_selectedYearNumber);
        Filter.PageNumber = 1;
        Workspace.SelectedKey = null;
        Workspace.Mode = WorkspaceMode.Register;
        await LoadRegisterAsync();
    }

    private async Task HandlePeriodSelectedAsync(DateTime? startOn)
    {
        _selectedPeriodStartOn = startOn;
        Filter.PageNumber = 1;
        Workspace.SelectedKey = null;
        Workspace.Mode = WorkspaceMode.Register;
        await LoadRegisterAsync();
    }

    private async Task HandleInvoiceTypeChangedAsync(short? invoiceTypeCode)
    {
        _selectedInvoiceTypeCode = invoiceTypeCode;
        Filter.PageNumber = 1;
        Workspace.SelectedKey = null;
        Workspace.Mode = WorkspaceMode.Register;
        await LoadRegisterAsync();
    }

    private async Task HandleInvoiceStatusChangedAsync(short? invoiceStatusCode)
    {
        _selectedInvoiceStatusCode = invoiceStatusCode;
        Filter.PageNumber = 1;
        Workspace.SelectedKey = null;
        Workspace.Mode = WorkspaceMode.Register;
        await LoadRegisterAsync();
    }

    private async Task HandleViewChangedAsync(InvoiceRegisterViewMode viewMode)
    {
        _selectedViewMode = viewMode;
        Workspace.SelectedKey = null;
        Workspace.Mode = WorkspaceMode.Register;
        Filter.PageNumber = 1;
        await LoadRegisterAsync();
    }

    private async Task HandleSearchTextChangedAsync(string searchText)
    {
        _searchText = searchText?.Trim() ?? string.Empty;
        Filter.PageNumber = 1;
        Workspace.SelectedKey = null;
        Workspace.Mode = WorkspaceMode.Register;
        await LoadRegisterAsync();
    }

    private async Task HandleNamespaceFilterChangedAsync(string filterText)
    {
        var updatedFilter = filterText?.Trim() ?? string.Empty;
        var wasCleared = !string.IsNullOrWhiteSpace(_namespaceFilter)
            && string.IsNullOrWhiteSpace(updatedFilter);

        _namespaceFilter = updatedFilter;

        if (string.IsNullOrWhiteSpace(_namespaceFilter))
        {
            _namespaceSuggestions = Array.Empty<NamespaceSelectorSuggestion>();
            _isLoadingNamespaceSuggestions = false;

            if (wasCleared)
            {
                Filter.PageNumber = 1;
                Workspace.SelectedKey = null;
                Workspace.Mode = WorkspaceMode.Register;
                await LoadRegisterAsync();
            }

            return;
        }

        _isLoadingNamespaceSuggestions = true;
        StateHasChanged();

        try
        {
            _namespaceSuggestions = await SubjectBrowserService.GetNamespaceSuggestionsAsync(
                _namespaceFilter,
                NamespaceSuggestionPageSize);
        }
        finally
        {
            _isLoadingNamespaceSuggestions = false;
        }
    }

    private async Task HandleNamespaceFilterCommittedAsync(string filterText)
    {
        _namespaceFilter = filterText?.Trim() ?? string.Empty;
        Filter.PageNumber = 1;
        Workspace.SelectedKey = null;
        Workspace.Mode = WorkspaceMode.Register;
        await LoadRegisterAsync();
    }

    private async Task HandleCashCodeChangedAsync(string cashCode)
    {
        _cashCodeFilter = cashCode ?? string.Empty;
        Filter.PageNumber = 1;
        Workspace.SelectedKey = null;
        Workspace.Mode = WorkspaceMode.Register;
        await LoadRegisterAsync();
    }

    private async Task HandleClearFiltersAsync()
    {
        await ResetFiltersToDefaultAsync();
        await LoadRegisterAsync();
    }

    private async Task OnCurrentPageChangedAsync(int currentPage)
    {
        Filter.PageNumber = currentPage + 1;
        await LoadRegisterAsync();
    }

    private async Task OnRowsPerPageChangedAsync(int rowsPerPage)
    {
        Filter.PageSize = rowsPerPage;
        Filter.PageNumber = 1;
        await LoadRegisterAsync();
    }

    private string GetSubtitle()
    {
        var yearLabel = InvoiceRegisterOptionCatalog.GetYearLabel(_years, _selectedYearNumber);
        var periodLabel = InvoiceRegisterOptionCatalog.GetPeriodScopeLabel(_periods, _selectedPeriodStartOn);
        var viewLabel = InvoiceRegisterOptionCatalog.GetViewLabel(_selectedViewMode);

        if (_selectedInvoiceTypeCode.HasValue)
        {
            var invoiceTypeLabel = _invoiceTypeOptions
                .FirstOrDefault(option => option.Value == _selectedInvoiceTypeCode.Value)?
                .Label;

            if (!string.IsNullOrWhiteSpace(invoiceTypeLabel))
            {
                return $"{yearLabel} • {periodLabel} • {invoiceTypeLabel} • {viewLabel}";
            }
        }

        if (_selectedInvoiceStatusCode.HasValue)
        {
            var invoiceStatusLabel = _invoiceStatusOptions
                .FirstOrDefault(option => option.Value == _selectedInvoiceStatusCode.Value)?
                .Label;

            if (!string.IsNullOrWhiteSpace(invoiceStatusLabel))
            {
                return $"{yearLabel} • {periodLabel} • {invoiceStatusLabel} • {viewLabel}";
            }
        }

        return $"{yearLabel} • {periodLabel} • {viewLabel}";
    }

    private string GetResultCountText()
    {
        return _selectedViewMode switch
        {
            InvoiceRegisterViewMode.Headers => $"{RegisterResult.Headers.Count} invoice{(RegisterResult.Headers.Count == 1 ? string.Empty : "s")}",
            InvoiceRegisterViewMode.Lines => $"{RegisterResult.Details.Count} line{(RegisterResult.Details.Count == 1 ? string.Empty : "s")}",
            InvoiceRegisterViewMode.CashCodes => $"{RegisterResult.CashCodes.Count} cash code row{(RegisterResult.CashCodes.Count == 1 ? string.Empty : "s")}",
            _ => string.Empty
        };
    }
}
