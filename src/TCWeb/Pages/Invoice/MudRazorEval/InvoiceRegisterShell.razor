@using MudBlazor
@using TradeControl.Web.Models
@using TradeControl.Web.Data
@using TradeControl.Web.Pages.Invoice.MudRazorEval.Components

@inject NodeContext NodeContext

<MudThemeProvider />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<div class="tc-tree-manager">
    <div class="tc-tree-manager-frame border rounded bg-white p-2 tc-register-shell">
        @if (Workspace.Mode == WorkspaceMode.Register)
        {
            <InvoiceRegisterGrid Invoices="FilteredInvoices"
                                 SelectedInvoice="Workspace.SelectedKey"
                                 FilterText="Workspace.SearchText"
                                 CurrentPage="Workspace.CurrentPage"
                                 RowsPerPage="Workspace.RowsPerPage"
                                 OnFilterTextChanged="OnFilterTextChanged"
                                 OnSelectInvoice="ShowDetailsGrid"
                                 OnOpenPanel="ShowDetailPanel"
                                 OnCurrentPageChanged="OnCurrentPageChanged"
                                 OnRowsPerPageChanged="OnRowsPerPageChanged" />
        }
        else if (Workspace.Mode == WorkspaceMode.DetailGrid)
        {
            <MudStack Class="mb-2" Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.ArrowBack"
                           OnClick="ShowRegister">
                    Back
                </MudButton>
            </MudStack>

            <InvoiceRegisterDetailsGrid InvoiceNumber="@Workspace.SelectedKey"
                                        Items="DetailItems"
                                        ShowNavigation="false" />
        }
        else if (Workspace.Mode == WorkspaceMode.DetailPanel)
        {
            <InvoiceDetailPanel InvoiceNumber="@Workspace.SelectedKey"
                                OnBack="ShowRegister" />
        }
    </div>
</div>

<style>
    .tc-tree-manager {
        min-height: 100vh;
        display: flex;
        flex-direction: column;
    }

    .tc-tree-manager-frame.tc-register-shell {
        min-height: 0;
        flex: 1 1 auto;
        display: flex;
        flex-direction: column;
        overflow: hidden;
    }

    .tc-register-shell {
        min-height: 0;
        display: flex;
        flex-direction: column;
    }
</style>

@code
{
    private readonly WorkspaceState<string> Workspace = new();

    private List<Invoice_vwRegister> AllInvoices = [];
    private List<Invoice_vwRegister> FilteredInvoices = [];
    private List<Invoice_vwRegisterDetail> DetailItems = [];

    protected override void OnInitialized()
    {
        LoadInvoices();
        LoadDetailItems();
    }

    private void LoadInvoices()
    {
        AllInvoices = NodeContext.Invoice_Register
            .OrderByDescending(x => x.InvoicedOn)
            .ToList();

        ApplyRegisterFilter();
    }

    private void ApplyRegisterFilter()
    {
        IEnumerable<Invoice_vwRegister> query = AllInvoices;

        if (!string.IsNullOrWhiteSpace(Workspace.SearchText))
        {
            var filter = Workspace.SearchText.Trim();

            query = query.Where(x =>
                (x.InvoiceNumber != null && x.InvoiceNumber.Contains(filter, System.StringComparison.OrdinalIgnoreCase)) ||
                (x.SubjectName != null && x.SubjectName.Contains(filter, System.StringComparison.OrdinalIgnoreCase)));
        }

        FilteredInvoices = query.ToList();
    }

    private void LoadDetailItems()
    {
        IQueryable<Invoice_vwRegisterDetail> query = NodeContext.Invoice_RegisterDetails;

        if (!string.IsNullOrWhiteSpace(Workspace.SelectedKey))
            query = query.Where(x => x.InvoiceNumber == Workspace.SelectedKey);

        DetailItems = query.ToList();
    }

    private void ShowRegister()
    {
        Workspace.Mode = WorkspaceMode.Register;
    }

    private void ShowDetailsGrid(string invoiceNumber)
    {
        Workspace.SelectedKey = invoiceNumber;
        Workspace.Mode = WorkspaceMode.DetailGrid;
        LoadDetailItems();
    }

    private void ShowDetailPanel(string invoiceNumber)
    {
        Workspace.SelectedKey = invoiceNumber;
        Workspace.Mode = WorkspaceMode.DetailPanel;
    }

    private void OnFilterTextChanged(string filterText)
    {
        Workspace.SearchText = filterText;
        Workspace.CurrentPage = 0;
        ApplyRegisterFilter();
    }

    private void OnCurrentPageChanged(int currentPage)
    {
        Workspace.CurrentPage = currentPage;
    }

    private void OnRowsPerPageChanged(int rowsPerPage)
    {
        Workspace.RowsPerPage = rowsPerPage;
        Workspace.CurrentPage = 0;
    }
}
