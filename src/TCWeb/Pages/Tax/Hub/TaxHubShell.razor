@using TradeControl.Web.AppServices.TaxHub
@using TradeControl.Web.Pages.Tax.Hub.Components
@using TradeControl.Web.Pages.Tax.Hub.Models
@using TradeControl.Web.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components
@using System.Threading
@using Wangkanai.Detection.Models
@inject ITaxHubService TaxHubService
@inject Wangkanai.Detection.Services.IDetectionService Detection
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject PersistentComponentState PersistentState
@implements IDisposable

<MudThemeProvider />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

@if (_isMobile)
{
    <div class="tc-tax-hub tc-tax-hub-mobile">
        <div class="tc-tax-hub-frame border rounded bg-white p-3 tc-tax-hub-shell">
            @if (!string.IsNullOrWhiteSpace(_error))
            {
                <div class="alert alert-danger mb-3" role="alert">
                    @_error
                </div>
            }
            else if (_isLoading)
            {
                @LoadingIndicator("Loading Tax Hub…")
            }
            else if (_state is not null)
            {
                @ReportingReadinessAlert()
                @if (_mobileView == TaxHubMobileView.Navigation)
                {
                    <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
                        <div>
                            <h1 class="h4 mb-1">Tax Hub</h1>
                            <div class="text-muted small">@_state.Subtitle</div>
                        </div>

                        <div class="small text-muted">
                            @GetPeriodSummary()
                        </div>
                    </div>

                    <div class="mb-3 d-flex justify-content-end">
                        <button type="button"
                                class="btn btn-primary"
                                @onclick="ShowWorkspaceAsync">
                            Open workspace
                        </button>
                    </div>

                    <div class="flex-grow-1 overflow-auto" style="min-height:0;">
                        @if (ShowHmrcConnection)
                        {
                            <TaxHubHmrcConnection Compact="true"
                                                      ReportingProfileReady="@VatReportingProfileReady"
                                                      ReadinessMessage="@VatReportingReadinessMessage" />
                        }
                        <TaxHubSidebar SelectedWorkspace="@_state.SelectedWorkspace"
                                       Years="@_years"
                                       Periods="@_periods"
                                       SelectedYearNumber="@_selectedYearNumber"
                                       SelectedPeriodStartOn="@_selectedPeriodStartOn"
                                       ShowPeriodSelectors="@ShowPeriodSelectors"
                                       ShowFinalPeriodAction="@ShowFinalPeriodAction"
                                       OnWorkspaceSelected="HandleWorkspaceSelectedAsync"
                                       OnYearSelected="HandleYearSelectedAsync"
                                       OnPeriodSelected="HandlePeriodSelectedAsync"
                                       OnFinalPeriodSelected="HandleFinalPeriodSelectedAsync" />
                    </div>
                }
                else
                {
                    <div class="d-flex flex-column h-100">
                        <div class="mb-3">
                            <button type="button"
                                    class="btn btn-outline-primary"
                                    @onclick="BackToNavigationAsync">
                                Back to filters
                            </button>
                        </div>

                        <div class="card flex-grow-1">
                            <div class="card-body">
                                <div class="mb-3">
                                    <h1 class="h3 mb-1">@_state.Title</h1>
                                    @if (!string.IsNullOrWhiteSpace(_state.Subtitle))
                                    {
                                        <div class="text-muted">@_state.Subtitle</div>
                                    }
                                </div>

                                <TaxHubGrid Workspace="@_state.SelectedWorkspace"
                                            Dashboard="@_dashboard"
                                            VatWorkspace="@_vatWorkspace"
                                            BusinessTaxWorkspace="@_businessTaxWorkspace"
                                            AccountsWorkspace="@_accountsWorkspace"
                                            IsMobile="@_isMobile"
                                            IsLoading="@_isWorkspaceLoading"
                                            Error="@_workspaceError" />
                            </div>
                        </div>
                    </div>
                }
            }
        </div>
    </div>
}
else
{
    <div class="tc-tax-hub">
        <div class="tc-tax-hub-frame border rounded bg-white tc-tax-hub-shell">
            @if (!string.IsNullOrWhiteSpace(_error))
            {
                <div class="alert alert-danger m-3" role="alert">
                    @_error
                </div>
            }
            else if (_isLoading)
            {
                @LoadingIndicator("Loading Tax Hub…")
            }
            else if (_state is not null)
            {
                <div class="px-3 pt-3">
                    @ReportingReadinessAlert()
                </div>
                <div class="tc-tax-hub-desktop-layout">
                    <aside class="tc-tax-hub-sidebar-host border-end @(_isSidebarCollapsed ? "tc-tax-hub-sidebar-collapsed" : null)">
                        <div class="tc-tax-hub-sidebar-header">
                            @if (!_isSidebarCollapsed)
                            {
                                <div class="min-w-0 tc-tax-hub-sidebar-title">
                                    <div class="fw-semibold">Tax Hub</div>
                                    <div class="small text-muted text-truncate">@GetPeriodSummary()</div>
                                </div>
                            }

                            <button type="button"
                                    class="btn btn-sm btn-outline-secondary tc-tax-hub-sidebar-toggle"
                                    @onclick="ToggleSidebar">
                                @if (_isSidebarCollapsed)
                                {
                                    <span>&rsaquo;</span>
                                }
                                else
                                {
                                    <span>&lsaquo;</span>
                                }
                            </button>
                        </div>

                        @if (!_isSidebarCollapsed)
                        {
                            <div class="tc-tax-hub-sidebar-body">
                                @if (ShowHmrcConnection)
                                {
                                    <TaxHubHmrcConnection Compact="true"
                                                              ReportingProfileReady="@VatReportingProfileReady"
                                                              ReadinessMessage="@VatReportingReadinessMessage" />
                                }
                                <TaxHubSidebar SelectedWorkspace="@_state.SelectedWorkspace"
                                               Years="@_years"
                                               Periods="@_periods"
                                               SelectedYearNumber="@_selectedYearNumber"
                                               SelectedPeriodStartOn="@_selectedPeriodStartOn"
                                               ShowPeriodSelectors="@ShowPeriodSelectors"
                                               ShowFinalPeriodAction="@ShowFinalPeriodAction"
                                               OnWorkspaceSelected="HandleWorkspaceSelectedAsync"
                                               OnYearSelected="HandleYearSelectedAsync"
                                               OnPeriodSelected="HandlePeriodSelectedAsync"
                                               OnFinalPeriodSelected="HandleFinalPeriodSelectedAsync" />
                            </div>
                        }
                    </aside>

                    <section class="tc-tax-hub-main-host">
                        <div class="tc-tax-hub-main-header">
                            <div>
                                <h1 class="h3 mb-1">@_state.Title</h1>
                                @if (!string.IsNullOrWhiteSpace(_state.Subtitle))
                                {
                                    <div class="text-muted">@_state.Subtitle</div>
                                }
                            </div>
                        </div>

                        <div class="tc-tax-hub-main-body">
                            <TaxHubGrid Workspace="@_state.SelectedWorkspace"
                                        Dashboard="@_dashboard"
                                        VatWorkspace="@_vatWorkspace"
                                        BusinessTaxWorkspace="@_businessTaxWorkspace"
                                        AccountsWorkspace="@_accountsWorkspace"
                                        IsMobile="@_isMobile"
                                        IsLoading="@_isWorkspaceLoading"
                                        Error="@_workspaceError" />
                        </div>
                    </section>
                </div>
            }
        </div>
    </div>
}

@code {
    private enum TaxHubMobileView
    {
        Navigation,
        Workspace
    }

    private bool _isLoading = true;
    private bool _isWorkspaceLoading;
    private bool _isMobile;
    private bool _isAdministrator;
    private bool _isSidebarCollapsed;
    private string? _error;
    private string? _workspaceError;
    private long _requestVersion;
    private readonly SemaphoreSlim _serviceGate = new(1, 1);
    private PersistingComponentStateSubscription _persistingSubscription;
    private TaxHubWorkflowState? _state;
    private TaxHubDashboardModel? _dashboard;
    private TaxHubVatWorkspaceModel? _vatWorkspace;
    private TaxHubBusinessTaxWorkspaceModel? _businessTaxWorkspace;
    private TaxHubAccountsWorkspaceModel? _accountsWorkspace;
    private TaxHubMobileView _mobileView = TaxHubMobileView.Navigation;
    private IReadOnlyList<TaxHubYearOption> _years = Array.Empty<TaxHubYearOption>();
    private IReadOnlyList<TaxHubPeriodOption> _periods = Array.Empty<TaxHubPeriodOption>();
    private short? _selectedYearNumber;
    private DateTime? _selectedPeriodStartOn;
    private short? _defaultYearNumber;
    private DateTime? _defaultPeriodStartOn;

    private bool ShowPeriodSelectors =>
        _state?.SelectedWorkspace is TaxHubWorkspace.Vat or TaxHubWorkspace.BusinessTax or TaxHubWorkspace.Accounts;

    private bool ShowFinalPeriodAction =>
        _state?.SelectedWorkspace == TaxHubWorkspace.Accounts && _selectedYearNumber.HasValue;

    private bool ShowHmrcConnection => _dashboard?.ActiveRegimes.Any(regime =>
        regime.Equals("VAT", StringComparison.OrdinalIgnoreCase)
        || regime.Equals("Vat", StringComparison.OrdinalIgnoreCase)) == true;

    private TaxHubReportingReadinessItem? VatReportingProfile =>
        _dashboard?.ReportingReadiness.Profiles.FirstOrDefault(profile =>
            profile.ReportingTypeCode.Equals("INDIRECT-TAX", StringComparison.OrdinalIgnoreCase));

    private bool VatReportingProfileReady => VatReportingProfile?.IsReady == true;

    private string VatReportingReadinessMessage => VatReportingProfile is null
        ? "Configure and activate the indirect tax reporting profile before connecting to HMRC."
        : string.Join(" ", VatReportingProfile.Findings);

    private RenderFragment LoadingIndicator(string text) => @<div class="tc-tax-hub-loading" role="status" aria-live="polite" aria-atomic="true">
        <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Medium" />
        <span>@text</span>
    </div>;

    private RenderFragment ReportingReadinessAlert() => @<text>
        @if (_dashboard?.ReportingReadiness is { IsReady: false } readiness)
        {
            <div class="alert alert-warning mb-3" role="alert">
                <div class="fw-semibold mb-1">Statutory reporting configuration is incomplete</div>
                @foreach (var profile in readiness.Profiles.Where(item => !item.IsReady))
                {
                    <div class="small mb-1">
                        <strong>@profile.ReportingType</strong>
                        @if (!string.IsNullOrWhiteSpace(profile.Authority))
                        {
                            <span> — @profile.Authority</span>
                        }
                        @if (profile.Findings.Count > 0)
                        {
                            <span>: @string.Join(" ", profile.Findings)</span>
                        }
                    </div>
                }
                @if (_isAdministrator)
                {
                    <a class="alert-link" href="/Admin/Manager/Index?node=ReportingProfiles">Open Reporting Profiles in Admin Manager</a>
                }
                else
                {
                    <span class="small">Ask an administrator to complete the reporting profiles.</span>
                }
            </div>
        }
    </text>;

    protected override async Task OnInitializedAsync()
    {
        _persistingSubscription = PersistentState.RegisterOnPersisting(PersistState);

        if (PersistentState.TryTakeFromJson<TaxHubShellSnapshot>(nameof(TaxHubShellSnapshot), out var snapshot) && snapshot is not null)
        {
            RestoreSnapshot(snapshot);
            _isLoading = false;
            return;
        }

        try
        {
            _isMobile = Detection.Device.Type == Device.Mobile;
            _isAdministrator = (await AuthenticationStateProvider.GetAuthenticationStateAsync())
                .User.IsInRole(Constants.AdministratorsRole);

            var result = await TaxHubService.GetShellStateAsync();

            if (!result.IsSuccess || result.State is null)
            {
                _error = string.IsNullOrWhiteSpace(result.Message)
                    ? "Unable to initialise Tax Hub."
                    : result.Message;
                return;
            }

            _state = result.State;
            // The service owns a scoped EF context, so its queries must remain sequential.
            _years = await TaxHubService.GetYearsAsync();
            var defaultPeriod = await TaxHubService.GetDefaultPeriodAsync();
            _defaultYearNumber = defaultPeriod?.YearNumber ?? _years.FirstOrDefault()?.YearNumber;
            _defaultPeriodStartOn = defaultPeriod?.StartOn;

            await ResetPeriodsAsync();
            await RefreshWorkspaceAsync();
        }
        catch (System.Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task ResetPeriodsAsync()
    {
        _selectedYearNumber = _defaultYearNumber;
        _selectedPeriodStartOn = null;

        if (_selectedYearNumber.HasValue && _selectedYearNumber.Value > 0)
        {
            _periods = await TaxHubService.GetPeriodsAsync(_selectedYearNumber.Value);
        }
        else
        {
            _periods = Array.Empty<TaxHubPeriodOption>();
        }
    }

    private Task ToggleSidebar()
    {
        _isSidebarCollapsed = !_isSidebarCollapsed;
        return Task.CompletedTask;
    }

    private Task ShowWorkspaceAsync()
    {
        _mobileView = TaxHubMobileView.Workspace;
        return Task.CompletedTask;
    }

    private Task BackToNavigationAsync()
    {
        _mobileView = TaxHubMobileView.Navigation;
        return Task.CompletedTask;
    }

    private async Task HandleWorkspaceSelectedAsync(TaxHubWorkspace workspace)
    {
        if (_state is null)
            return;

        _state = workspace switch
        {
            TaxHubWorkspace.Dashboard => _state with
            {
                SelectedWorkspace = TaxHubWorkspace.Dashboard,
                Title = "Tax Hub",
                Subtitle = "Reporting and validation workspace"
            },
            TaxHubWorkspace.Vat => _state with
            {
                SelectedWorkspace = TaxHubWorkspace.Vat,
                Title = "VAT",
                Subtitle = "VAT reporting workspace"
            },
            TaxHubWorkspace.BusinessTax => _state with
            {
                SelectedWorkspace = TaxHubWorkspace.BusinessTax,
                Title = "Business Tax",
                Subtitle = "Business tax reporting workspace"
            },
            TaxHubWorkspace.Accounts => _state with
            {
                SelectedWorkspace = TaxHubWorkspace.Accounts,
                Title = "Accounts",
                Subtitle = "Profit and loss and balance sheet workspace"
            },
            _ => _state
        };

        var requestVersion = BeginWorkspaceOperation();

        if (!ShowPeriodSelectors)
        {
            _selectedYearNumber = null;
            _selectedPeriodStartOn = null;
        }
        else if (!_selectedYearNumber.HasValue)
        {
            _selectedYearNumber = _defaultYearNumber;
            _selectedPeriodStartOn = null;

            if (_selectedYearNumber.HasValue)
            {
                var periods = await RunLatestAsync(
                    requestVersion,
                    () => TaxHubService.GetPeriodsAsync(_selectedYearNumber.Value));
                if (requestVersion != _requestVersion)
                    return;
                if (periods is not null)
                    _periods = periods;
            }
        }

        await RefreshWorkspaceAsync(requestVersion);

        if (_isMobile)
            _mobileView = TaxHubMobileView.Workspace;
    }

    private async Task HandleYearSelectedAsync(short yearNumber)
    {
        var requestVersion = BeginWorkspaceOperation();
        _selectedYearNumber = yearNumber > 0 ? yearNumber : null;

        if (_selectedYearNumber.HasValue)
        {
            var periods = await RunLatestAsync(
                requestVersion,
                () => TaxHubService.GetPeriodsAsync(_selectedYearNumber.Value));
            if (requestVersion != _requestVersion)
                return;
            if (periods is not null)
                _periods = periods;
            _selectedPeriodStartOn = null;
        }
        else
        {
            _periods = Array.Empty<TaxHubPeriodOption>();
            _selectedPeriodStartOn = null;
        }

        await RefreshWorkspaceAsync(requestVersion);
    }

    private async Task HandlePeriodSelectedAsync(DateTime? startOn)
    {
        var requestVersion = BeginWorkspaceOperation();
        _selectedPeriodStartOn = startOn;
        await RefreshWorkspaceAsync(requestVersion);
    }

    private async Task HandleFinalPeriodSelectedAsync()
    {
        if (_selectedYearNumber.HasValue && _periods.Count > 0)
        {
            _selectedPeriodStartOn = _periods
                .OrderBy(p => p.StartOn)
                .Last()
                .StartOn;

            await RefreshWorkspaceAsync(BeginWorkspaceOperation());
        }
    }

    private long BeginWorkspaceOperation()
    {
        var requestVersion = ++_requestVersion;
        _isWorkspaceLoading = true;
        _workspaceError = null;
        return requestVersion;
    }

    private Task RefreshWorkspaceAsync() => RefreshWorkspaceAsync(BeginWorkspaceOperation());

    private async Task RefreshWorkspaceAsync(long requestVersion)
    {
        var workspace = _state?.SelectedWorkspace ?? TaxHubWorkspace.Dashboard;
        var yearNumber = _selectedYearNumber;
        var periodStartOn = _selectedPeriodStartOn;

        try
        {
            await _serviceGate.WaitAsync();
            try
            {
                if (requestVersion != _requestVersion)
                    return;

                switch (workspace)
                {
                    case TaxHubWorkspace.Vat:
                        var vat = await TaxHubService.GetVatWorkspaceAsync(yearNumber, periodStartOn);
                        if (requestVersion == _requestVersion)
                            _vatWorkspace = vat;
                        break;
                    case TaxHubWorkspace.BusinessTax:
                        var businessTax = await TaxHubService.GetBusinessTaxWorkspaceAsync(yearNumber, periodStartOn);
                        if (requestVersion == _requestVersion)
                            _businessTaxWorkspace = businessTax;
                        break;
                    case TaxHubWorkspace.Accounts:
                        var accounts = await TaxHubService.GetAccountsWorkspaceAsync(yearNumber, periodStartOn);
                        if (requestVersion == _requestVersion)
                            _accountsWorkspace = accounts;
                        break;
                    default:
                        var dashboard = await TaxHubService.GetDashboardAsync();
                        if (requestVersion == _requestVersion)
                            _dashboard = dashboard;
                        break;
                }
            }
            finally
            {
                _serviceGate.Release();
            }
        }
        catch (System.Exception ex)
        {
            if (requestVersion == _requestVersion)
                _workspaceError = $"Unable to load {GetWorkspaceName(workspace)}. {ex.Message}";
        }
        finally
        {
            if (requestVersion == _requestVersion)
                _isWorkspaceLoading = false;
        }
    }

    private async Task<T?> RunLatestAsync<T>(long requestVersion, Func<Task<T>> operation)
    {
        await _serviceGate.WaitAsync();
        try
        {
            return requestVersion == _requestVersion ? await operation() : default;
        }
        finally
        {
            _serviceGate.Release();
        }
    }

    private static string GetWorkspaceName(TaxHubWorkspace workspace) => workspace switch
    {
        TaxHubWorkspace.Vat => "the VAT workspace",
        TaxHubWorkspace.BusinessTax => "the Business Tax workspace",
        TaxHubWorkspace.Accounts => "the Accounts workspace",
        _ => "the Dashboard"
    };

    private Task PersistState()
    {
        if (!_isLoading && _state is not null)
            PersistentState.PersistAsJson(nameof(TaxHubShellSnapshot), CreateSnapshot());
        return Task.CompletedTask;
    }

    private TaxHubShellSnapshot CreateSnapshot() => new(
        _isMobile, _isAdministrator, _state, _dashboard, _vatWorkspace, _businessTaxWorkspace,
        _accountsWorkspace, _years, _periods, _selectedYearNumber, _selectedPeriodStartOn,
        _defaultYearNumber, _defaultPeriodStartOn);

    private void RestoreSnapshot(TaxHubShellSnapshot snapshot)
    {
        _isMobile = snapshot.IsMobile;
        _isAdministrator = snapshot.IsAdministrator;
        _state = snapshot.State;
        _dashboard = snapshot.Dashboard;
        _vatWorkspace = snapshot.VatWorkspace;
        _businessTaxWorkspace = snapshot.BusinessTaxWorkspace;
        _accountsWorkspace = snapshot.AccountsWorkspace;
        _years = snapshot.Years;
        _periods = snapshot.Periods;
        _selectedYearNumber = snapshot.SelectedYearNumber;
        _selectedPeriodStartOn = snapshot.SelectedPeriodStartOn;
        _defaultYearNumber = snapshot.DefaultYearNumber;
        _defaultPeriodStartOn = snapshot.DefaultPeriodStartOn;
    }

    public void Dispose()
    {
        _persistingSubscription.Dispose();
    }

    public sealed record TaxHubShellSnapshot(
        bool IsMobile,
        bool IsAdministrator,
        TaxHubWorkflowState State,
        TaxHubDashboardModel? Dashboard,
        TaxHubVatWorkspaceModel? VatWorkspace,
        TaxHubBusinessTaxWorkspaceModel? BusinessTaxWorkspace,
        TaxHubAccountsWorkspaceModel? AccountsWorkspace,
        IReadOnlyList<TaxHubYearOption> Years,
        IReadOnlyList<TaxHubPeriodOption> Periods,
        short? SelectedYearNumber,
        DateTime? SelectedPeriodStartOn,
        short? DefaultYearNumber,
        DateTime? DefaultPeriodStartOn);

    private string GetPeriodSummary()
    {
        if (!ShowPeriodSelectors)
            return "No period filter";

        var year = _years.FirstOrDefault(y => y.YearNumber == _selectedYearNumber)?.Description ?? "All years";
        var period = _periods.FirstOrDefault(p => p.StartOn == _selectedPeriodStartOn)?.Description ?? "All months in year";
        return $"{year} • {period}";
    }
}
