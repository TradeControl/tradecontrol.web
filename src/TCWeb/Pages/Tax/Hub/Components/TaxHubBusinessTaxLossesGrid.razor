@using MudBlazor
@using TradeControl.Web.Pages.Tax.Hub.Models

<div class="tc-register-grid tc-tax-hub-business-tax-losses-grid">
    <MudStack Class="mb-2" Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Spacing="2">
        <MudChip T="string" Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small">
            Rows: @VisibleItems.Count
        </MudChip>
    </MudStack>

    <div class="tc-grid-host">
        <MudDataGrid T="TaxHubBusinessTaxLossesRow"
                     Class="tc-register-datagrid tc-tax-hub-datagrid"
                     @ref="_grid"
                     Items="Items"
                     FixedHeader="true"
                     Hover="true"
                     Dense="true"
                     Bordered="true"
                     Striped="true"
                     Filterable="true"
                     Sortable="true"
                     ShowPager="true"
                     ReadOnly="true"
                     FilterMode="DataGridFilterMode.ColumnFilterMenu"
                     FilterCaseSensitivity="DataGridFilterCaseSensitivity.CaseInsensitive"
                     FilteredItemsChanged="OnFilteredItemsChanged">
            <Columns>
                <PropertyColumn Property="x => x.YearEndDescription" Title="Period" />
                <PropertyColumn Property="x => x.TaxDue" Title="Tax Due" Format="#,##0.00;(#,##0.00);-">
                    <FooterTemplate>
                        <b>@TotalTaxDue.ToString("#,##0.00;(#,##0.00);-")</b>
                    </FooterTemplate>
                </PropertyColumn>
                <PropertyColumn Property="x => x.TaxBalance" Title="Tax Balance" Format="#,##0.00;(#,##0.00);-">
                    <FooterTemplate>
                        <b>@TotalTaxBalance.ToString("#,##0.00;(#,##0.00);-")</b>
                    </FooterTemplate>
                </PropertyColumn>
                <PropertyColumn Property="x => x.LossesCarriedForward" Title="Carried Forward" Format="#,##0.00;(#,##0.00);-">
                    <FooterTemplate>
                        <b>@LatestLossesCarriedForward.ToString("#,##0.00;(#,##0.00);-")</b>
                    </FooterTemplate>
                </PropertyColumn>
            </Columns>
            <PagerContent>
                <MudDataGridPager />
            </PagerContent>
        </MudDataGrid>
    </div>
</div>

@code {
    private MudDataGrid<TaxHubBusinessTaxLossesRow>? _grid;

    [Parameter] public IReadOnlyList<TaxHubBusinessTaxLossesRow> Items { get; set; } = Array.Empty<TaxHubBusinessTaxLossesRow>();

    private List<TaxHubBusinessTaxLossesRow> VisibleItems { get; set; } = new();

    private decimal TotalTaxDue { get; set; }
    private decimal TotalTaxBalance { get; set; }
    private decimal LatestLossesCarriedForward { get; set; }

    protected override void OnParametersSet()
    {
        VisibleItems = Items.ToList();
        RecalculateTotals();
    }

    private void OnFilteredItemsChanged(IEnumerable<TaxHubBusinessTaxLossesRow> filteredItems)
    {
        VisibleItems = filteredItems.ToList();
        RecalculateTotals();
        StateHasChanged();
    }

    private void RecalculateTotals()
    {
        TotalTaxDue = VisibleItems.Sum(x => x.TaxDue);
        TotalTaxBalance = VisibleItems.Sum(x => x.TaxBalance);
        LatestLossesCarriedForward = VisibleItems
            .OrderByDescending(x => x.StartOn)
            .Select(x => x.LossesCarriedForward)
            .FirstOrDefault();
    }
}
