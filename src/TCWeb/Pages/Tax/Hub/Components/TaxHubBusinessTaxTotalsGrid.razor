@using MudBlazor
@using TradeControl.Web.Pages.Tax.Hub.Models

<div class="tc-register-grid tc-tax-hub-business-tax-totals-grid">
    <MudStack Class="mb-2" Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Spacing="2">
        <MudChip T="string" Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small">
            Rows: @VisibleItems.Count
        </MudChip>
    </MudStack>

    <div class="tc-grid-host">
        <MudDataGrid T="TaxHubBusinessTaxTotalRow"
                     Class="tc-register-datagrid tc-tax-hub-datagrid"
                     @ref="_grid"
                     Items="Items"
                     FixedHeader="true"
                     Hover="true"
                     Dense="true"
                     Bordered="true"
                     Striped="true"
                     Filterable="true"
                     Sortable="true"
                     ShowPager="true"
                     ReadOnly="true"
                     RowsPerPage="12"
                     FilterMode="DataGridFilterMode.ColumnFilterMenu"
                     FilterCaseSensitivity="DataGridFilterCaseSensitivity.CaseInsensitive"
                     FilteredItemsChanged="OnFilteredItemsChanged">
            <Columns>
                <PropertyColumn Property="x => x.Description" Title="F/Year" />
                <PropertyColumn Property="x => x.Period" Title="Period" />
                <PropertyColumn Property="x => x.BusinessTaxRate" Title="Tax Rate" Format="P">
                    <FooterTemplate>
                        <b>@AverageTaxRate.ToString("P")</b>
                    </FooterTemplate>
                </PropertyColumn>
                <PropertyColumn Property="x => x.BusinessTaxAdjustment" Title="Adj." Format="#,##0.00;(#,##0.00);-">
                    <FooterTemplate>
                        <b>@TotalBusinessTaxAdjustment.ToString("#,##0.00;(#,##0.00);-")</b>
                    </FooterTemplate>
                </PropertyColumn>
                <PropertyColumn Property="x => x.NetProfit" Title="Net Profit" Format="#,##0.00;(#,##0.00);-">
                    <FooterTemplate>
                        <b>@TotalNetProfit.ToString("#,##0.00;(#,##0.00);-")</b>
                    </FooterTemplate>
                </PropertyColumn>
                <PropertyColumn Property="x => x.BusinessTax" Title="Business Tax" Format="#,##0.00;(#,##0.00);-">
                    <FooterTemplate>
                        <b>@TotalBusinessTax.ToString("#,##0.00;(#,##0.00);-")</b>
                    </FooterTemplate>
                </PropertyColumn>
            </Columns>
            <PagerContent>
                <MudDataGridPager />
            </PagerContent>
        </MudDataGrid>
    </div>
</div>

@code {
    private MudDataGrid<TaxHubBusinessTaxTotalRow>? _grid;

    [Parameter] public IReadOnlyList<TaxHubBusinessTaxTotalRow> Items { get; set; } = Array.Empty<TaxHubBusinessTaxTotalRow>();

    private List<TaxHubBusinessTaxTotalRow> VisibleItems { get; set; } = new();

    private decimal TotalBusinessTaxAdjustment { get; set; }
    private decimal TotalNetProfit { get; set; }
    private decimal TotalBusinessTax { get; set; }
    private decimal AverageTaxRate { get; set; }

    protected override void OnParametersSet()
    {
        VisibleItems = Items.ToList();
        RecalculateTotals();
    }

    private void OnFilteredItemsChanged(IEnumerable<TaxHubBusinessTaxTotalRow> filteredItems)
    {
        VisibleItems = filteredItems.ToList();
        RecalculateTotals();
        StateHasChanged();
    }

    private void RecalculateTotals()
    {
        TotalBusinessTaxAdjustment = VisibleItems.Sum(x => x.BusinessTaxAdjustment);
        TotalNetProfit = VisibleItems.Sum(x => x.NetProfit);
        TotalBusinessTax = VisibleItems.Sum(x => x.BusinessTax);
        AverageTaxRate = VisibleItems.Count == 0 ? 0m : VisibleItems.Average(x => x.BusinessTaxRate);
    }
}
