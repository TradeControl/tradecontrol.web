@using MudBlazor
@using TradeControl.Web.Pages.Tax.Hub.Models

@if (Section is not null && Section.Rows.Count > 0)
{
    <div class="tc-tax-hub-profit-and-loss-detail-grid p-3">
        <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-2">
            <div>
                <strong>Cash code detail</strong>
                <span class="text-muted ms-2">@Section.Category</span>
            </div>
            <span class="text-muted small">@Section.Rows.Count row@(Section.Rows.Count == 1 ? string.Empty : "s")</span>
        </div>

        <div class="tc-grid-host tc-tax-hub-detail-grid-host">
            <MudDataGrid T="TaxHubProfitAndLossDetailRow"
                         Class="tc-register-datagrid tc-tax-hub-datagrid"
                         Items="@Section.Rows"
                         Breakpoint="Breakpoint.Md"
                         FixedHeader="false"
                         Hover="true"
                         Dense="true"
                         Bordered="true"
                         Striped="true"
                         Filterable="false"
                         ReadOnly="true">
                <Columns>
                    <PropertyColumn Property="x => x.CashCode" Title="Cash Code" />
                    <PropertyColumn Property="x => x.CashDescription" Title="Description" />
                    <PropertyColumn Property="x => x.CurrentValue" Title="@CurrentHeading" Format="#,##0.00;(#,##0.00);-">
                        <CellTemplate>
                            <span class="@(context.Item.CurrentValue < 0 ? "text-danger" : null)">
                                @context.Item.CurrentValue.ToString("#,##0.00;(#,##0.00);-")
                            </span>
                        </CellTemplate>
                        <FooterTemplate>
                            <b class="@(Section.CurrentTotal < 0 ? "text-danger" : null)">@Section.CurrentTotal.ToString("#,##0.00;(#,##0.00);-")</b>
                        </FooterTemplate>
                    </PropertyColumn>
                    <PropertyColumn Property="x => x.PreviousValue" Title="@PreviousHeading" Format="#,##0.00;(#,##0.00);-">
                        <CellTemplate>
                            <span class="@(context.Item.PreviousValue < 0 ? "text-danger" : null)">
                                @context.Item.PreviousValue.ToString("#,##0.00;(#,##0.00);-")
                            </span>
                        </CellTemplate>
                        <FooterTemplate>
                            <b class="@(Section.PreviousTotal < 0 ? "text-danger" : null)">@Section.PreviousTotal.ToString("#,##0.00;(#,##0.00);-")</b>
                        </FooterTemplate>
                    </PropertyColumn>
                </Columns>
            </MudDataGrid>
        </div>
    </div>
}

@code {
    [Parameter, EditorRequired] public TaxHubProfitAndLossDetailSection? Section { get; set; }
    [Parameter] public string CurrentHeading { get; set; } = "Current";
    [Parameter] public string PreviousHeading { get; set; } = "Previous";
}
