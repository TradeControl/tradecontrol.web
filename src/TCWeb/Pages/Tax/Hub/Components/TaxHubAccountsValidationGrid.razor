@using MudBlazor
@using TradeControl.Web.Pages.Tax.Hub.Models

<div class="tc-tax-hub-accounts-validation">
    <MudStack Class="mb-3" Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Spacing="2">
        <MudChip T="string" Variant="Variant.Filled" Color="@GetSummaryColour(Summary.Status)" Size="Size.Small">
            @Summary.Status
        </MudChip>
        <div class="small text-muted">
            @Summary.TotalRows years · Pass @Summary.PassCount · Warn @Summary.WarnCount · Fail @Summary.FailCount
        </div>
    </MudStack>

    <MudGrid Spacing="3">
        @foreach (var item in Items)
        {
            <MudItem xs="12" lg="6" xl="4">
                <MudCard Class="tc-tax-hub-reconciliation-card" Elevation="1">
                    <MudCardHeader Class="tc-tax-hub-reconciliation-header">
                        <CardHeaderContent>
                            <MudText Typo="Typo.h6">@item.Description</MudText>
                            <MudText Typo="Typo.caption">Financial year @item.YearNumber</MudText>
                        </CardHeaderContent>
                        <CardHeaderActions>
                            <MudChip T="string" Variant="Variant.Filled" Color="@GetSummaryColour(item.Status)" Size="Size.Small">
                                @item.Status
                            </MudChip>
                        </CardHeaderActions>
                    </MudCardHeader>

                    <MudCardContent>
                        <div class="tc-tax-hub-reconciliation-values">
                            <div class="tc-tax-hub-reconciliation-row">
                                <span>Opening capital</span>
                                <span class="@AmountClass(item.OpeningCapital)">@FormatAmount(item.OpeningCapital)</span>
                            </div>
                            <div class="tc-tax-hub-reconciliation-row">
                                <span>Profit</span>
                                <span class="@AmountClass(item.Profit)">@FormatAmount(item.Profit)</span>
                            </div>
                            <div class="tc-tax-hub-reconciliation-row tc-tax-hub-reconciliation-subtract">
                                <span>Less business tax</span>
                                <span class="@AmountClass(-item.BusinessTax)">@FormatAmount(-item.BusinessTax)</span>
                            </div>
                            <div class="tc-tax-hub-reconciliation-row tc-tax-hub-reconciliation-subtotal">
                                <span>Profit after tax</span>
                                <span class="@AmountClass(item.ProfitAfterTax)">@FormatAmount(item.ProfitAfterTax)</span>
                            </div>
                            <div class="tc-tax-hub-reconciliation-row">
                                <span>Capital movement</span>
                                <span class="@AmountClass(item.CapitalMovement)">@FormatAmount(item.CapitalMovement)</span>
                            </div>
                            <div class="tc-tax-hub-reconciliation-row">
                                <span>Opening account position</span>
                                <span class="@AmountClass(item.OpeningAccountPosition)">@FormatAmount(item.OpeningAccountPosition)</span>
                            </div>
                            <div class="tc-tax-hub-reconciliation-row tc-tax-hub-reconciliation-total">
                                <strong>Calculated closing capital</strong>
                                <strong class="@AmountClass(item.CalculatedClosingCapital)">@FormatAmount(item.CalculatedClosingCapital)</strong>
                            </div>
                            <div class="tc-tax-hub-reconciliation-row">
                                <span>Reported closing capital</span>
                                <span class="@AmountClass(item.ClosingCapital)">@FormatAmount(item.ClosingCapital)</span>
                            </div>
                            <div class="tc-tax-hub-reconciliation-row tc-tax-hub-reconciliation-variance @VarianceClass(item.Status)">
                                <strong>Variance</strong>
                                <strong class="@AmountClass(item.Variance)">@FormatAmount(item.Variance)</strong>
                            </div>
                        </div>

                        @if (HasDiagnostics(item))
                        {
                            <details class="tc-tax-hub-reconciliation-diagnostics mt-3">
                                <summary>Supporting tax and opening-position information</summary>
                                <div class="pt-2">
                                    @if (item.OpeningSubjectPosition != 0m)
                                    {
                                        <div class="tc-tax-hub-reconciliation-row">
                                            <span>Opening subject position</span>
                                            <span class="@AmountClass(item.OpeningSubjectPosition)">@FormatAmount(item.OpeningSubjectPosition)</span>
                                        </div>
                                    }
                                    @if (item.TaxCarry != 0m)
                                    {
                                        <div class="tc-tax-hub-reconciliation-row">
                                            <span>Tax carry</span>
                                            <span class="@AmountClass(item.TaxCarry)">@FormatAmount(item.TaxCarry)</span>
                                        </div>
                                    }
                                    @if (item.OpeningLossesCarriedForward != 0m || item.ClosingLossesCarriedForward != 0m)
                                    {
                                        <div class="tc-tax-hub-reconciliation-row">
                                            <span>Opening losses carried forward</span>
                                            <span class="@AmountClass(item.OpeningLossesCarriedForward)">@FormatAmount(item.OpeningLossesCarriedForward)</span>
                                        </div>
                                        <div class="tc-tax-hub-reconciliation-row">
                                            <span>Closing losses carried forward</span>
                                            <span class="@AmountClass(item.ClosingLossesCarriedForward)">@FormatAmount(item.ClosingLossesCarriedForward)</span>
                                        </div>
                                    }
                                </div>
                            </details>
                        }
                    </MudCardContent>
                </MudCard>
            </MudItem>
        }
    </MudGrid>
</div>

@code {
    [Parameter] public IReadOnlyList<TaxHubEquityReconciliationRow> Items { get; set; } = Array.Empty<TaxHubEquityReconciliationRow>();
    [Parameter] public TaxHubAccountsValidationSummary Summary { get; set; } = new();

    private static string FormatAmount(decimal value) => value.ToString("#,##0.00;(#,##0.00);-");
    private static string? AmountClass(decimal value) => value < 0m ? "text-danger" : null;

    private static bool HasDiagnostics(TaxHubEquityReconciliationRow item) =>
        item.OpeningSubjectPosition != 0m ||
        item.TaxCarry != 0m ||
        item.OpeningLossesCarriedForward != 0m ||
        item.ClosingLossesCarriedForward != 0m;

    private static string VarianceClass(string status) => status switch
    {
        "FAIL" => "tc-tax-hub-reconciliation-fail",
        "WARN" => "tc-tax-hub-reconciliation-warn",
        "PASS" => "tc-tax-hub-reconciliation-pass",
        _ => string.Empty
    };

    private static Color GetSummaryColour(string status) => status switch
    {
        "FAIL" => Color.Error,
        "WARN" => Color.Warning,
        "PASS" => Color.Success,
        _ => Color.Default
    };
}
