@using MudBlazor
@using Microsoft.Extensions.Logging
@using Microsoft.Extensions.Options
@using TradeControl.Tax.UK.Application.Preparation
@using TradeControl.Web.AppServices.TaxHub
@using TradeControl.Web.AppServices.TaxHub.CompaniesHouse
@using TradeControl.Web.Pages.Tax.Hub.Models
@inject IOptions<CompaniesHouseProductHostOptions> CompaniesHouseHost
@inject ICompaniesHouseFilingContinuationService CompaniesHouseContinuation
@inject ICompaniesHouseSubmissionStatusService CompaniesHouseStatus
@inject ITaxHubService TaxHubService
@inject ILogger<TaxHubAccountsWorkspace> Logger

@if (Workspace is null)
{
    <div class="text-muted">No Accounts workspace data available.</div>
}
else
{
    <div class="tc-tax-hub-accounts d-flex flex-column gap-4">
        @if (_loadingSection.HasValue)
        {
            <div class="alert alert-secondary py-2 mb-0" role="status">
                <span class="spinner-border spinner-border-sm me-2" aria-hidden="true"></span>
                Loading @SectionName(_loadingSection.Value)…
            </div>
        }
        else if (!string.IsNullOrWhiteSpace(_sectionError))
        {
            <div class="alert alert-danger py-2 mb-0" role="alert">@_sectionError</div>
        }

        <MudTabs Rounded="true"
                 ActivePanelIndex="@_activePanelIndex"
                 ActivePanelIndexChanged="LoadSectionAsync">
            <MudTabPanel Text="@(IsMobile ? "Annual" : "Annual P&L")" Class="pt-3">
                <section class="d-flex flex-column gap-3">
                    <div>
                        <div class="text-muted small">@Workspace.SelectedYearName</div>
                    </div>

                    <div>
                        <div class="mb-2">
                            <h2 class="h5 mb-1">Accounts</h2>
                        </div>
                        <TaxHubProfitAndLossGrid Items="@Workspace.AnnualProfitAndLoss"
                                                 Sections="@Workspace.AnnualDetails"
                                                 CurrentHeading="@Workspace.SelectedYearName"
                                                 PreviousHeading="@Workspace.SelectedPreviousYearName" />
                    </div>
                </section>
            </MudTabPanel>

            <MudTabPanel Text="@(IsMobile ? "Monthly" : "Monthly P&L")" Class="pt-3">
                <section class="d-flex flex-column gap-3">
                    <div>
                        <div class="text-muted small">@Workspace.SelectedPeriodName</div>
                    </div>

                    <div>
                        <div class="mb-2">
                            <h2 class="h5 mb-1">Accounts</h2>
                        </div>
                        <TaxHubProfitAndLossGrid Items="@Workspace.MonthlyProfitAndLoss"
                                                 Sections="@Workspace.MonthlyDetails"
                                                 CurrentHeading="@Workspace.SelectedPeriodName"
                                                 PreviousHeading="@Workspace.SelectedPreviousPeriodName" />
                    </div>
                </section>
            </MudTabPanel>

            <MudTabPanel Text="@(IsMobile ? "Balance" : "Balance Sheet")">
                <section class="d-flex flex-column gap-3">
                    <div class="d-flex flex-wrap align-items-center justify-content-between gap-2">
                        <div>
                            <div class="text-muted small">
                                @Workspace.SelectedPeriodName
                                @if (Workspace.IsYearEndBalanceSheet)
                                {
                                    <span class="ms-2 tc-tax-hub-year-end-glyph" title="Year end balance sheet" aria-label="Year end balance sheet">◆ Year end</span>
                                }
                            </div>
                        </div>
                    </div>

                    <TaxHubBalanceSheetGrid Items="@Workspace.BalanceSheet"
                                            CurrentHeading="@Workspace.SelectedPeriodName"
                                            PreviousHeading="@Workspace.SelectedPreviousPeriodName" />

                    @if (Workspace.SubjectBalanceEvidence is not null)
                    {
                        var evidence = Workspace.SubjectBalanceEvidence;
                        <div class="card shadow-sm">
                            <div class="card-body d-flex flex-column gap-3">
                                <div class="d-flex flex-wrap align-items-start justify-content-between gap-2">
                                    <div>
                                        <h3 class="h6 mb-1">Year-end debtors and creditors</h3>
                                        <div class="text-muted small">
                                            Subject statement positions at @evidence.EffectiveDate.ToString("d MMMM yyyy")
                                        </div>
                                    </div>
                                    <span class="badge @(evidence.IsReconciled ? "bg-success" : "bg-danger")">
                                        @(evidence.IsReconciled ? "Reconciled" : "Review required")
                                    </span>
                                </div>

                                <div class="row g-2">
                                    <div class="col-12 col-sm-6">
                                        <div class="border rounded bg-light p-3 h-100">
                                            <div class="small text-muted">Debtors · @evidence.DebtorCount Subject@(evidence.DebtorCount == 1 ? string.Empty : "s")</div>
                                            <div class="fw-semibold">@evidence.DebtorTotal.ToString("C")</div>
                                        </div>
                                    </div>
                                    <div class="col-12 col-sm-6">
                                        <div class="border rounded bg-light p-3 h-100">
                                            <div class="small text-muted">Creditors · @evidence.CreditorCount Subject@(evidence.CreditorCount == 1 ? string.Empty : "s")</div>
                                            <div class="fw-semibold">@evidence.CreditorTotal.ToString("C")</div>
                                        </div>
                                    </div>
                                </div>

                                @if (!evidence.IsClosedPeriod)
                                {
                                    <div class="alert alert-warning py-2 mb-0 small" role="status">
                                        This accounting year is still open. Source changes will create a new snapshot digest.
                                    </div>
                                }

                                <div class="d-flex flex-wrap align-items-center justify-content-between gap-2">
                                    <div class="small text-muted text-break" title="@evidence.SnapshotToken">
                                        Evidence SHA-256: <code>@evidence.SnapshotToken[..12]…</code>
                                    </div>
                                    <a class="btn btn-outline-primary btn-sm" href="@evidence.SubjectBrowserUrl">
                                        Review in Subject Browser
                                    </a>
                                </div>
                            </div>
                        </div>
                    }
                </section>
            </MudTabPanel>

            <MudTabPanel Text="Validation">
                <section class="d-flex flex-column gap-3">
                    <div class="d-flex flex-wrap align-items-center justify-content-between gap-2">
                        <div>
                            <div class="text-muted small">
                                Equity bridge reconciliation
                            </div>
                        </div>

                        <div class="small text-muted">
                            Tolerance @Workspace.ValidationSummary.Tolerance.ToString("#,##0.00;(#,##0.00);-")
                        </div>
                    </div>

                    <TaxHubAccountsValidationGrid Items="@Workspace.EquityReconciliation"
                                                  Summary="@Workspace.ValidationSummary" />
                </section>
            </MudTabPanel>

            <MudTabPanel Text="@(IsMobile ? "File" : "File Your Accounts")">
                <section class="d-flex flex-column gap-3 pt-2">
                    <div class="d-flex flex-wrap align-items-start justify-content-between gap-2">
                        <div>
                            <h2 class="h5 mb-1">File your accounts</h2>
                            <div class="text-muted small">Review, prepare and approve the selected accounting year in one continuous journey</div>
                        </div>
                        <span class="badge @(Workspace.CompaniesHouse.IsEligible ? "bg-success" : "bg-warning text-dark")">
                            @Workspace.CompaniesHouse.Status
                        </span>
                    </div>

                    @if (CompaniesHouseHost.Value.DispatchMode == CompaniesHouseDispatchMode.OfficialTestSingleSend)
                    {
                        <div class="alert alert-danger border-2 mb-0" role="status">
                            <strong>OFFICIAL TEST — NOT A LIVE FILING</strong>
                            <div class="small mt-1">
                                This development deployment is pinned to the Companies House official test gateway and uses test credentials only.
                                The live package reference is not configured here, so this journey cannot file live accounts.
                            </div>
                        </div>
                    }

                    <div class="card shadow-sm">
                        <div class="card-body">
                            <dl class="row mb-0">
                                <dt class="col-sm-4">Company number</dt>
                                <dd class="col-sm-8">@DisplayOrDash(Workspace.CompaniesHouse.CompanyNumberDisplay)</dd>
                                <dt class="col-sm-4">Accounting period</dt>
                                <dd class="col-sm-8">@DisplayOrDash(Workspace.CompaniesHouse.PeriodDisplay)</dd>
                                <dt class="col-sm-4">Filing profile</dt>
                                <dd class="col-sm-8">@Workspace.CompaniesHouse.FilingProfile</dd>
                                <dt class="col-sm-4">Accounts sequence</dt>
                                <dd class="col-sm-8">@DisplayOrDash(Workspace.CompaniesHouse.AccountsSequence)</dd>
                                <dt class="col-sm-4">Equity Bridge</dt>
                                <dd class="col-sm-8 mb-0">@DisplayOrDash(Workspace.CompaniesHouse.EquityBridgeStatus)</dd>
                            </dl>
                        </div>
                    </div>

                    @if (Workspace.CompaniesHouse.Findings.Count > 0)
                    {
                        <div>
                            <h3 class="h6">Readiness findings</h3>
                            <ul class="mb-0">
                                @foreach (var finding in Workspace.CompaniesHouse.Findings)
                                {
                                    <li class="@(finding.IsBlocking ? "text-danger" : "text-muted")">
                                        @finding.Message <span class="small">(@finding.Code)</span>
                                    </li>
                                }
                            </ul>
                        </div>
                    }

                    @if (_filingContinuationLoading)
                    {
                        <div class="alert alert-secondary mb-0" role="status">
                            Checking for an existing filing conversation…
                        </div>
                    }
                    else if (_filingContinuationError is not null)
                    {
                        <div class="alert alert-danger mb-0" role="alert">
                            <strong>Filing continuation could not be verified.</strong>
                            <div class="small mt-1">@_filingContinuationError</div>
                            <div class="small mt-1">A new filing journey is disabled until this check succeeds.</div>
                        </div>
                    }
                    else if (_existingFiling is not null)
                    {
                        <div class="card border-primary shadow-sm">
                            <div class="card-body d-flex flex-column gap-3">
                                <div>
                                    <div class="badge bg-primary mb-2">EXISTING FILING — DO NOT RESUBMIT</div>
                                    <h3 class="h6 mb-1">Continue the existing Companies House filing</h3>
                                    <div class="text-muted small">
                                        This company, accounting period and filing profile already have a durable filing conversation.
                                        A new preparation and submission are blocked.
                                    </div>
                                </div>
                                <dl class="row small mb-0">
                                    <dt class="col-md-3">Submission number</dt>
                                    <dd class="col-md-9 font-monospace">@(_existingFiling.SubmissionNumber ?? "Not allocated")</dd>
                                    <dt class="col-md-3">State</dt>
                                    <dd class="col-md-9">@_existingFiling.State</dd>
                                    <dt class="col-md-3">Last updated</dt>
                                    <dd class="col-md-9">@_existingFiling.UpdatedAtUtc.ToLocalTime().ToString("dd MMM yyyy HH:mm")</dd>
                                    @if (_existingFiling.LastStatusCheckedAtUtc.HasValue)
                                    {
                                        <dt class="col-md-3">Status checked</dt>
                                        <dd class="col-md-9">@_existingFiling.LastStatusCheckedAtUtc.Value.ToLocalTime().ToString("dd MMM yyyy HH:mm")</dd>
                                    }
                                    <dt class="col-md-3">Document SHA-256</dt>
                                    <dd class="col-md-9 text-break font-monospace">@_existingFiling.DocumentSha256</dd>
                                    <dt class="col-md-3">Package SHA-256</dt>
                                    <dd class="col-md-9 text-break font-monospace">@_existingFiling.PackageSha256</dd>
                                    @if (_existingFiling.SupportReference is not null)
                                    {
                                        <dt class="col-md-3">Support reference</dt>
                                        <dd class="col-md-9 font-monospace">@_existingFiling.SupportReference</dd>
                                    }
                                </dl>
                                @if (_existingFiling.State is CompaniesHouseConversationState.Acknowledged
                                    or CompaniesHouseConversationState.Pending
                                    or CompaniesHouseConversationState.Parked
                                    or CompaniesHouseConversationState.Accepted)
                                {
                                    <div class="d-flex flex-wrap gap-2">
                                        <a class="btn btn-outline-primary"
                                           href="@($"/TaxHub/CompaniesHouse/Preparation/{_existingFiling.PreparationReference}/OfficialTestSubmission.pdf")">
                                            Download official-test submitted PDF
                                        </a>
                                        @if (CompaniesHouseHost.Value.DispatchMode == CompaniesHouseDispatchMode.OfficialTestSingleSend
                                            && (_existingFiling.State is CompaniesHouseConversationState.Acknowledged
                                                or CompaniesHouseConversationState.Pending
                                                or CompaniesHouseConversationState.Parked))
                                        {
                                            <button type="button" class="btn btn-primary"
                                                    disabled="@(_checkingFilingStatus || _existingFiling.StatusCheckInProgress)"
                                                    @onclick="CheckFilingStatus">
                                                @(_checkingFilingStatus || _existingFiling.StatusCheckInProgress
                                                    ? "Checking status…" : "Check Companies House status")
                                            </button>
                                        }
                                    </div>
                                }
                                @if (_statusCheckError is not null)
                                {
                                    <div class="alert alert-danger mb-0 small" role="alert">@_statusCheckError</div>
                                }
                                @if (_existingFiling.LastStatusCheckOutcome is not null)
                                {
                                    <div class="border rounded p-3 small">
                                        <strong>Latest status enquiry: @_existingFiling.LastStatusCheckOutcome</strong>
                                        <dl class="row mt-2 mb-0">
                                            <dt class="col-md-3">Transaction ID</dt>
                                            <dd class="col-md-9 font-monospace">@_existingFiling.LastStatusTransactionId</dd>
                                            <dt class="col-md-3">Request SHA-256</dt>
                                            <dd class="col-md-9 text-break font-monospace">@_existingFiling.LastStatusRequestSha256</dd>
                                            <dt class="col-md-3">Response SHA-256</dt>
                                            <dd class="col-md-9 text-break font-monospace">@(_existingFiling.LastStatusResponseSha256 ?? "No safely classified response")</dd>
                                        </dl>
                                        @if (!string.IsNullOrWhiteSpace(_existingFiling.ExaminerComment))
                                        {
                                            <div class="mt-1">Companies House comment: @_existingFiling.ExaminerComment</div>
                                        }
                                        @if (_existingFiling.StatusCheckErrors.Count > 0)
                                        {
                                            <ul class="mb-0 mt-2">
                                                @foreach (var error in _existingFiling.StatusCheckErrors)
                                                {
                                                    <li>@error.Code — @error.Message</li>
                                                }
                                            </ul>
                                        }
                                        @if (_existingFiling.StatusCheckSupportReference is not null)
                                        {
                                            <div class="mt-1">Support reference: <span class="font-monospace">@_existingFiling.StatusCheckSupportReference</span></div>
                                        }
                                    </div>
                                }
                                <div class="alert @ExistingFilingMessageClass mb-0 small">
                                    @ExistingFilingMessage
                                </div>
                            </div>
                        </div>
                    }
                    else if (!_filingJourneyStarted)
                    {
                        <div class="card border-primary shadow-sm">
                            <div class="card-body d-flex flex-column gap-3">
                                <div>
                                    <h3 class="h6 mb-1">Ready to begin?</h3>
                                    <div class="text-muted small">
                                        You will first review the year-end accounting evidence, then the filing information and exact accounts document before approving anything.
                                    </div>
                                </div>
                                <div>
                                    <button type="button" class="btn btn-primary"
                                            disabled="@(!Workspace.CompaniesHouse.IsEligible || Workspace.SubjectBalanceEvidence is null)"
                                            @onclick="StartFilingJourney">
                                        Start filing journey
                                    </button>
                                </div>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div>
                            <button type="button" class="btn btn-link px-0" @onclick="ReturnToFilingOverview">
                                ← Back to filing overview
                            </button>
                        </div>

                        <TaxHubCompaniesHouseEvidenceReview Evidence="Workspace.SubjectBalanceEvidence"
                                                             BankCashEvidence="Workspace.BankCashEvidence"
                                                             FixedAssetEvidence="Workspace.FixedAssetEvidence"
                                                             Readiness="Workspace.CompaniesHouse"
                                                             EvidenceChanged="OnWorkspaceRefreshRequested"
                                                             CompletionChanged="HandleEvidenceReviewCompletion" />

                        @if (_evidenceReviewComplete)
                        {
                            <TaxHubCompaniesHouseFilingInputs Readiness="Workspace.CompaniesHouse"
                                                                YearNumber="Workspace.SelectedYearNumber"
                                                                SelectedPeriodStart="Workspace.SelectedPeriodStartOn"
                                                                EvidenceReviewSatisfied="true" />
                        }
                    }

                    @if (CompaniesHouseHost.Value.DispatchMode == CompaniesHouseDispatchMode.OfficialTestSingleSend)
                    {
                        <div class="alert alert-warning mb-0" role="status">
                            Preparation and immutable approval make no external request. After approval, a separate explicit one-send
                            control can submit to the official test gateway only. Live filing remains disabled.
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-info mb-0" role="status">
                            Preparation and immutable approval only — no request is made to Companies House. Submission remains disabled.
                        </div>
                    }
                </section>
            </MudTabPanel>
        </MudTabs>
    </div>
}

@code {
    [Parameter] public TaxHubAccountsWorkspaceModel? Workspace { get; set; }
    [Parameter] public bool IsMobile { get; set; }
    [Parameter] public EventCallback OnWorkspaceRefreshRequested { get; set; }

    private bool _evidenceReviewComplete;
    private bool _filingJourneyStarted;
    private string? _filingJourneyKey;
    private CompaniesHouseFilingContinuation? _existingFiling;
    private bool _filingContinuationLoading;
    private string? _filingContinuationError;
    private bool _checkingFilingStatus;
    private string? _statusCheckError;
    private int _activePanelIndex;
    private string? _workspaceKey;
    private readonly HashSet<TaxHubAccountsWorkspaceSection> _loadedSections = [];
    private TaxHubAccountsWorkspaceSection? _loadingSection;
    private string? _sectionError;

    private string ExistingFilingMessageClass => _existingFiling?.State switch
    {
        CompaniesHouseConversationState.Accepted => "alert-success",
        CompaniesHouseConversationState.Rejected or CompaniesHouseConversationState.InternalFailure
            or CompaniesHouseConversationState.GatewayRejected => "alert-danger",
        _ => "alert-info"
    };

    private string ExistingFilingMessage => _existingFiling?.State switch
    {
        CompaniesHouseConversationState.Accepted =>
            "Companies House reports this official-test submission as accepted. It remains test evidence, not a live filing.",
        CompaniesHouseConversationState.Rejected =>
            "Companies House rejected this submission. The same approved package cannot be resubmitted.",
        CompaniesHouseConversationState.Pending =>
            "Companies House reports this submission as pending. Keep this conversation and check again later.",
        CompaniesHouseConversationState.Parked =>
            "Companies House has parked this submission. Keep this conversation and follow the recovery guidance.",
        _ =>
            "Gateway acknowledgement is not terminal acceptance. Check this conversation's Companies House status; it must never be replaced by another submission."
    };

    protected override async Task OnParametersSetAsync()
    {
        var workspaceKey = Workspace is null
            ? null
            : $"{Workspace.SelectedYearNumber}:{Workspace.SelectedPeriodStartOn:yyyy-MM-dd}";
        if (!string.Equals(workspaceKey, _workspaceKey, StringComparison.Ordinal))
        {
            _workspaceKey = workspaceKey;
            _activePanelIndex = 0;
            _loadedSections.Clear();
            if (Workspace is not null)
                _loadedSections.Add(TaxHubAccountsWorkspaceSection.Annual);
            _loadingSection = null;
            _sectionError = null;
        }

        await InitializeFilingJourneyAsync();
    }

    private async Task InitializeFilingJourneyAsync()
    {
        var key = Workspace is null
            ? null
            : $"{Workspace.SelectedYearNumber}:{Workspace.SelectedPeriodStartOn:yyyy-MM-dd}:{Workspace.CompaniesHouse.Status}:{Workspace.SubjectBalanceEvidence?.SnapshotToken}";
        if (string.Equals(key, _filingJourneyKey, StringComparison.Ordinal)) return;

        _filingJourneyKey = key;
        _filingJourneyStarted = false;
        _evidenceReviewComplete = false;
        _existingFiling = null;
        _filingContinuationError = null;
        _filingContinuationLoading = false;
        _checkingFilingStatus = false;
        _statusCheckError = null;
        if (Workspace is null || !Workspace.CompaniesHouse.IsEligible) return;

        _filingContinuationLoading = true;
        try
        {
            _existingFiling = await CompaniesHouseContinuation.FindAsync(
                Workspace.CompaniesHouse.FilingInputs.PeriodStart,
                Workspace.CompaniesHouse.FilingInputs.PeriodEnd);
        }
        catch (OperationCanceledException)
        {
            throw;
        }
        catch (Exception exception)
        {
            Logger.LogWarning(exception,
                "Companies House filing continuation could not be verified for period ending {PeriodEnd}.",
                Workspace.CompaniesHouse.FilingInputs.PeriodEnd);
            _filingContinuationError =
                "The durable Companies House filing record could not be checked safely.";
        }
        finally
        {
            _filingContinuationLoading = false;
        }
    }

    private async Task LoadSectionAsync(int panelIndex)
    {
        _activePanelIndex = panelIndex;
        if (Workspace is null || !Enum.IsDefined(typeof(TaxHubAccountsWorkspaceSection), panelIndex))
            return;

        var section = (TaxHubAccountsWorkspaceSection)panelIndex;
        if (_loadedSections.Contains(section) || _loadingSection.HasValue)
            return;

        _loadingSection = section;
        _sectionError = null;
        await InvokeAsync(StateHasChanged);
        try
        {
            var result = await TaxHubService.GetAccountsWorkspaceAsync(
                Workspace.SelectedYearNumber,
                Workspace.SelectedPeriodStartOn,
                section);

            switch (section)
            {
                case TaxHubAccountsWorkspaceSection.Monthly:
                    Workspace.MonthlyProfitAndLoss = result.MonthlyProfitAndLoss;
                    Workspace.MonthlyDetails = result.MonthlyDetails;
                    break;
                case TaxHubAccountsWorkspaceSection.BalanceSheet:
                    Workspace.BalanceSheet = result.BalanceSheet;
                    Workspace.SubjectBalanceEvidence = result.SubjectBalanceEvidence;
                    break;
                case TaxHubAccountsWorkspaceSection.Validation:
                    Workspace.ValidationSummary = result.ValidationSummary;
                    Workspace.EquityReconciliation = result.EquityReconciliation;
                    break;
                case TaxHubAccountsWorkspaceSection.Filing:
                    Workspace.ValidationSummary = result.ValidationSummary;
                    Workspace.EquityReconciliation = result.EquityReconciliation;
                    Workspace.CompaniesHouse = result.CompaniesHouse;
                    Workspace.SubjectBalanceEvidence = result.SubjectBalanceEvidence;
                    Workspace.BankCashEvidence = result.BankCashEvidence;
                    Workspace.FixedAssetEvidence = result.FixedAssetEvidence;
                    await InitializeFilingJourneyAsync();
                    break;
            }

            _loadedSections.Add(section);
        }
        catch (Exception exception)
        {
            Logger.LogWarning(exception, "Accounts workspace section {Section} could not be loaded.", section);
            _sectionError = $"Unable to load {SectionName(section)}. {exception.Message}";
        }
        finally
        {
            _loadingSection = null;
        }

        if (_activePanelIndex != panelIndex)
            await LoadSectionAsync(_activePanelIndex);
    }

    private static string SectionName(TaxHubAccountsWorkspaceSection section) => section switch
    {
        TaxHubAccountsWorkspaceSection.Monthly => "monthly profit and loss",
        TaxHubAccountsWorkspaceSection.BalanceSheet => "the balance sheet",
        TaxHubAccountsWorkspaceSection.Validation => "accounts validation",
        TaxHubAccountsWorkspaceSection.Filing => "the filing workspace",
        _ => "annual profit and loss"
    };

    private void StartFilingJourney()
    {
        _filingJourneyStarted = true;
        _evidenceReviewComplete = false;
    }

    private void ReturnToFilingOverview()
    {
        _filingJourneyStarted = false;
        _evidenceReviewComplete = false;
    }

    private void HandleEvidenceReviewCompletion(bool isComplete) => _evidenceReviewComplete = isComplete;

    private async Task CheckFilingStatus()
    {
        if (_existingFiling is null || _checkingFilingStatus || _existingFiling.StatusCheckInProgress)
            return;
        _checkingFilingStatus = true;
        _statusCheckError = null;
        try
        {
            await CompaniesHouseStatus.CheckAsync(_existingFiling.ConversationReference);
            _existingFiling = await CompaniesHouseContinuation.FindAsync(
                Workspace!.CompaniesHouse.FilingInputs.PeriodStart,
                Workspace.CompaniesHouse.FilingInputs.PeriodEnd);
        }
        catch (Exception exception) when (exception is InvalidOperationException
            or ArgumentException or KeyNotFoundException or UnauthorizedAccessException)
        {
            Logger.LogWarning(exception,
                "Companies House filing status could not be checked for conversation {ConversationReference}.",
                _existingFiling.ConversationReference);
            _statusCheckError = exception.Message;
        }
        finally
        {
            _checkingFilingStatus = false;
        }
    }

    private static string DisplayOrDash(string value) => string.IsNullOrWhiteSpace(value) ? "—" : value;
}
