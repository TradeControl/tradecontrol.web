@using MudBlazor
@using TradeControl.Web.Pages.Tax.Hub.Models

<div class="tc-register-grid tc-tax-hub-vat-periods-grid">
    <MudStack Class="mb-2" Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Spacing="2">
        <MudChip T="string" Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small">
            Rows: @VisibleItems.Count
        </MudChip>
    </MudStack>

    <div class="tc-grid-host">
        <MudDataGrid T="TaxHubVatPeriodRow"
                     Class="tc-register-datagrid tc-tax-hub-datagrid"
                     @ref="_grid"
                     Items="Items"
                     FixedHeader="true"
                     Hover="true"
                     Dense="true"
                     Bordered="true"
                     Striped="true"
                     Filterable="true"
                     Sortable="true"
                     ShowPager="true"
                     ReadOnly="true"
                     FilterMode="DataGridFilterMode.ColumnFilterMenu"
                     FilterCaseSensitivity="DataGridFilterCaseSensitivity.CaseInsensitive"
                     FilteredItemsChanged="OnFilteredItemsChanged">
            <Columns>
                <PropertyColumn Property="x => x.StartOn" Title="Date" Format="dd/MM/yyyy" />
                <PropertyColumn Property="x => x.TaxCode" Title="Tax Code" />
                <PropertyColumn Property="x => x.vatDueSales" Title="VAT Due on Sales" Format="#,##0.00;(#,##0.00);-">
                    <FooterTemplate>
                        <b>@TotalVatDueSales.ToString("#,##0.00;(#,##0.00);-")</b>
                    </FooterTemplate>
                </PropertyColumn>
                <PropertyColumn Property="x => x.vatDueAcquisitions" Title="VAT Due on Acquisitions" Format="#,##0.00;(#,##0.00);-">
                    <FooterTemplate>
                        <b>@TotalVatDueAcquisitions.ToString("#,##0.00;(#,##0.00);-")</b>
                    </FooterTemplate>
                </PropertyColumn>
                <PropertyColumn Property="x => x.vatReclaimedCurrPeriod" Title="VAT Reclaimed" Format="#,##0.00;(#,##0.00);-">
                    <FooterTemplate>
                        <b>@TotalVatReclaimedCurrPeriod.ToString("#,##0.00;(#,##0.00);-")</b>
                    </FooterTemplate>
                </PropertyColumn>
                <PropertyColumn Property="x => x.totalValueSalesExVAT" Title="Sales ex VAT" Format="#,##0.00;(#,##0.00);-">
                    <FooterTemplate>
                        <b>@TotalValueSalesExVat.ToString("#,##0.00;(#,##0.00);-")</b>
                    </FooterTemplate>
                </PropertyColumn>
                <PropertyColumn Property="x => x.totalValuePurchasesExVAT" Title="Purchases ex VAT" Format="#,##0.00;(#,##0.00);-">
                    <FooterTemplate>
                        <b>@TotalValuePurchasesExVat.ToString("#,##0.00;(#,##0.00);-")</b>
                    </FooterTemplate>
                </PropertyColumn>
                <PropertyColumn Property="x => x.totalValueGoodsSuppliedExVAT" Title="Goods Supplied ex VAT" Format="#,##0.00;(#,##0.00);-">
                    <FooterTemplate>
                        <b>@TotalValueGoodsSuppliedExVat.ToString("#,##0.00;(#,##0.00);-")</b>
                    </FooterTemplate>
                </PropertyColumn>
                <PropertyColumn Property="x => x.totalValueGoodsReceivedExVAT" Title="Goods Received ex VAT" Format="#,##0.00;(#,##0.00);-">
                    <FooterTemplate>
                        <b>@TotalValueGoodsReceivedExVat.ToString("#,##0.00;(#,##0.00);-")</b>
                    </FooterTemplate>
                </PropertyColumn>
            </Columns>
            <PagerContent>
                <MudDataGridPager />
            </PagerContent>
        </MudDataGrid>
    </div>
</div>

@code {
    private MudDataGrid<TaxHubVatPeriodRow>? _grid;

    [Parameter] public IReadOnlyList<TaxHubVatPeriodRow> Items { get; set; } = Array.Empty<TaxHubVatPeriodRow>();

    private List<TaxHubVatPeriodRow> VisibleItems { get; set; } = new();

    private decimal TotalVatDueSales { get; set; }
    private decimal TotalVatDueAcquisitions { get; set; }
    private decimal TotalVatReclaimedCurrPeriod { get; set; }
    private decimal TotalValueSalesExVat { get; set; }
    private decimal TotalValuePurchasesExVat { get; set; }
    private decimal TotalValueGoodsSuppliedExVat { get; set; }
    private decimal TotalValueGoodsReceivedExVat { get; set; }

    protected override void OnParametersSet()
    {
        VisibleItems = Items.ToList();
        RecalculateTotals();
    }

    private void OnFilteredItemsChanged(IEnumerable<TaxHubVatPeriodRow> filteredItems)
    {
        VisibleItems = filteredItems.ToList();
        RecalculateTotals();
        StateHasChanged();
    }

    private void RecalculateTotals()
    {
        TotalVatDueSales = VisibleItems.Sum(x => x.vatDueSales);
        TotalVatDueAcquisitions = VisibleItems.Sum(x => x.vatDueAcquisitions);
        TotalVatReclaimedCurrPeriod = VisibleItems.Sum(x => x.vatReclaimedCurrPeriod);
        TotalValueSalesExVat = VisibleItems.Sum(x => x.totalValueSalesExVAT);
        TotalValuePurchasesExVat = VisibleItems.Sum(x => x.totalValuePurchasesExVAT);
        TotalValueGoodsSuppliedExVat = VisibleItems.Sum(x => x.totalValueGoodsSuppliedExVAT);
        TotalValueGoodsReceivedExVat = VisibleItems.Sum(x => x.totalValueGoodsReceivedExVAT);
    }
}
