@using MudBlazor
@using TradeControl.Web.Pages.Tax.Hub.Models

@if (Workspace is null)
{
    <div class="text-muted">No VAT workspace data available.</div>
}
else
{
    <div class="tc-tax-hub-vat d-flex flex-column gap-4">
        <MudTabs Rounded="true">

            <MudTabPanel Text="@(IsMobile ? "Statement" : "VAT Statement")" Class="pt-3">
                <section class="tc-tax-hub-single-grid-panel">
                    <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-2">
                        <div>
                            <div class="text-muted small">Due, paid and running balance</div>
                        </div>
                    </div>

                    <TaxHubVatStatementGrid Items="@Workspace.Statement"
                                            ActiveStartOn="@Workspace.ActiveStatementStartOn" />
                </section>
            </MudTabPanel>

            <MudTabPanel Text="@(IsMobile ? "Submission" : "VAT Submission")" Class="pt-3">
                <section class="tc-tax-hub-single-grid-panel">
                    <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-2">
                        <div>
                            <div class="text-muted small">
                                @if (Workspace.IsAllYears)
                                {
                                    <span>All financial years</span>
                                }
                                else
                                {
                                    <span>@Workspace.SelectedYearDescription</span>
                                }
                            </div>
                        </div>

                        <a href="/Admin/Manager/Index?node=TaxRates"
                           target="_blank"
                           rel="noopener noreferrer"
                           class="btn btn-sm btn-outline-warning">
                            Adjust tax rates
                        </a>
                    </div>

                    <TaxHubVatTotalsGrid Items="@Workspace.Totals" />
                </section>
            </MudTabPanel>

            <MudTabPanel Text="@(IsMobile ? "Summary" : "VAT Summary")" Class="pt-3">
                <section class="tc-tax-hub-single-grid-panel">
                    <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-2">
                        <div>
                            <div class="text-muted small">
                                @if (Workspace.IsAllYears)
                                {
                                    <span>All years</span>
                                }
                                else if (Workspace.IsAllPeriodsInYear)
                                {
                                    <span>@Workspace.SelectedYearDescription - All months in year</span>
                                }
                                else
                                {
                                    <span>@Workspace.SelectedPeriodName</span>
                                }
                            </div>
                        </div>
                    </div>

                    <TaxHubVatPeriodsGrid Items="@Workspace.Periods" />
                </section>
            </MudTabPanel>

            @if (VatFilingEnabled)
            {
                <MudTabPanel Text="@(IsMobile ? "HMRC" : "HMRC Obligations")" Class="pt-3">
                    <TaxHubVatObligations />
                </MudTabPanel>
                <MudTabPanel Text="@(IsMobile ? "History" : "Filing History")" Class="pt-3">
                    <TaxHubVatFilingHistory PeriodFrom="@HistoryFrom" PeriodTo="@HistoryTo" />
                </MudTabPanel>
            }
        </MudTabs>
    </div>
}

@code {
    [Parameter] public TaxHubVatWorkspaceModel? Workspace { get; set; }
    [Parameter] public bool VatFilingEnabled { get; set; }
    [Parameter] public bool IsMobile { get; set; }

    private DateOnly? HistoryFrom => Workspace is null || Workspace.IsAllYears ? null
        : Workspace.SelectedPeriodStartOn.HasValue
            ? DateOnly.FromDateTime(Workspace.SelectedPeriodStartOn.Value)
            : Workspace.Periods.Count > 0
                ? DateOnly.FromDateTime(Workspace.Periods.Min(item => item.StartOn)) : null;

    private DateOnly? HistoryTo => Workspace is null || Workspace.IsAllYears ? null
        : Workspace.SelectedPeriodStartOn.HasValue
            ? DateOnly.FromDateTime(Workspace.SelectedPeriodStartOn.Value.AddMonths(1).AddDays(-1))
            : Workspace.Periods.Count > 0
                ? DateOnly.FromDateTime(Workspace.Periods.Max(item => item.StartOn).AddMonths(1).AddDays(-1)) : null;
}
