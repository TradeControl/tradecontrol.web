@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.Extensions.DependencyInjection
@using Microsoft.Extensions.Logging
@using Microsoft.Extensions.Options
@using TradeControl.Web.AppServices.TaxHub.CompaniesHouse
@using TradeControl.Web.Pages.Tax.Hub.Models
@using TradeControl.Web.Tenancy
@using TradeControl.Tax.UK.Application.Preparation
@implements IDisposable
@inject IBusinessClock BusinessClock
@inject ICompaniesHousePreparationReviewService PreparationService
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IServiceProvider Services
@inject IOptions<CompaniesHouseProductHostOptions> CompaniesHouseHost
@inject ILogger<TaxHubCompaniesHouseFilingInputs> Logger

@if (!Readiness.IsEligible)
{
    <div class="alert alert-secondary mb-0">Resolve the readiness findings before reviewing filing inputs.</div>
}
else if (!EvidenceReviewSatisfied)
{
    <div class="alert alert-warning mb-0" role="status">
        Complete the guided year-end evidence review before reviewing filing inputs or preparing accounts.
    </div>
}
else if (_draft is not null && _editContext is not null)
{
    <EditForm EditContext="_editContext" OnValidSubmit="ReviewInputs">
        <section class="d-flex flex-column gap-3">
            @if (!string.IsNullOrWhiteSpace(AmendsConversationReference))
            {
                <div class="card border-warning">
                    <div class="card-header"><strong>Revised accounts</strong></div>
                    <div class="card-body d-flex flex-column gap-3">
                        <p class="small mb-0">
                            These accounts will be a new statutory filing for the same period. The accepted original remains
                            on the Companies House register and in Trade Control evidence; it will not be altered or deleted.
                        </p>
                        <div>
                            <label class="form-label" for="ch-revision-noncompliance">Why did the previously filed accounts not comply?</label>
                            <InputTextArea id="ch-revision-noncompliance" class="form-control" rows="3"
                                           @bind-Value="_revisionNonCompliance"
                                           @bind-Value:after="InvalidateRevisionReview" />
                        </div>
                        <div>
                            <label class="form-label" for="ch-revision-amendments">What significant amendments have been made?</label>
                            <InputTextArea id="ch-revision-amendments" class="form-control" rows="3"
                                           @bind-Value="_revisionSignificantAmendments"
                                           @bind-Value:after="InvalidateRevisionReview" />
                        </div>
                        <div class="small text-muted">
                            The exact FRC revised-report marker, replacement statements and revision approval date will be
                            embedded in the iXBRL document for review before approval.
                        </div>
                    </div>
                </div>
            }
            <div>
                <h3 class="h6 mb-1">Reviewed filing inputs</h3>
                <div class="text-muted small">
                    These are statutory facts that cannot be taken reliably from Trade Control transactions. Balance-sheet values remain
                    transaction-derived and cannot be overridden here. Reviewing these inputs does not prepare or file accounts.
                </div>
            </div>

            <div class="row g-3">
                <div class="col-md-6">
                    <label class="form-label" for="ch-approved-on">Accounts approved on</label>
                    <InputDate id="ch-approved-on" class="form-control" @bind-Value="_draft.ApprovedOn" />
                </div>
                <div class="col-md-6">
                    <label class="form-label" for="ch-director">Signing director</label>
                    <InputText id="ch-director" class="form-control" @bind-Value="_draft.SigningDirectorName" />
                </div>
                <div class="col-12">
                    <label class="form-label" for="ch-activity">Principal activity</label>
                    <InputTextArea id="ch-activity" class="form-control" rows="2" @bind-Value="_draft.PrincipalActivity" />
                </div>
                <div class="col-12">
                    <label class="form-label" for="ch-policies">Accounting policies</label>
                    <InputTextArea id="ch-policies" class="form-control" rows="3" @bind-Value="_draft.AccountingPolicies" />
                </div>
                <div class="col-md-4">
                    <label class="form-label" for="ch-employees">Average employees</label>
                    <InputNumber id="ch-employees" class="form-control" @bind-Value="_draft.AverageEmployees" />
                </div>
            </div>

            <div class="card">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <span>Director advances and credits</span>
                    <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="AddDirectorAdvance">Add director</button>
                </div>
                <div class="card-body d-flex flex-column gap-3">
                    <div class="text-muted small">
                        Add one summary for each affected director. The four amounts describe movement over the selected accounting
                        period; they are not four separate advances and individual transaction dates are not required here.
                    </div>
                    @if (_draft.DirectorAdvances.Count == 0)
                    {
                        <div class="text-muted small">No director advance or credit disclosure entered.</div>
                    }
                    @for (var index = 0; index < _draft.DirectorAdvances.Count; index++)
                    {
                        var item = _draft.DirectorAdvances[index];
                        var itemIndex = index;
                        <div class="border rounded p-3">
                            <div class="d-flex justify-content-between mb-2">
                                <strong>Director @(index + 1)</strong>
                                <button type="button" class="btn btn-sm btn-outline-danger"
                                        @onclick="() => RemoveDirectorAdvance(itemIndex)">Remove</button>
                            </div>
                            <div class="row g-2">
                                <div class="col-md-6"><InputText class="form-control" placeholder="Director name" @bind-Value="item.DirectorName" /></div>
                                <div class="col-md-6"><InputText class="form-control" placeholder="Terms" @bind-Value="item.Terms" /></div>
                                <div class="col-md">
                                    <label class="form-label">Opening balance</label>
                                    <InputNumber class="form-control" @bind-Value="item.OpeningBalance" />
                                </div>
                                <div class="col-md">
                                    <label class="form-label">Advances or credits</label>
                                    <InputNumber class="form-control" @bind-Value="item.Advances" />
                                </div>
                                <div class="col-md">
                                    <label class="form-label">Repayments</label>
                                    <InputNumber class="form-control" @bind-Value="item.Repayments" />
                                </div>
                                <div class="col-md">
                                    <label class="form-label">Closing balance</label>
                                    <InputNumber class="form-control" @bind-Value="item.ClosingBalance" />
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>

            <div class="card">
                <div class="card-header">First-release filing eligibility</div>
                <div class="card-body">
                    <label class="form-label" for="ch-commitments-eligibility">
                        Does the company have any material commitments, guarantees, legal contingencies or similar obligations
                        requiring disclosure that are not already reflected in these accounts?
                    </label>
                    <InputSelect id="ch-commitments-eligibility" class="form-select"
                                 @bind-Value="_draft.ConfirmsNoMaterialCommitmentsOrContingencies">
                        <option value="">Select an answer</option>
                        <option value="true">No — I confirm there are none</option>
                        <option value="false">Yes, or I am unsure</option>
                    </InputSelect>
                    <div class="form-text">
                        Accounts Mode cannot prepare these disclosures in the first release. A Yes or unsure answer requires
                        separate professional review and cannot continue through this filing workflow.
                    </div>
                </div>
            </div>

            <div class="alert alert-light border mb-0">
                Supported-profile facts: micro-entity provisions apply; members have not required an audit; directors acknowledge their Companies Act responsibilities. Attribution and confirmation belong to Phase 7.5 approval.
            </div>

            @if (_errors.Count > 0)
            {
                <div class="alert alert-danger mb-0">
                    <ul class="mb-0">@foreach (var error in _errors) { <li>@error</li> }</ul>
                </div>
            }
            @if (_reviewed)
            {
                <div class="alert alert-success mb-0">
                    Filing inputs reviewed. You may now prepare the exact accounts document for review.
                </div>
            }

            @if (_prepared is not null)
            {
                <section class="card border-success">
                    <div class="card-header d-flex flex-wrap justify-content-between gap-2">
                        <strong>Exact retained accounts document</strong>
                        @if (_approval is null)
                        {
                            <span class="badge bg-secondary">Prepared — not approved or filed</span>
                        }
                        else
                        {
                            <span class="badge bg-primary">Approved — not filed</span>
                        }
                    </div>
                    <div class="card-body d-flex flex-column gap-3">
                        <dl class="row small mb-0">
                            <dt class="col-md-3">Document SHA-256</dt>
                            <dd class="col-md-9 text-break font-monospace">@_prepared.DocumentSha256</dd>
                            <dt class="col-md-3">Package SHA-256</dt>
                            <dd class="col-md-9 text-break font-monospace">@_prepared.PackageSha256</dd>
                            <dt class="col-md-3">Category Tree</dt>
                            <dd class="col-md-9">@_prepared.CategoryTree.VersionId</dd>
                            <dt class="col-md-3">Tree SHA-256</dt>
                            <dd class="col-md-9 text-break font-monospace">@_prepared.CategoryTree.CanonicalSha256</dd>
                            <dt class="col-md-3">Review expires</dt>
                            <dd class="col-md-9 mb-0">@_prepared.ExpiresAtUtc.ToLocalTime().ToString("dd MMM yyyy HH:mm")</dd>
                        </dl>
                        @if (_prepared.RevisionComparison is { } comparison)
                        {
                            <section class="card border-warning" aria-labelledby="ch-revision-comparison-title">
                                <div class="card-body">
                                    <h4 id="ch-revision-comparison-title" class="h6">Original and revised accounts</h4>
                                    <p class="small text-muted">
                                        Review the statutory changes before approving the revised document. The original remains immutable evidence.
                                    </p>
                                    <div class="table-responsive">
                                        <table class="table table-sm align-middle mb-3">
                                            <thead><tr><th>Value</th><th class="text-end">Accepted original</th><th class="text-end">Proposed revision</th><th class="text-end">Change</th></tr></thead>
                                            <tbody>
                                                @foreach (var difference in comparison.Differences)
                                                {
                                                    <tr>
                                                        <th scope="row">@difference.Label</th>
                                                        <td class="text-end">@difference.Original.ToString("C")</td>
                                                        <td class="text-end">@difference.Revised.ToString("C")</td>
                                                        <td class="text-end">@((difference.Revised - difference.Original).ToString("C"))</td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                    <dl class="row small mb-0">
                                        <dt class="col-md-3">Original full accounts</dt>
                                        <dd class="col-md-9 text-break font-monospace">@comparison.OriginalFullAccountsSha256</dd>
                                        <dt class="col-md-3">Revised full accounts</dt>
                                        <dd class="col-md-9 text-break font-monospace">@comparison.RevisedFullAccountsSha256</dd>
                                        <dt class="col-md-3">Replaces conversation</dt>
                                        <dd class="col-md-9 mb-0 font-monospace">@comparison.OriginalConversationReference</dd>
                                    </dl>
                                </div>
                            </section>
                        }
                        <div>
                            <a class="btn btn-primary" href="@_prepared.PdfPath">
                                Download draft PDF
                            </a>
                            <a class="btn btn-outline-primary ms-2" href="@_prepared.DownloadPath">
                                Download filing XHTML
                            </a>
                            <div class="small text-muted mt-2">
                                The PDF is a paged review copy marked DRAFT — NOT FILED. The XHTML download is the exact retained filing document shown below.
                            </div>
                        </div>
                        <iframe src="@_prepared.DocumentPath" title="Prepared Companies House accounts document"
                                sandbox="" referrerpolicy="no-referrer"
                                class="w-100 border rounded" style="min-height: 42rem"></iframe>

                        @if (_approval is null)
                        {
                            @if (_preparedInputsChanged)
                            {
                                <div class="alert alert-warning mb-0" role="status">
                                    The reviewed filing inputs changed after this draft was prepared. This exact draft cannot
                                    be approved. Discard it to release the Category Tree reservation, review the corrected inputs,
                                    and prepare a replacement.
                                </div>
                            }

                            @if (!_discardConfirmationRequested)
                            {
                                <div>
                                    <button type="button" class="btn btn-outline-danger"
                                            disabled="@_discarding"
                                            @onclick="() => _discardConfirmationRequested = true">
                                        Discard prepared draft
                                    </button>
                                    <div class="small text-muted mt-2">
                                        Available only before approval. The audit record is retained as invalidated and the
                                        Category Tree reservation is released.
                                    </div>
                                </div>
                            }
                            else
                            {
                                <div class="alert alert-warning mb-0" role="alert">
                                    <strong>Discard this unapproved draft?</strong>
                                    The document will remain in the audit history as invalidated and cannot be approved or filed.
                                    Its Category Tree reservation will be released.
                                    <div class="d-flex flex-wrap gap-2 mt-3">
                                        <button type="button" class="btn btn-danger"
                                                disabled="@_discarding"
                                                @onclick="DiscardPreparedDraft">
                                            @(_discarding ? "Discarding…" : "Discard draft and release reservation")
                                        </button>
                                        <button type="button" class="btn btn-outline-secondary"
                                                disabled="@_discarding"
                                                @onclick="() => _discardConfirmationRequested = false">
                                            Keep draft
                                        </button>
                                    </div>
                                </div>
                            }

                            @if (!_preparedInputsChanged)
                            {
                                <section class="card border-primary" aria-labelledby="ch-approval-title">
                                    <div class="card-body">
                                        <h4 id="ch-approval-title" class="h6">Approve these exact accounts</h4>
                                        <p class="small mb-2">@CompaniesHouseApprovalDeclaration.Text</p>
                                        <div class="form-check mb-3">
                                            <input id="ch-approval-confirmed" type="checkbox" class="form-check-input"
                                                   @bind="_approvalConfirmed" />
                                            <label class="form-check-label" for="ch-approval-confirmed">
                                                I confirm the declaration above for this exact document and package.
                                            </label>
                                        </div>
                                        <button type="button" class="btn btn-primary"
                                                disabled="@(!_approvalConfirmed || _approving)"
                                                @onclick="ApproveExactDocument">
                                            @(_approving ? "Recording approval…" : "Approve accounts — does not file")
                                        </button>
                                    </div>
                                </section>
                            }
                        }
                        else
                        {
                            <div class="alert alert-primary mb-0" role="status">
                                <strong>Approved — not filed.</strong>
                                This immutable approval is bound to the document and package digests above.
                                No request has been made to Companies House.
                                <dl class="row small mt-2 mb-0">
                                    <dt class="col-md-3">Approved by</dt>
                                    <dd class="col-md-9">@_approval.ApprovedBy</dd>
                                    <dt class="col-md-3">Approved at</dt>
                                    <dd class="col-md-9">@_approval.ApprovedAtUtc.ToLocalTime().ToString("dd MMM yyyy HH:mm")</dd>
                                    <dt class="col-md-3">Approval reference</dt>
                                    <dd class="col-md-9 mb-0 font-monospace">@_approval.Reference</dd>
                                </dl>
                            </div>

                            @if (CompaniesHouseHost.Value.DispatchMode == CompaniesHouseDispatchMode.OfficialTestSingleSend)
                            {
                                <section class="card border-danger border-2" aria-labelledby="ch-test-submit-title">
                                    <div class="card-body">
                                        <div class="badge bg-danger mb-2">OFFICIAL TEST — NOT LIVE</div>
                                        <h4 id="ch-test-submit-title" class="h6">Companies House official test service</h4>
                                        <p class="small">
                                            This sends the exact approved package above to the Companies House test gateway once.
                                            It is <strong>not a live filing</strong>. The submission cannot be automatically retried after dispatch begins.
                                        </p>
                                        @if (_filingStatus is null)
                                        {
                                            <div class="form-check mb-3">
                                                <input id="ch-test-submit-confirmed" type="checkbox" class="form-check-input"
                                                       @bind="_testSubmissionConfirmed" />
                                                <label class="form-check-label" for="ch-test-submit-confirmed">
                                                    Submit this exact approved document to the official test service.
                                                </label>
                                            </div>
                                            <button type="button" class="btn btn-danger"
                                                    disabled="@(!_testSubmissionConfirmed || _submitting)"
                                                    @onclick="SubmitOfficialTest">
                                                @(_submitting ? "Sending once…" : "Submit once — official test only")
                                            </button>
                                        }
                                        else
                                        {
                                            <div class="alert @FilingStatusClass mb-0" role="status">
                                                <strong>@FilingStatusTitle</strong>
                                                <dl class="row small mt-2 mb-0">
                                                    <dt class="col-md-3">Submission number</dt>
                                                    <dd class="col-md-9 font-monospace">@(_filingStatus.SubmissionNumber ?? "Not allocated")</dd>
                                                    <dt class="col-md-3">State</dt>
                                                    <dd class="col-md-9">@_filingStatus.State</dd>
                                                    @if (_filingStatus.SupportReference is not null)
                                                    {
                                                        <dt class="col-md-3">Support reference</dt>
                                                        <dd class="col-md-9 font-monospace">@_filingStatus.SupportReference</dd>
                                                    }
                                                </dl>
                                                @if (_filingStatus.Errors is { Count: > 0 })
                                                {
                                                    <ul class="small mb-0">
                                                        @foreach (var error in _filingStatus.Errors)
                                                        {
                                                            <li>@error.Code — @error.Message</li>
                                                        }
                                                    </ul>
                                                }
                                                @if (_filingStatus.State == CompaniesHouseConversationState.Accepted
                                                     && _prepared is not null)
                                                {
                                                    <div class="alert alert-primary mt-3 mb-0" role="status">
                                                        <strong>Category Tree @_prepared.CategoryTree.VersionId is now Submitted and read-only.</strong>
                                                        To change the classification, create and publish a successor Draft.
                                                    </div>
                                                }
                                                @if (_filingStatus.State == CompaniesHouseConversationState.Acknowledged
                                                     && _prepared is not null)
                                                {
                                                    <div class="mt-3">
                                                        <a class="btn btn-outline-success"
                                                           href="@($"/TaxHub/CompaniesHouse/Preparation/{_prepared.Reference}/OfficialTestSubmission.pdf")">
                                                            Download official-test submitted PDF
                                                        </a>
                                                        <div class="small text-muted mt-2">
                                                            This copy has no draft watermark. Its footer identifies the acknowledged
                                                            submission as OFFICIAL TEST — NOT LIVE FILED.
                                                        </div>
                                                    </div>
                                                }
                                            </div>
                                        }
                                    </div>
                                </section>
                            }
                        }
                    </div>
                </section>
            }

            <div>
                <button type="submit" class="btn btn-primary">Review filing inputs</button>
                @if (_reviewed && _prepared is null)
                {
                    <button type="button" class="btn btn-success ms-2" disabled="@_preparing"
                            @onclick="PrepareExactDocument">
                        @(_preparing ? "Preparing…" : "Prepare exact accounts")
                    </button>
                }
            </div>
        </section>
    </EditForm>
}

@code {
    [Parameter, EditorRequired] public TaxHubCompaniesHouseReadiness Readiness { get; set; } = new();
    [Parameter] public short? YearNumber { get; set; }
    [Parameter] public DateTime? SelectedPeriodStart { get; set; }
    [Parameter] public bool EvidenceReviewSatisfied { get; set; }
    [Parameter] public string? AmendsConversationReference { get; set; }
    [Parameter] public EventCallback<CompaniesHouseFilingStatus> FilingStatusChanged { get; set; }

    private TaxHubCompaniesHouseFilingInputDraft? _draft;
    private EditContext? _editContext;
    private string? _draftKey;
    private IReadOnlyList<string> _errors = Array.Empty<string>();
    private bool _reviewed;
    private bool _preparing;
    private bool _approvalConfirmed;
    private bool _approving;
    private bool _preparedInputsChanged;
    private bool _discardConfirmationRequested;
    private bool _discarding;
    private CompaniesHousePreparedReview? _prepared;
    private CompaniesHouseApprovalReview? _approval;
    private CompaniesHouseFilingStatus? _filingStatus;
    private bool _testSubmissionConfirmed;
    private bool _submitting;
    private string _revisionNonCompliance = string.Empty;
    private string _revisionSignificantAmendments = string.Empty;

    private string FilingStatusClass => _filingStatus?.State switch
    {
        CompaniesHouseConversationState.Acknowledged or CompaniesHouseConversationState.Accepted => "alert-success",
        CompaniesHouseConversationState.GatewayRejected => "alert-danger",
        _ when _filingStatus?.RecoveryRequired == true => "alert-danger",
        _ => "alert-info"
    };

    private string FilingStatusTitle => _filingStatus?.State switch
    {
        CompaniesHouseConversationState.Acknowledged => "Acknowledged by the Companies House official test gateway — not live filed.",
        CompaniesHouseConversationState.Accepted => "Accepted by the Companies House official test service — not live filed.",
        CompaniesHouseConversationState.GatewayRejected => "The Companies House official test gateway rejected the request.",
        _ when _filingStatus?.RecoveryRequired == true => "The exchange requires recovery review and will not be retried automatically.",
        _ => "Official-test submission recorded."
    };

    protected override async Task OnParametersSetAsync()
    {
        var key = $"{Readiness.FilingInputs.PeriodEnd:yyyy-MM-dd}:{Readiness.FilingInputs.IsFirstAccountsPeriod}:{Readiness.IsEligible}:{AmendsConversationReference}";
        if (_draftKey == key) return;
        _draftKey = key;
        SetDraft(Clone(Readiness.FilingInputs));
        _errors = Array.Empty<string>();
        _reviewed = false;
        _prepared = null;
        _approval = null;
        _approvalConfirmed = false;
        _filingStatus = null;
        _testSubmissionConfirmed = false;
        _preparedInputsChanged = false;
        _discardConfirmationRequested = false;
        _discarding = false;
        _revisionNonCompliance = string.Empty;
        _revisionSignificantAmendments = string.Empty;

        if (!Readiness.IsEligible || Readiness.FilingInputs.PeriodEnd == default)
            return;
        try
        {
            var principal = (await AuthenticationStateProvider.GetAuthenticationStateAsync()).User;
            var resumed = await PreparationService.ResumeAsync(principal,
                Readiness.FilingInputs.PeriodEnd);
            if (resumed is null)
                return;
            SetDraft(ToDraft(resumed.Input, Readiness.FilingInputs.IsFirstAccountsPeriod));
            _revisionNonCompliance = resumed.Input.Revision?.NonComplianceStatement ?? string.Empty;
            _revisionSignificantAmendments = resumed.Input.Revision?.SignificantAmendmentsStatement ?? string.Empty;
            _prepared = resumed.Preparation;
            _reviewed = true;
        }
        catch (Exception exception) when (exception is InvalidOperationException
            or ArgumentException or KeyNotFoundException or UnauthorizedAccessException)
        {
            _errors = [exception.Message];
        }
        catch (Exception exception) when (exception is not OperationCanceledException)
        {
            Logger.LogWarning(new EventId(6751, "CompaniesHouseDraftResumeUnavailable"), exception,
                "The retained Companies House draft could not be resumed.");
            _errors = ["The retained accounts draft could not be loaded. Nothing has been changed; reload the filing journey and try again."];
        }
    }

    private void ReviewInputs()
    {
        var errors = CompaniesHouseFilingInputReview.Validate(_draft!, BusinessClock.Today).ToList();
        if (!string.IsNullOrWhiteSpace(AmendsConversationReference))
        {
            if (string.IsNullOrWhiteSpace(_revisionNonCompliance))
                errors.Add("Explain how the previously filed accounts did not comply.");
            if (string.IsNullOrWhiteSpace(_revisionSignificantAmendments))
                errors.Add("Describe the significant amendments made in the revised accounts.");
        }
        _errors = errors;
        _reviewed = _errors.Count == 0;
    }

    private async Task PrepareExactDocument()
    {
        if (!_reviewed || _draft is null || !YearNumber.HasValue || !SelectedPeriodStart.HasValue
            || !_draft.ApprovedOn.HasValue || !_draft.ConfirmsNoMaterialCommitmentsOrContingencies.HasValue)
            return;
        _preparing = true;
        _errors = Array.Empty<string>();
        try
        {
            var principal = (await AuthenticationStateProvider.GetAuthenticationStateAsync()).User;
            var input = new CompaniesHousePreparationInput(
                    _draft.PeriodEnd,
                    DateOnly.FromDateTime(_draft.ApprovedOn.Value),
                    _draft.SigningDirectorName,
                    _draft.PrincipalActivity,
                    _draft.AccountingPolicies,
                    _draft.AverageEmployees,
                    _draft.ConfirmsNoMaterialCommitmentsOrContingencies.Value,
                    _draft.DirectorAdvances.Select(item => new CompaniesHouseDirectorAdvanceReview(
                        item.DirectorName, item.OpeningBalance, item.Advances, item.Repayments,
                        item.ClosingBalance, item.Terms)).ToArray(),
                    string.IsNullOrWhiteSpace(AmendsConversationReference)
                        ? null
                        : new(AmendsConversationReference,
                            _revisionNonCompliance,
                            _revisionSignificantAmendments));
            _prepared = string.IsNullOrWhiteSpace(AmendsConversationReference)
                ? await PreparationService.PrepareAsync(principal, YearNumber.Value,
                    SelectedPeriodStart.Value, input)
                : await PreparationService.PrepareAmendedAsync(principal, YearNumber.Value,
                    SelectedPeriodStart.Value, input);
            _approval = null;
            _approvalConfirmed = false;
            _preparedInputsChanged = false;
        }
        catch (Exception exception) when (exception is InvalidOperationException
            or ArgumentException or UnauthorizedAccessException)
        {
            _errors = [exception.Message];
        }
        finally
        {
            _preparing = false;
        }
    }

    private async Task ApproveExactDocument()
    {
        if (_prepared is null || !_approvalConfirmed || _approving) return;
        _approving = true;
        _errors = Array.Empty<string>();
        try
        {
            var principal = (await AuthenticationStateProvider.GetAuthenticationStateAsync()).User;
            _approval = await PreparationService.ApproveAsync(principal, _prepared.Reference,
                CompaniesHouseApprovalDeclaration.Version, true);
        }
        catch (CompaniesHousePreparationInvalidatedException exception)
        {
            _errors = [exception.Message];
            _prepared = null;
            _approval = null;
            _approvalConfirmed = false;
        }
        catch (Exception exception) when (exception is InvalidOperationException
            or ArgumentException or KeyNotFoundException or UnauthorizedAccessException)
        {
            _errors = [exception.Message];
        }
        finally
        {
            _approving = false;
        }
    }

    private async Task DiscardPreparedDraft()
    {
        if (_prepared is null || _approval is not null || _discarding)
            return;
        _discarding = true;
        _errors = Array.Empty<string>();
        try
        {
            var principal = (await AuthenticationStateProvider.GetAuthenticationStateAsync()).User;
            await PreparationService.DiscardAsync(principal, _prepared.Reference);
            _prepared = null;
            _reviewed = false;
            _approvalConfirmed = false;
            _preparedInputsChanged = false;
            _discardConfirmationRequested = false;
        }
        catch (Exception exception) when (exception is InvalidOperationException
            or ArgumentException or KeyNotFoundException or UnauthorizedAccessException)
        {
            _errors = [exception.Message];
        }
        catch (Exception exception) when (exception is not OperationCanceledException)
        {
            Logger.LogWarning(new EventId(6752, "CompaniesHouseDraftDiscardUnavailable"), exception,
                "The retained Companies House draft could not be discarded.");
            _errors = ["The draft discard did not complete. Reload the filing journey to check the retained draft before trying again."];
        }
        finally
        {
            _discarding = false;
        }
    }

    private async Task SubmitOfficialTest()
    {
        if (_approval is null || !_testSubmissionConfirmed || _submitting || _filingStatus is not null) return;
        _submitting = true;
        _errors = Array.Empty<string>();
        try
        {
            var principal = (await AuthenticationStateProvider.GetAuthenticationStateAsync()).User;
            var staging = Services.GetRequiredService<ICompaniesHouseSubmissionStagingService>();
            var dispatch = Services.GetRequiredService<ICompaniesHouseSubmissionDispatchService>();
            var staged = await staging.StageApprovedAsync(principal, _approval.Reference);
            _filingStatus = await dispatch.DispatchAsync(principal, staged.ConversationReference);
            if (FilingStatusChanged.HasDelegate)
                await FilingStatusChanged.InvokeAsync(_filingStatus);
        }
        catch (Exception exception) when (exception is InvalidOperationException
            or ArgumentException or KeyNotFoundException or UnauthorizedAccessException)
        {
            _errors = [exception.Message];
        }
        finally
        {
            _submitting = false;
        }
    }

    private void AddDirectorAdvance()
    {
        _draft!.DirectorAdvances.Add(new());
        InvalidateReview();
    }

    private void RemoveDirectorAdvance(int index)
    {
        _draft!.DirectorAdvances.RemoveAt(index);
        InvalidateReview();
    }

    private void InvalidateReview(object? sender = null, FieldChangedEventArgs? args = null)
    {
        _reviewed = false;
        _approval = null;
        _approvalConfirmed = false;
        _filingStatus = null;
        _testSubmissionConfirmed = false;
        _discardConfirmationRequested = false;
        if (_prepared is not null)
        {
            _preparedInputsChanged = true;
            _errors = ["The filing inputs changed after preparation. Discard the retained draft before preparing a replacement."];
            return;
        }
        _preparedInputsChanged = false;
        _errors = Array.Empty<string>();
    }

    private void InvalidateRevisionReview() => InvalidateReview();

    private void SetDraft(TaxHubCompaniesHouseFilingInputDraft draft)
    {
        if (_editContext is not null)
            _editContext.OnFieldChanged -= InvalidateReview;
        _draft = draft;
        _editContext = new EditContext(_draft);
        _editContext.OnFieldChanged += InvalidateReview;
    }

    private static TaxHubCompaniesHouseFilingInputDraft ToDraft(
        CompaniesHousePreparationInput input, bool isFirstAccountsPeriod) => new()
    {
        PeriodEnd = input.PeriodEnd,
        IsFirstAccountsPeriod = isFirstAccountsPeriod,
        ApprovedOn = input.ApprovedOn.ToDateTime(TimeOnly.MinValue),
        SigningDirectorName = input.SigningDirectorName,
        PrincipalActivity = input.PrincipalActivity,
        AccountingPolicies = input.AccountingPolicies,
        AverageEmployees = input.AverageEmployees,
        ConfirmsNoMaterialCommitmentsOrContingencies = input.ConfirmsNoMaterialCommitmentsOrContingencies,
        DirectorAdvances = input.DirectorAdvances.Select(item =>
            new TaxHubCompaniesHouseDirectorAdvanceInput
            {
                DirectorName = item.DirectorName,
                OpeningBalance = item.OpeningBalance,
                Advances = item.Advances,
                Repayments = item.Repayments,
                ClosingBalance = item.ClosingBalance,
                Terms = item.Terms
            }).ToList()
    };

    private static TaxHubCompaniesHouseFilingInputDraft Clone(TaxHubCompaniesHouseFilingInputDraft value) => new()
    {
        PeriodEnd = value.PeriodEnd,
        IsFirstAccountsPeriod = value.IsFirstAccountsPeriod,
        ApprovedOn = value.ApprovedOn,
        SigningDirectorName = value.SigningDirectorName,
        PrincipalActivity = value.PrincipalActivity,
        AccountingPolicies = value.AccountingPolicies,
        AverageEmployees = value.AverageEmployees,
        ConfirmsNoMaterialCommitmentsOrContingencies = value.ConfirmsNoMaterialCommitmentsOrContingencies,
        DirectorAdvances = value.DirectorAdvances.Select(item => new TaxHubCompaniesHouseDirectorAdvanceInput
        {
            DirectorName = item.DirectorName, OpeningBalance = item.OpeningBalance,
            Advances = item.Advances, Repayments = item.Repayments,
            ClosingBalance = item.ClosingBalance, Terms = item.Terms
        }).ToList()
    };

    public void Dispose()
    {
        if (_editContext is not null) _editContext.OnFieldChanged -= InvalidateReview;
    }
}
