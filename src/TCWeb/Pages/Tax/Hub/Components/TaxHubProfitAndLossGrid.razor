@using MudBlazor
@using TradeControl.Web.Pages.Tax.Hub.Models

<div class="tc-register-grid tc-tax-hub-profit-and-loss-grid">
    <MudStack Class="mb-2" Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Spacing="2">
        <MudChip T="string" Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small">
            Rows: @VisibleItems.Count
        </MudChip>
    </MudStack>

    <div class="tc-grid-host">
        <MudDataGrid T="TaxHubProfitAndLossRow"
                     Class="tc-register-datagrid tc-tax-hub-datagrid"
                     @ref="_grid"
                     Items="Items"
                     Breakpoint="Breakpoint.Md"
                     FixedHeader="true"
                     Hover="true"
                     Dense="true"
                     Bordered="true"
                     Striped="true"
                     Filterable="true"
                     ReadOnly="true"
                     RowsPerPage="50"
                     FilterMode="DataGridFilterMode.ColumnFilterMenu"
                     FilterCaseSensitivity="DataGridFilterCaseSensitivity.CaseInsensitive"
                     FilterChanged="OnFilterChanged">
            <Columns>
                <HierarchyColumn T="TaxHubProfitAndLossRow"
                                 EnableHeaderToggle="false"
                                 ButtonDisabledFunc="@HasNoDetail"
                                 HeaderStyle="width: 3rem;">
                    <CellTemplate>
                        <button type="button"
                                class="tc-tax-hub-hierarchy-toggle"
                                disabled="@HasNoDetail(context.Item)"
                                title="@(context.Open ? "Hide cash-code detail" : "Show cash-code detail")"
                                aria-label="@(context.Open ? "Collapse cash-code detail" : "Expand cash-code detail")"
                                @onclick:stopPropagation="true"
                                @onclick="() => ToggleDetailAsync(context.Item, context.Open)">
                            <span aria-hidden="true">@(context.Open ? "−" : "+")</span>
                        </button>
                    </CellTemplate>
                </HierarchyColumn>
                <PropertyColumn Property="x => x.CategoryCode" Title="Code" />
                <PropertyColumn Property="x => x.Category" Title="Category" />
                <PropertyColumn Property="x => x.CurrentValue" Title="@CurrentHeading" Format="#,##0.00;(#,##0.00);-">
                    <CellTemplate>
                        <span class="@(context.Item.CurrentValue < 0 ? "text-danger" : null)">
                            @context.Item.CurrentValue.ToString("#,##0.00;(#,##0.00);-")
                        </span>
                    </CellTemplate>
                    <FooterTemplate>
                        <b class="@(CurrentTotal < 0 ? "text-danger" : null)">@CurrentTotal.ToString("#,##0.00;(#,##0.00);-")</b>
                    </FooterTemplate>
                </PropertyColumn>
                <PropertyColumn Property="x => x.PreviousValue" Title="@PreviousHeading" Format="#,##0.00;(#,##0.00);-">
                    <CellTemplate>
                        <span class="@(context.Item.PreviousValue < 0 ? "text-danger" : null)">
                            @context.Item.PreviousValue.ToString("#,##0.00;(#,##0.00);-")
                        </span>
                    </CellTemplate>
                    <FooterTemplate>
                        <b class="@(PreviousTotal < 0 ? "text-danger" : null)">@PreviousTotal.ToString("#,##0.00;(#,##0.00);-")</b>
                    </FooterTemplate>
                </PropertyColumn>
            </Columns>
            <ChildRowContent>
                @if (FindDetail(context.Item.CategoryCode) is { } detailSection)
                {
                    <TaxHubProfitAndLossDetailGrid Section="@detailSection"
                                                   CurrentHeading="@CurrentHeading"
                                                   PreviousHeading="@PreviousHeading" />
                }
            </ChildRowContent>
            <PagerContent>
                <MudDataGridPager />
            </PagerContent>
        </MudDataGrid>
    </div>
</div>

@code {
    private MudDataGrid<TaxHubProfitAndLossRow>? _grid;
    private IReadOnlyDictionary<string, TaxHubProfitAndLossDetailSection> _details =
        new Dictionary<string, TaxHubProfitAndLossDetailSection>(StringComparer.OrdinalIgnoreCase);

    [Parameter] public IReadOnlyList<TaxHubProfitAndLossRow> Items { get; set; } = Array.Empty<TaxHubProfitAndLossRow>();
    [Parameter] public IReadOnlyList<TaxHubProfitAndLossDetailSection> Sections { get; set; } = Array.Empty<TaxHubProfitAndLossDetailSection>();
    [Parameter] public string CurrentHeading { get; set; } = "Current";
    [Parameter] public string PreviousHeading { get; set; } = "Previous";

    private List<TaxHubProfitAndLossRow> VisibleItems { get; set; } = new();

    private decimal CurrentTotal { get; set; }
    private decimal PreviousTotal { get; set; }

    protected override void OnParametersSet()
    {
        VisibleItems = Items.ToList();
        _details = Sections.ToDictionary(section => section.CategoryCode, StringComparer.OrdinalIgnoreCase);
        RecalculateTotals();
    }

    private bool HasNoDetail(TaxHubProfitAndLossRow item) => FindDetail(item.CategoryCode) is null;

    private TaxHubProfitAndLossDetailSection? FindDetail(string categoryCode) =>
        _details.TryGetValue(categoryCode, out var detail) && detail.Rows.Count > 0 ? detail : null;

    private async Task ToggleDetailAsync(TaxHubProfitAndLossRow item, bool isOpen)
    {
        if (_grid is null)
        {
            return;
        }

        if (!isOpen)
        {
            await _grid.CollapseAllHierarchy();
        }

        await _grid.ToggleHierarchyVisibilityAsync(item);
    }

    private void OnFilterChanged(IReadOnlyCollection<IFilterDefinition<TaxHubProfitAndLossRow>> _)
    {
        VisibleItems = _grid?.FilteredItems.ToList() ?? Items.ToList();
        RecalculateTotals();
        StateHasChanged();
    }

    private void RecalculateTotals()
    {
        CurrentTotal = VisibleItems.Sum(x => x.CurrentValue);
        PreviousTotal = VisibleItems.Sum(x => x.PreviousValue);
    }
}
