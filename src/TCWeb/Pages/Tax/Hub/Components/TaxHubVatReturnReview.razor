@using TradeControl.Web.AppServices.TaxHub.Vat
@using Microsoft.JSInterop
@inject IVatReturnReviewService Reviews
@inject IVatReturnSubmissionService Submissions
@inject IJSRuntime JavaScript

<section class="card mt-3" aria-labelledby="vat-return-review-title">
    <div class="card-body">
        <h3 id="vat-return-review-title" class="h5">VAT return review</h3>
        @if (_loading)
        {
            <div class="d-flex align-items-center gap-2 text-muted" role="status">
                <span class="spinner-border spinner-border-sm" aria-hidden="true"></span>
                <span>Preparing the exact VAT return…</span>
            </div>
        }
        else if (!string.IsNullOrWhiteSpace(_error))
        {
            <div class="alert alert-warning" role="alert">@_error</div>
            @foreach (var finding in _blockingFindings)
            {
                <div class="alert @FindingClass(finding.Severity) py-2">
                    <strong>@finding.Severity.ToUpperInvariant()</strong> @finding.Code — @finding.Message
                </div>
            }
        }
        else if (_review is not null)
        {
            <div class="mb-3">
                <div><strong>Period:</strong> @_review.PeriodStart.ToString("dd MMM yyyy") – @_review.PeriodEnd.ToString("dd MMM yyyy")</div>
                <div><strong>VAT registration:</strong> @_review.MaskedVrn</div>
                <div class="small text-muted">
                    HMRC shows the inclusive final day. Trade Control internally stores the following day as the exclusive period boundary.
                </div>
                <div class="small text-muted">The values below are read from the immutable prepared request and cannot be edited here.</div>
            </div>

            <div class="table-responsive mb-3">
                <table class="table table-sm align-middle">
                    <thead><tr><th>Box</th><th>Statutory description</th><th class="text-end">Value</th></tr></thead>
                    <tbody>
                    @foreach (var box in _review.Boxes)
                    {
                        <tr><td>@box.Number</td><td>@box.Description</td><td class="text-end">@box.Value</td></tr>
                    }
                    </tbody>
                </table>
            </div>

            @if (_review.Findings.Count == 0)
            {
                <div class="alert alert-success py-2">PASS — no preparation or reconciliation findings.</div>
            }
            else
            {
                @foreach (var finding in _review.Findings)
                {
                    <div class="alert @FindingClass(finding.Severity) py-2">
                        <strong>@finding.Severity.ToUpperInvariant()</strong> @finding.Code — @finding.Message
                    </div>
                }
            }

            <details class="mb-3">
                <summary>Advanced audit details</summary>
                <dl class="row small mt-2 mb-0">
                    <dt class="col-sm-3">Prepared SHA-256</dt><dd class="col-sm-9 text-break">@_review.PreparedSha256</dd>
                    <dt class="col-sm-3">Source</dt><dd class="col-sm-9">@_review.SourceSystem / @_review.DatasetKey</dd>
                    <dt class="col-sm-3">Snapshot</dt><dd class="col-sm-9 text-break">@_review.SnapshotToken</dd>
                    <dt class="col-sm-3">Expires</dt><dd class="col-sm-9">@_review.ExpiresAtUtc.ToString("u")</dd>
                </dl>
            </details>

            <div class="card bg-light mb-3">
                <div class="card-body">
                    <h4 class="h6">Legal declaration</h4>
                    <p>@_review.DeclarationText</p>
                    <div class="form-check">
                        <input id="vat-declaration-confirmation" class="form-check-input" type="checkbox"
                               @bind="_confirmed" disabled="@IsApproved" />
                        <label class="form-check-label" for="vat-declaration-confirmation">
                            I confirm this declaration for the exact VAT return shown above.
                        </label>
                    </div>
                    @if (HasWarnings)
                    {
                        <div class="form-check mt-2">
                            <input id="vat-warning-confirmation" class="form-check-input" type="checkbox"
                                   @bind="_warningsAcknowledged" disabled="@IsApproved" />
                            <label class="form-check-label" for="vat-warning-confirmation">
                                I have reviewed and acknowledge the preparation warnings shown above.
                            </label>
                        </div>
                    }
                </div>
            </div>

            @if (IsApproved)
            {
                @if (_submission is null)
                {
                    <div class="alert alert-warning" role="status">
                        <strong>Not yet submitted to HMRC.</strong>
                        Your internal approval has been recorded. Complete the HMRC submission step below to file this return.
                    </div>
                    <div id="vat-hmrc-submission" class="card border-danger border-2 mt-3"
                         tabindex="-1" @ref="_submissionStep">
                        <div class="card-body">
                            <h4 class="h5">Final step — submit to HMRC</h4>
                            <p class="small">
                                Approval alone does not file the return. This action sends the exact approved VAT return
                                to HMRC. A submission cannot be amended here, and an uncertain outcome must be reconciled
                                before any further attempt.
                            </p>
                            <div class="form-check mb-3">
                                <input id="vat-submit-confirmation" class="form-check-input" type="checkbox"
                                       @bind="_submitConfirmed" disabled="@_submitting" />
                                <label class="form-check-label" for="vat-submit-confirmation">
                                    I understand that this action submits the approved return to HMRC.
                                </label>
                            </div>
                            <button type="button" class="btn btn-danger"
                                    disabled="@(!_submitConfirmed || _submitting)" @onclick="SubmitAsync">
                                @(_submitting ? "Submitting to HMRC…" : "Submit VAT return to HMRC")
                            </button>
                        </div>
                    </div>
                }
                else
                {
                    <div class="alert @SubmissionClass(_submission.State) mt-3" role="status">
                        <strong>@SubmissionTitle(_submission.State)</strong>
                        <div>@SubmissionMessage(_submission)</div>
                        @if (!string.IsNullOrWhiteSpace(_submission.AttemptReference))
                        {
                            <div class="small">Attempt reference: @_submission.AttemptReference</div>
                        }
                        @if (_submission.AuthorityErrors is { Count: > 0 })
                        {
                            <ul class="small mt-2 mb-0">
                                @foreach (var error in _submission.AuthorityErrors)
                                {
                                    <li><strong>@error.Code</strong> — @error.Message</li>
                                }
                            </ul>
                        }
                        @if (_submission.State == VatSubmissionResultState.Accepted)
                        {
                            <dl class="row small mt-2 mb-0">
                                <dt class="col-sm-3">Processing date</dt><dd class="col-sm-9">@(_submission.ProcessingDate?.ToString("u") ?? "Not supplied")</dd>
                                <dt class="col-sm-3">Form bundle</dt><dd class="col-sm-9">@(_submission.FormBundleNumber ?? "Not supplied")</dd>
                                <dt class="col-sm-3">Payment indicator</dt><dd class="col-sm-9">@(_submission.PaymentIndicator ?? "Not supplied")</dd>
                                <dt class="col-sm-3">Charge reference</dt><dd class="col-sm-9">@(_submission.ChargeReference ?? "Not supplied")</dd>
                                <dt class="col-sm-3">HMRC readback</dt>
                                <dd class="col-sm-9">@(ReadbackText(_submission))</dd>
                                <dt class="col-sm-3">Obligation refresh</dt>
                                <dd class="col-sm-9">@(_submission.ObligationRefreshSucceeded ? "Fulfilled obligation confirmed" : "Pending reconciliation")</dd>
                            </dl>
                        }
                        @if (!string.IsNullOrWhiteSpace(_submission.SupportReference))
                        {
                            <div class="small">Support reference: @_submission.SupportReference</div>
                        }
                    </div>
                }
            }
            else
            {
                <button type="button" class="btn btn-primary"
                        disabled="@(!_confirmed || (HasWarnings && !_warningsAcknowledged) || _approving)"
                        @onclick="ApproveAsync">
                    @(_approving ? "Recording approval…" : "Approve return — does not submit")
                </button>
            }
        }
    </div>
</section>

@code {
    [Parameter, EditorRequired] public string PeriodKey { get; set; } = string.Empty;
    private VatReturnReviewModel? _review;
    private string? _loadedPeriodKey;
    private string? _error;
    private IReadOnlyList<VatReturnReviewFinding> _blockingFindings = [];
    private bool _loading;
    private bool _approving;
    private bool _confirmed;
    private bool _warningsAcknowledged;
    private bool _submitConfirmed;
    private bool _submitting;
    private ElementReference _submissionStep;
    private VatSubmissionResult? _submission;
    private bool IsApproved => !string.IsNullOrWhiteSpace(_review?.ApprovalReference);
    private bool HasWarnings => _review?.Findings.Any(item =>
        item.Severity.Equals("Warning", StringComparison.OrdinalIgnoreCase)) == true;

    protected override async Task OnParametersSetAsync()
    {
        if (PeriodKey == _loadedPeriodKey) return;
        _loadedPeriodKey = PeriodKey;
        _loading = true;
        _error = null;
        _blockingFindings = [];
        _review = null;
        _confirmed = false;
        _warningsAcknowledged = false;
        try { _review = await Reviews.PrepareAsync(PeriodKey); }
        catch (VatReturnReviewException exception)
        {
            _error = exception.Message;
            _blockingFindings = exception.Findings;
        }
        catch { _error = "The VAT return could not be prepared safely. Consult the Event Log."; }
        finally { _loading = false; }
    }

    private async Task ApproveAsync()
    {
        if (!_confirmed || _review is null || _approving) return;
        _approving = true;
        _error = null;
        try
        {
            _review = await Reviews.ApproveAsync(_review.PreparationReference,
                _review.DeclarationVersion, _warningsAcknowledged);
            await InvokeAsync(StateHasChanged);
            await JavaScript.InvokeVoidAsync("taxHubHmrc.showSubmissionStep", _submissionStep);
        }
        catch (VatReturnReviewException exception) { _error = exception.Message; }
        catch { _error = "The approval could not be recorded safely. Consult the Event Log."; }
        finally { _approving = false; }
    }

    private async Task SubmitAsync()
    {
        if (!_submitConfirmed || _review?.ApprovalReference is null || _submitting || _submission is not null) return;
        _submitting = true;
        _error = null;
        try
        {
            await JavaScript.InvokeVoidAsync("taxHubHmrc.captureClientFacts");
            _submission = await Submissions.SubmitAsync(_review.ApprovalReference);
        }
        catch (VatReturnReviewException exception) { _error = exception.Message; }
        catch (UnauthorizedAccessException exception) { _error = exception.Message; }
        catch { _error = "The VAT return could not be submitted safely. Consult the Event Log."; }
        finally { _submitting = false; }
    }

    private static string SubmissionClass(VatSubmissionResultState state) => state switch
    {
        VatSubmissionResultState.Accepted => "alert-success",
        VatSubmissionResultState.Rejected => "alert-danger",
        VatSubmissionResultState.OutcomeUnknown => "alert-warning",
        _ => "alert-secondary"
    };

    private static string SubmissionTitle(VatSubmissionResultState state) => state switch
    {
        VatSubmissionResultState.Accepted => "Accepted by HMRC",
        VatSubmissionResultState.Rejected => "Rejected by HMRC",
        VatSubmissionResultState.OutcomeUnknown => "Submission outcome unknown",
        _ => "Return not sent"
    };

    private static string SubmissionMessage(VatSubmissionResult result) =>
        VatAuthorityUserMessages.Submission(result);

    private static string ReadbackText(VatSubmissionResult result) => result.ReadbackMatches switch
    {
        true => "Exact match confirmed",
        false => "Mismatch requires investigation",
        null => $"Pending ({result.ReadbackOutcomeCode ?? "not yet available"})"
    };

    private static string FindingClass(string severity) => severity.Equals("Error", StringComparison.OrdinalIgnoreCase)
        ? "alert-danger" : severity.Equals("Warning", StringComparison.OrdinalIgnoreCase)
            ? "alert-warning" : "alert-info";
}
