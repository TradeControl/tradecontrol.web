@using MudBlazor
@using TradeControl.Web.Pages.Tax.Hub.Models

@if (Dashboard is null)
{
    <div class="text-muted">No dashboard data available.</div>
}
else
{
    <div class="tc-tax-hub-dashboard d-flex flex-column gap-3">
        <section>
            <div class="d-flex flex-wrap align-items-center gap-2 mb-2">
                @if (!string.IsNullOrWhiteSpace(Dashboard.BusinessType))
                {
                    <span class="badge rounded-pill text-bg-secondary tc-tax-hub-badge">@Dashboard.BusinessType</span>
                }

                @if (Dashboard.ActiveRegimes.Count == 0)
                {
                    <span class="text-muted small">No active tax regimes</span>
                }
            </div>

            <div class="d-flex flex-wrap gap-2">
                @foreach (var regime in Dashboard.ActiveRegimes)
                {
                    <span class="badge rounded-pill text-bg-primary tc-tax-hub-badge">@regime</span>
                }
            </div>
        </section>

        <section>
            <div class="row g-2">
                @foreach (var card in Dashboard.Cards)
                {
                    <div class="col-12 col-md-4">
                        <div class="card h-100 tc-tax-hub-summary-card">
                            <div class="card-body py-3">
                                <div class="d-flex align-items-start justify-content-between gap-2 mb-2">
                                    <div>
                                        <h3 class="h6 mb-1">@card.Title</h3>
                                        <div class="text-muted small">@card.Subtitle</div>
                                    </div>

                                    <span class="badge text-bg-light border">@card.Status</span>
                                </div>

                                <div class="tc-tax-hub-card-value">@card.PrimaryValue</div>
                                <div class="text-muted small">@card.SecondaryValue</div>
                                <p class="mt-2 mb-0 text-muted small">@card.Detail</p>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </section>

        <section>
            <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-2">
                <div>
                    <h2 class="h5 mb-0">Payload Audit</h2>
                    <div class="text-muted small">Aggregate integrity check comparing raw P&amp;L values with submission payload totals</div>
                </div>

                <MudChip T="string"
                         Variant="Variant.Filled"
                         Color="@GetAuditColour(Dashboard.PayloadAudit.Status)"
                         Size="Size.Small">
                    @Dashboard.PayloadAudit.Status
                </MudChip>
            </div>

            <div class="row g-2">
                <div class="col-12 col-md-4">
                    <div class="card h-100 tc-tax-hub-summary-card">
                        <div class="card-body py-3">
                            <div class="text-muted small mb-1">Audited Rows</div>
                            <div class="tc-tax-hub-card-value">@Dashboard.PayloadAudit.TotalRows</div>
                        </div>
                    </div>
                </div>

                <div class="col-12 col-md-4">
                    <div class="card h-100 tc-tax-hub-summary-card">
                        <div class="card-body py-3">
                            <div class="text-muted small mb-1">Rows With Difference</div>
                            <div class="tc-tax-hub-card-value">@Dashboard.PayloadAudit.ErrorRows</div>
                        </div>
                    </div>
                </div>

                <div class="col-12 col-md-4">
                    <div class="card h-100 tc-tax-hub-summary-card">
                        <div class="card-body py-3">
                            <div class="text-muted small mb-1">Net Difference</div>
                            <div class="tc-tax-hub-card-value">@Dashboard.PayloadAudit.TotalDifference.ToString("#,##0.00;(#,##0.00);-")</div>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <section>
            <div class="d-flex align-items-center justify-content-between mb-2">
                <h2 class="h5 mb-0">Upcoming Obligations</h2>
                <span class="text-muted small">@Dashboard.Obligations.Count item(s)</span>
            </div>

            @if (Dashboard.Obligations.Count == 0)
            {
                <div class="alert alert-secondary mb-0">
                    No filing or payment obligations are currently available.
                </div>
            }
            else
            {
                <TaxHubObligationsGrid Items="@Dashboard.Obligations" />
            }
        </section>
    </div>
}

@code {
    [Parameter] public TaxHubDashboardModel? Dashboard { get; set; }
    [Parameter] public bool IsMobile { get; set; }

    private static Color GetAuditColour(string status)
    {
        return status switch
        {
            "FAIL" => Color.Error,
            "WARN" => Color.Warning,
            "PASS" => Color.Success,
            _ => Color.Default
        };
    }
}
