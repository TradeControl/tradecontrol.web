@page
@model IndexModel
@inject Wangkanai.Detection.Services.IDetectionService Detection
@using Wangkanai.Detection.Models

@{
    ViewData["Title"] = "Trade Control";
}

@if (Model.IsDatabaseMaintenanceActive)
{
    <div class="mt-5 tc-align-header">
        <div class="tc-section">
            <div class="alert alert-warning" role="alert">
                <div class="fw-semibold mb-2">Synthetic dataset installation in progress</div>
                <div>@Model.DatabaseMaintenanceMessage</div>
                @if (!string.IsNullOrWhiteSpace(Model.MaintenanceExecutionCode))
                {
                    <div class="mt-2 small text-muted">Execution Code: @Model.MaintenanceExecutionCode</div>
                }
            </div>
        </div>
    </div>
}
else
{
    <div class="mt-5 tc-align-header">
        <div class="tc-section">
            <dl class="row">
                <dt class="col-sm-2">
                    @Html.DisplayNameFor(model => model.App_Identity.SubjectName)
                </dt>
                <dd class="col-sm-10">
                    <a href=@Model.App_Identity.WebSite>@Html.DisplayFor(model => model.App_Identity.SubjectName)</a>
                </dd>
                <dt class="col-sm-2">
                    @Html.DisplayNameFor(model => model.CurrentPeriod)
                </dt>
                <dd class="col-sm-10">
                    @Html.DisplayFor(model => model.CurrentPeriod)
                </dd>
                <dt class="col-sm-2">
                    @Html.DisplayNameFor(model => model.App_Identity.EmailAddress)
                </dt>
                <dd class="col-sm-10">
                    @Html.DisplayFor(model => model.App_Identity.EmailAddress)
                </dd>
                <dt class="col-sm-2">
                    @Html.DisplayNameFor(model => model.App_Identity.PhoneNumber)
                </dt>
                <dd class="col-sm-10">
                    @Html.DisplayFor(model => model.App_Identity.PhoneNumber)
                </dd>
                <dt class="col-sm-2">
                    @Html.DisplayNameFor(model => model.WebVersion)
                </dt>
                <dd class="col-sm-10">
                    @Html.DisplayFor(model => model.WebVersion)
                </dd>
                <dt class="col-sm-2">
                    @Html.DisplayNameFor(model => model.SqlNodeVersion)
                </dt>
                <dd class="col-sm-10">
                    @Html.DisplayFor(model => model.SqlNodeVersion)
                </dd>
                <dt class="col-sm-2">
                    On-line Help
                </dt>
                <dd class="col-sm-10">
                    <a href="https://tradecontrol.github.io">Technical Documentation</a>
                </dd>
            </dl>
        </div>
    </div>
}
