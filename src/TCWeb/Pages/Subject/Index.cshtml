@page
@model TradeControl.Web.Pages.Subject.IndexModel

@{
    ViewData["Title"] = "Subject Search";
}

<div class="row justify-content-center">
    <div class="col-12 col-xl-8">
        <div class="card shadow-sm border-0">
            <div class="card-body p-4">
                <h1 class="h3 mb-3">@ViewData["Title"]</h1>
                <p class="text-muted mb-4">
                    Search the namespace, then continue into the Subject Browser.
                </p>

                <form method="get" asp-page="/Subject/Browser/Index" class="row g-3">
                    <div class="col-12">
                        <label asp-for="NamespaceFilter" class="form-label"></label>
                        <input asp-for="NamespaceFilter"
                               class="form-control"
                               placeholder="Filter namespace…"
                               autocomplete="off" />
                    </div>

                    <div class="col-12 d-flex flex-wrap gap-2">
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-diagram-3 me-1" aria-hidden="true"></i>Open Subject Browser
                        </button>

                        <a asp-page="/Subject/Browser/Index" class="btn btn-outline-secondary">
                            <i class="bi bi-list-nested me-1" aria-hidden="true"></i>Browse All
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
