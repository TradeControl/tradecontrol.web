@page
@inject Wangkanai.Detection.Services.IDetectionService Detection
@using Wangkanai.Detection.Models
@model TradeControl.Web.Pages.Subject.Reports.DebtorsAndCreditorsModel

@{
    ViewData["Title"] = "Debtors and Creditors";
    var isMobile = Detection?.Device?.Type == Device.Mobile;
}

<h1>@ViewData["Title"]</h1>

<form class="mb-3" method="get">
    <div class="row g-2 align-items-center">
        <div class="col-auto">
            <select asp-for="PeriodName" asp-items="Model.PeriodNames" class="form-control"></select>
        </div>

        <div class="col-auto">
            <select asp-for="AssetType" asp-items="Model.AssetTypes" class="form-control">
                <option value="">All</option>
            </select>
        </div>

        <div class="col-auto">
            <input type="hidden" name="PageNumber" value="1" />
            <select asp-for="PageSize"
                    asp-items="Model.PageSizeOptions"
                    class="form-control"
                    aria-label="Rows per page"
                    onchange="this.form.submit()"></select>
            <noscript>
                <button type="submit" class="btn btn-sm btn-outline-secondary ms-2">Apply</button>
            </noscript>
        </div>

        <div class="col-auto">
            <input type="submit" value="Filter" class="btn btn-primary" />
        </div>
    </div>
</form>

@if (Model.Subject_BalanceSheetAudit.Count == 0)
{
    <div class="alert alert-info mb-0">
        No debtors or creditors were found for the selected scope.
    </div>
}
else
{
    <table class="table table-striped">
        <thead>
            <tr>
                @if (!isMobile)
                {
                    <th>Financial Year</th>
                    <th>Month</th>
                    <th>Asset Type</th>
                }
                <th>Subject</th>
                @if (!isMobile)
                {
                    <th>Namespace</th>
                    <th>Subject Type</th>
                }
                <th>Balance</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.Subject_BalanceSheetAudit)
            {
                <tr>
                    @if (!isMobile)
                    {
                        <td>@item.Description</td>
                        <td>@item.MonthName</td>
                        <td>@item.AssetType</td>
                    }

                    <td>
                        <div>@item.SubjectName</div>
                        @if (isMobile)
                        {
                            <div class="small text-muted">
                                @if (!string.IsNullOrWhiteSpace(item.ParentSubjectName))
                                {
                                    <span>@item.ParentSubjectName</span>
                                    @if (!string.IsNullOrWhiteSpace(item.ParentSubjectCode))
                                    {
                                        <span> (<code>@item.ParentSubjectCode</code>)</span>
                                    }
                                }
                                else if (!string.IsNullOrWhiteSpace(item.ParentSubjectCode))
                                {
                                    <code>@item.ParentSubjectCode</code>
                                }
                                else
                                {
                                    <span>Root</span>
                                }
                            </div>
                        }
                    </td>

                    @if (!isMobile)
                    {
                        <td>
                            @if (!string.IsNullOrWhiteSpace(item.ParentSubjectName))
                            {
                                <div>@item.ParentSubjectName</div>
                                @if (!string.IsNullOrWhiteSpace(item.ParentSubjectCode))
                                {
                                    <div class="small text-muted"><code>@item.ParentSubjectCode</code></div>
                                }
                            }
                            else if (!string.IsNullOrWhiteSpace(item.ParentSubjectCode))
                            {
                                <code>@item.ParentSubjectCode</code>
                            }
                            else
                            {
                                <span class="text-muted">Root</span>
                            }
                        </td>
                        <td>@item.SubjectType</td>
                    }

                    <td>@Html.DisplayFor(modelItem => item.Balance)</td>
                    <td>
                        <div class="action-buttons">
                            <a class="btn btn-info"
                               asp-page="../Enquiry/Details"
                               asp-route-accountCode="@item.SubjectCode"
                               title="Details">
                                <i class="bi bi-info-circle" aria-hidden="true"></i>
                                <span class="visually-hidden">Details</span>
                            </a>
                            <a class="btn btn-warning"
                               asp-page="../Enquiry/Invoices"
                               asp-route-accountCode="@item.SubjectCode"
                               title="View invoices">
                                <i class="bi bi-list" aria-hidden="true"></i>
                                <span class="visually-hidden">Invoices</span>
                            </a>
                            <a class="btn btn-success"
                               asp-page="../Enquiry/Payments"
                               asp-route-accountCode="@item.SubjectCode"
                               title="View payments">
                                <i class="bi bi-currency-dollar" aria-hidden="true"></i>
                                <span class="visually-hidden">Payments</span>
                            </a>
                            <a class="btn btn-dark"
                               asp-page="../Enquiry/Statement"
                               asp-route-accountCode="@item.SubjectCode"
                               title="View statement">
                                <i class="bi bi-list" aria-hidden="true"></i>
                                <span class="visually-hidden">Statement</span>
                            </a>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@if (Model.TotalPages > 1)
{
    <nav aria-label="Page navigation" class="mt-3">
        <ul class="pagination">
            <li class="page-item @(Model.PageNumber == 1 ? "disabled" : "")">
                <a class="page-link"
                   asp-page="./DebtorsAndCreditors"
                   asp-route-PeriodName="@Model.PeriodName"
                   asp-route-AssetType="@Model.AssetType"
                   asp-route-PageSize="@Model.PageSize"
                   asp-route-PageNumber="@(Model.PageNumber - 1)">Previous</a>
            </li>

            @for (var i = 1; i <= Model.TotalPages; i++)
            {
                <li class="page-item @(i == Model.PageNumber ? "active" : "")"
                    aria-current="@(i == Model.PageNumber ? "page" : null)">
                    <a class="page-link"
                       asp-page="./DebtorsAndCreditors"
                       asp-route-PeriodName="@Model.PeriodName"
                       asp-route-AssetType="@Model.AssetType"
                       asp-route-PageSize="@Model.PageSize"
                       asp-route-PageNumber="@i">@i</a>
                </li>
            }

            <li class="page-item @(Model.PageNumber == Model.TotalPages ? "disabled" : "")">
                <a class="page-link"
                   asp-page="./DebtorsAndCreditors"
                   asp-route-PeriodName="@Model.PeriodName"
                   asp-route-AssetType="@Model.AssetType"
                   asp-route-PageSize="@Model.PageSize"
                   asp-route-PageNumber="@(Model.PageNumber + 1)">Next</a>
            </li>
        </ul>
    </nav>
}
