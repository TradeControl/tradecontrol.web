@using TradeControl.Web.Pages.Shared.Tree

<TreeBranch IsRoot="@IsRoot"
            RootNodes="@RootNodes"
            Node="@Node"
            GetChildren="@GetChildren"
            OnLeafSelected="@OnLeafSelected"
            SelectedKey="@SelectedKey"
            ExpandToKey="@ExpandToKey"
            OnNodeSelected="@OnNodeSelected"
            RefreshToken="@RefreshToken"
            CanDrag="@CanDrag"
            CanDrop="@CanDrop"
            DraggedKey="@DraggedKey"
            DropTargetKey="@DropTargetKey"
            OnDragStarted="@OnDragStarted"
            OnDragEnded="@OnDragEnded"
            OnNodeDropped="@OnNodeDropped"
            IsMobile="@IsMobile"
            OnNodeContextMenu="@OnNodeContextMenu" />

@code {
    [Parameter] public bool IsRoot { get; set; }
    [Parameter] public IReadOnlyList<TreeNode> RootNodes { get; set; } = Array.Empty<TreeNode>();
    [Parameter] public TreeNode? Node { get; set; }
    [Parameter] public Func<TreeNode, Task<IReadOnlyList<TreeNode>>> GetChildren { get; set; } = default!;
    [Parameter] public EventCallback<TreeNode> OnLeafSelected { get; set; }
    [Parameter] public EventCallback<TreeNode> OnNodeSelected { get; set; }
    [Parameter] public string? SelectedKey { get; set; }
    [Parameter] public string? ExpandToKey { get; set; }
    [Parameter] public long RefreshToken { get; set; }

    [Parameter] public Func<TreeNode, bool>? CanDrag { get; set; }
    [Parameter] public Func<TreeNode, bool>? CanDrop { get; set; }
    [Parameter] public string? DraggedKey { get; set; }
    [Parameter] public string? DropTargetKey { get; set; }
    [Parameter] public EventCallback<TreeNode> OnDragStarted { get; set; }
    [Parameter] public EventCallback OnDragEnded { get; set; }
    [Parameter] public EventCallback<DropInfo> OnNodeDropped { get; set; }

    [Parameter] public bool IsMobile { get; set; }
    [Parameter] public EventCallback<TreeContextMenuRequest> OnNodeContextMenu { get; set; }
}
