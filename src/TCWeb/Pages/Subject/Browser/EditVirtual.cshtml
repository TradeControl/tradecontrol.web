@page "/Subject/Browser/EditVirtual"
@model TradeControl.Web.Pages.Subject.Browser.EditVirtualModel
@{
    if (Model.IsEmbedded == "1")
    {
        Layout = "/Pages/Shared/_EmbeddedLayout.cshtml";
    }
}

@if (Model.IsEmbedded == "1" && !string.IsNullOrWhiteSpace(Model.Done))
{
    <div class="alert alert-success py-2 mb-0">Returning to Subject Browser…</div>

    <script>
        window.parent.postMessage(
        {
            type: "tc-subject-browser-close",
            action: "@Model.Done",
            returnNode: "@Model.ReturnNode",
            subjectCode: "@Model.SubjectCode"
        }, window.location.origin);
    </script>
}
else
{
    <div class="container-fluid py-2">
        <div class="card shadow-sm border-0">
            <div class="card-body p-4">
                <div class="d-flex flex-wrap align-items-start justify-content-between gap-3 mb-4">
                    <div>
                        <h1 class="h4 mb-1">Edit Organisation</h1>
                        <div class="text-muted small">Update shared subject fields and organisation-specific details.</div>
                    </div>

                    <div class="text-muted small text-end">
                        <div>Subject Code</div>
                        <div><code>@Model.SubjectCode</code></div>
                    </div>
                </div>

                <form method="post">
                    <input type="hidden" asp-for="SubjectCode" />
                    <input type="hidden" asp-for="ReturnNode" />
                    <input type="hidden" asp-for="IsEmbedded" />

                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 mb-4"></div>

                    <div class="rounded border overflow-hidden mb-4">
                        <div class="px-3 py-2 text-bg-primary fw-semibold">Identity</div>
                        <div class="bg-white p-3">
                            <div class="row g-3">
                                <div class="col-lg-6">
                                    <label class="form-label" for="SubjectName">Account Name</label>
                                    <input asp-for="SubjectName" class="form-control" />
                                    <span asp-validation-for="SubjectName" class="text-danger small"></span>
                                </div>
                                <div class="col-lg-3">
                                    <label class="form-label" for="SubjectTypeCode">Type</label>
                                    <select asp-for="SubjectTypeCode" asp-items="Model.SubjectTypeOptions" class="form-select"></select>
                                    <span asp-validation-for="SubjectTypeCode" class="text-danger small"></span>
                                </div>
                                <div class="col-lg-3">
                                    <label class="form-label" for="SubjectStatusCode">Status</label>
                                    <select asp-for="SubjectStatusCode" asp-items="Model.SubjectStatusOptions" class="form-select"></select>
                                </div>
                                <div class="col-lg-4">
                                    <label class="form-label" for="CompanyNumber">Company Number</label>
                                    <input asp-for="CompanyNumber" class="form-control" />
                                </div>
                                <div class="col-lg-4">
                                    <label class="form-label" for="VatNumber">Vat Number</label>
                                    <input asp-for="VatNumber" class="form-control" />
                                </div>
                                <div class="col-lg-4">
                                    <label class="form-label" for="NumberOfEmployees">Employees</label>
                                    <input asp-for="NumberOfEmployees" class="form-control" />
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="rounded border overflow-hidden mb-4">
                        <div class="px-3 py-2 text-bg-info fw-semibold">Contact</div>
                        <div class="bg-white p-3">
                            <div class="row g-3">
                                <div class="col-lg-6">
                                    <label class="form-label" for="SubjectPhoneNumber">Main Phone</label>
                                    <input asp-for="SubjectPhoneNumber" class="form-control" />
                                </div>
                                <div class="col-lg-6">
                                    <label class="form-label" for="SubjectEmailAddress">Main Email</label>
                                    <input asp-for="SubjectEmailAddress" class="form-control" />
                                </div>
                                <div class="col-lg-6">
                                    <label class="form-label" for="WebSite">Web Site</label>
                                    <input asp-for="WebSite" class="form-control" />
                                </div>
                                <div class="col-lg-6">
                                    <label class="form-label" for="AreaCode">Area</label>
                                    <input asp-for="AreaCode" class="form-control" list="virtual-area-options" />
                                    <datalist id="virtual-area-options">
                                        @foreach (var option in Model.AreaCodeOptions)
                                        {
                                            <option value="@option"></option>
                                        }
                                    </datalist>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="rounded border overflow-hidden mb-4">
                        <div class="px-3 py-2 text-bg-success fw-semibold">Billing and Terms</div>
                        <div class="bg-white p-3">
                            <div class="row g-3">
                                <div class="col-lg-3">
                                    <label class="form-label" for="TaxCode">Tax Code</label>
                                    <select asp-for="TaxCode" asp-items="Model.TaxCodeOptions" class="form-select">
                                        <option value="">Select tax code</option>
                                    </select>
                                </div>
                                <div class="col-lg-5">
                                    <label class="form-label" for="PaymentTerms">Payment Terms</label>
                                    <input asp-for="PaymentTerms" class="form-control" list="virtual-payment-options" />
                                    <datalist id="virtual-payment-options">
                                        @foreach (var option in Model.PaymentTermOptions)
                                        {
                                            <option value="@option"></option>
                                        }
                                    </datalist>
                                </div>
                                <div class="col-lg-2">
                                    <label class="form-label" for="ExpectedDays">Expected Days</label>
                                    <input asp-for="ExpectedDays" class="form-control" />
                                </div>
                                <div class="col-lg-2">
                                    <label class="form-label" for="PaymentDays">Payment Days</label>
                                    <input asp-for="PaymentDays" class="form-control" />
                                </div>
                                <div class="col-lg-3 d-flex align-items-end">
                                    <div class="form-check">
                                        <input asp-for="PayDaysFromMonthEnd" class="form-check-input" />
                                        <label asp-for="PayDaysFromMonthEnd" class="form-check-label">Days From M/E</label>
                                    </div>
                                </div>
                                <div class="col-lg-3 d-flex align-items-end">
                                    <div class="form-check">
                                        <input asp-for="PayBalance" class="form-check-input" />
                                        <label asp-for="PayBalance" class="form-check-label">Pay Balance?</label>
                                    </div>
                                </div>
                                <div class="col-lg-3 d-flex align-items-end">
                                    <div class="form-check">
                                        <input asp-for="Eujurisdiction" class="form-check-input" />
                                        <label asp-for="Eujurisdiction" class="form-check-label">EU?</label>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="rounded border overflow-hidden mb-4">
                        <div class="px-3 py-2 text-bg-secondary fw-semibold">Organisation</div>
                        <div class="bg-white p-3">
                            <div class="row g-3">
                                <div class="col-lg-4">
                                    <label class="form-label" for="Turnover">Turnover</label>
                                    <input asp-for="Turnover" class="form-control" />
                                </div>
                                <div class="col-lg-8">
                                    <label class="form-label" for="SubjectSource">Source</label>
                                    <input asp-for="SubjectSource" class="form-control" list="virtual-source-options" />
                                    <datalist id="virtual-source-options">
                                        @foreach (var option in Model.SubjectSourceOptions)
                                        {
                                            <option value="@option"></option>
                                        }
                                    </datalist>
                                </div>
                                <div class="col-12">
                                    <label class="form-label" for="BusinessDescription">Description</label>
                                    <textarea asp-for="BusinessDescription" class="form-control" rows="6"></textarea>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="d-flex flex-wrap gap-2">
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-floppy me-1" aria-hidden="true"></i>Save
                        </button>

                        @if (Model.IsEmbedded == "1")
                        {
                            <button type="button"
                                    class="btn btn-outline-secondary"
                                    onclick='window.parent.postMessage({ type: "tc-subject-browser-close", action: "cancel", returnNode: "@Model.ReturnNode", subjectCode: "@Model.SubjectCode" }, window.location.origin);'>
                                Cancel
                            </button>
                        }
                        else
                        {
                            <a asp-page="/Subject/Browser/Index"
                               asp-route-mode="Subject"
                               asp-route-select="@(string.IsNullOrWhiteSpace(Model.ReturnNode) ? Model.SubjectCode : Model.ReturnNode)"
                               class="btn btn-outline-secondary">
                                Cancel
                            </a>
                        }
                    </div>
                </form>
            </div>
        </div>
    </div>
}
