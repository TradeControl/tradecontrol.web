    private sealed record ContextMenuState
    {
        public bool IsOpen { get; init; }
        public string? NodeKey { get; init; }
        public int X { get; init; }
        public int Y { get; init; }
    }

    private async Task ExecuteTreeAddExistingAsync(
        string childSubjectCode,
        string targetParentBranchKey,
        string targetParentSubjectCode)
    {
        var subject = new Subjects(NodeContext, childSubjectCode);

        var preview = await subject.PreviewAddToNamespaceAsync(targetParentSubjectCode);
        if (!preview.CanProceed)
        {
            await SetActionMessageAsync(preview.Message, "alert-warning");
            return;
        }

        var result = await subject.AddToNamespaceAsync(targetParentSubjectCode);
        if (!result.Succeeded)
        {
            await SetActionMessageAsync(result.Message, "alert-warning");
            return;
        }

        SubjectBrowserService.InvalidateSnapshot();

        _childPageNumbers.Remove(targetParentBranchKey);
        _refreshToken++;

        var selectionKey = $"{targetParentBranchKey}.{childSubjectCode}";
        _selectedBranchKey = selectionKey;
        _expandToKey = BuildExpandPath(selectionKey);
        await LoadDetailFromKeyAsync(selectionKey);
        await SetActionMessageAsync(result.Message, "alert-success");
    }

    private async Task ExecuteTreeMoveAsync(
        string sourceKey,
        string sourceSubjectCode,
        string currentParentSubjectCode,
        string targetParentBranchKey,
        string targetParentSubjectCode)
    {
        var subject = new Subjects(NodeContext, sourceSubjectCode);

        var preview = await subject.PreviewReparentAsync(currentParentSubjectCode, targetParentSubjectCode);
        if (!preview.CanProceed)
        {
            await SetActionMessageAsync(preview.Message, "alert-warning");
            return;
        }

        var result = await subject.ReparentAsync(currentParentSubjectCode, targetParentSubjectCode);
        if (!result.Succeeded)
        {
            await SetActionMessageAsync(result.Message, "alert-warning");
            return;
        }

        SubjectBrowserService.InvalidateSnapshot();

        var oldParentBranchKey = BuildParentBranchKey(sourceKey);

        if (!string.IsNullOrWhiteSpace(oldParentBranchKey))
        {
            _childPageNumbers.Remove(oldParentBranchKey);
        }

        _childPageNumbers.Remove(targetParentBranchKey);
        _refreshToken++;

        var selectionKey = $"{targetParentBranchKey}.{sourceSubjectCode}";
        _selectedBranchKey = selectionKey;
        _expandToKey = BuildExpandPath(selectionKey);
        await LoadDetailFromKeyAsync(selectionKey);
        await SetActionMessageAsync(result.Message, "alert-success");
    }

    private RenderFragment RenderDetailPane() =>
