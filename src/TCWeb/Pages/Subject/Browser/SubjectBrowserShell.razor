    private async Task ConfirmMoveAsync()
    {
        if (_selectedDetail is null)
            return;

        var currentSelectionKey = _selectedBranchKey;
        var currentParentSubjectCode = GetSelectedParentSubjectCode();
        _resolvedMoveTargetPath = ResolveMoveTargetPath(_pendingMoveTargetPath);
        var newParentSubjectCode = ExtractSubjectCode(_resolvedMoveTargetPath);

        if (string.IsNullOrWhiteSpace(currentParentSubjectCode) || string.IsNullOrWhiteSpace(newParentSubjectCode))
        {
            _pendingReparentPlan = new SubjectReparentPlan
            {
                ActionCode = NodeEnum.ActionCode.Blocked,
                CanProceed = false,
                Message = "A target namespace is required."
            };

            await InvokeAsync(StateHasChanged);
            return;
        }

        try
        {
            _isReparenting = true;

            var subject = new Subjects(NodeContext, _selectedDetail.SubjectCode);

            var preview = await subject.PreviewReparentAsync(currentParentSubjectCode, newParentSubjectCode);
            _pendingReparentPlan = preview;

            if (!preview.CanProceed)
            {
                return;
            }

            var result = await subject.ReparentAsync(currentParentSubjectCode, newParentSubjectCode);

            if (!result.Succeeded)
            {
                _pendingReparentPlan = preview with
                {
                    CanProceed = false,
                    Message = result.Message
                };
                return;
            }

            SubjectBrowserService.InvalidateSnapshot();

            var movedSubjectCode = _selectedDetail.SubjectCode;
            var oldParentBranchKey = BuildParentBranchKey(currentSelectionKey);
            var newParentBranchKey = _resolvedMoveTargetPath;
            var newSelectionKey = string.IsNullOrWhiteSpace(newParentBranchKey)
                ? movedSubjectCode
                : $"{newParentBranchKey}.{movedSubjectCode}";

            ClearMoveState();

            if (!string.IsNullOrWhiteSpace(oldParentBranchKey))
            {
                _childPageNumbers.Remove(oldParentBranchKey);
            }

            if (!string.IsNullOrWhiteSpace(newParentBranchKey))
            {
                _childPageNumbers.Remove(newParentBranchKey);
            }

            _refreshToken++;
            _selectedBranchKey = newSelectionKey;
            _expandToKey = BuildExpandPath(newSelectionKey);
            await LoadDetailFromKeyAsync(newSelectionKey);
            await SetActionMessageAsync(result.Message, "alert-success");
        }
        finally
        {
            _isReparenting = false;
            await InvokeAsync(StateHasChanged);
        }
    }

