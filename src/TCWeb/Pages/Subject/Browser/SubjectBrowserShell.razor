            NodeEnum.SubjectClass.Structural => "Create a structural child under the selected parent.",
            NodeEnum.SubjectClass.Real => "Create a real Subject under the selected parent.",
            NodeEnum.SubjectClass.Virtual => "Create a virtual Subject under the selected parent.",
            _ => "Create a child under the selected parent."
        };
    }

    private string GetPendingCreateNameLabel()
    {
        return _pendingCreateSubjectClass switch
        {
            NodeEnum.SubjectClass.Structural => "Structural Name",
            NodeEnum.SubjectClass.Real => "Person Name",
            NodeEnum.SubjectClass.Virtual => "Organisation Name",
            _ => "Name"
        };
    }

    private static IReadOnlyList<SubjectBrowserAction> CreateNamespaceMobileShortcutActions(IReadOnlyList<SubjectBrowserAction> actions)
    {
        var shortcuts = new List<SubjectBrowserAction>();

        var defaultAction = actions.FirstOrDefault(action => action.Id == "default");
        if (defaultAction is not null)
        {
            shortcuts.Add(defaultAction);
        }

        var removeAction = actions.FirstOrDefault(action => action.Id == "remove");
        if (removeAction is not null)
        {
            shortcuts.Add(removeAction);
        }

        return shortcuts.Take(2).ToArray();
    }

    private IReadOnlyList<SubjectBrowserAction> CreateSubjectActions()
    {
        if (_selectedDetail is null)
            return Array.Empty<SubjectBrowserAction>();

        var supportsSubjectEditing = _selectedDetail.SubjectClass is NodeEnum.SubjectClass.Real
            or NodeEnum.SubjectClass.Virtual
            or NodeEnum.SubjectClass.Structural;

        var supportsAddressMaintenance = _selectedDetail.SubjectClass is NodeEnum.SubjectClass.Real
            or NodeEnum.SubjectClass.Virtual;

        return
        [
            CreateShellAction(
                "edit",
                "Edit",
                "bi-pencil-square",
                BeginEditSubjectAsync,
                isEnabled: supportsSubjectEditing),

            CreateShellAction(
                "add-address",
                "Add Address",
                "bi-geo-alt",
                BeginAddAddressAsync,
                isEnabled: supportsAddressMaintenance),

            CreateShellAction(
                "delete",
                "Delete",
                "bi-trash",
                BeginDeleteSubjectAsync,
                buttonCssClass: "btn btn-outline-danger btn-sm",
                isEnabled: supportsSubjectEditing)
        ];
    }

    private SubjectBrowserAction CreateSubjectsAction(
        string id,
        string text,
        string iconClass,
        Func<Subjects, Task<SubjectActionResult>> executeAsync,
        string buttonCssClass = "btn btn-outline-primary btn-sm",
        bool isEnabled = true)
    {
        return new SubjectBrowserAction(
            id,
            text,
            iconClass,
            buttonCssClass,
            isEnabled && _selectedDetail is not null,
            () => ExecuteSubjectsActionAsync(id, executeAsync));
    }

    private async Task ExecuteSubjectsActionAsync(
        string actionId,
        Func<Subjects, Task<SubjectActionResult>> executeAsync)
    {
        if (_selectedDetail is null)
            return;

        try
        {
            var currentSelectionKey = _selectedBranchKey;
            var subject = new Subjects(NodeContext, _selectedDetail.SubjectCode);
            var result = await executeAsync(subject);

            if (result.Succeeded)
            {
                SubjectBrowserService.InvalidateSnapshot();

                var nextSelectionKey = ResolvePostActionSelectionKey(actionId, currentSelectionKey);

                await RefreshBrowserAfterActionAsync(
                    actionId,
                    currentSelectionKey,
                    nextSelectionKey);
            }

            await SetActionMessageAsync(result.Message, result.Succeeded ? "alert-success" : "alert-warning");
        }
        catch (Exception ex)
        {
            await SetActionMessageAsync(ex.Message, "alert-danger");
        }
    }

    private string? ResolvePostActionSelectionKey(string actionId, string? currentSelectionKey)
    {
        if (string.IsNullOrWhiteSpace(currentSelectionKey))
            return null;

        return string.Equals(actionId, "remove", StringComparison.OrdinalIgnoreCase)
            ? BuildParentBranchKey(currentSelectionKey)
            : currentSelectionKey;
    }

    private async Task RefreshBrowserAfterActionAsync(
        string actionId,
        string? currentSelectionKey,
        string? selectionKey)
    {
        if (string.Equals(actionId, "default", StringComparison.OrdinalIgnoreCase)
            || string.Equals(actionId, "remove", StringComparison.OrdinalIgnoreCase))
        {
            var parentBranchKey = BuildParentBranchKey(currentSelectionKey);

            if (!string.IsNullOrWhiteSpace(parentBranchKey))
            {
                _childPageNumbers.Remove(parentBranchKey);
            }

            _refreshToken++;

            if (string.IsNullOrWhiteSpace(selectionKey))
            {
                _selectedBranchKey = null;
                _selectedDetail = null;
                _expandToKey = null;
                UpdateBrowserUrl();
                await InvokeAsync(StateHasChanged);
                return;
            }

            _selectedBranchKey = selectionKey;
            _expandToKey = BuildExpandPath(selectionKey);
            await LoadDetailFromKeyAsync(selectionKey);
            UpdateBrowserUrl();
            await InvokeAsync(StateHasChanged);
            return;
        }

        _rootPageNumber = 1;
        _childPageNumbers.Clear();

        await LoadRootsAsync();

        if (string.IsNullOrWhiteSpace(selectionKey))
        {
            _selectedBranchKey = null;
            _selectedDetail = null;
            _expandToKey = null;
            UpdateBrowserUrl();
            await InvokeAsync(StateHasChanged);
            return;
        }

        _selectedBranchKey = selectionKey;
        _expandToKey = BuildExpandPath(selectionKey);
        await LoadDetailFromKeyAsync(selectionKey);
        UpdateBrowserUrl();
        await InvokeAsync(StateHasChanged);
    }

    private static string? BuildParentBranchKey(string? key)
    {
        if (string.IsNullOrWhiteSpace(key))
            return null;

        var index = key.LastIndexOf(".", StringComparison.Ordinal);

        return index < 0
            ? null
            : key[..index];
    }

    private Task SetActionMessageAsync(string message, string cssClass)
    {
        _actionMessage = message;
        _actionMessageCssClass = cssClass;
        return InvokeAsync(StateHasChanged);
    }

    private void ClearActionMessage()
    {
        _actionMessage = null;
        _actionMessageCssClass = "alert-warning";
    }

    private string BuildUrl(
        bool embedded,
        string? selectKey = null,
        string? returnNodeKey = null,
        NodeEnum.SubjectClass? createClass = null,
        bool includeCreateState = false,
        bool removePreview = false,
        bool includeRemovePreviewState = false,
        bool movePanel = false,
        bool addExistingPanel = false)
    {
        var baseUrl = $"{NavigationManager.BaseUri.TrimEnd('/')}/Subject/Browser/Index";
        var query = new List<string>();

        if (embedded)
            query.Add("embedded=1");

        query.Add($"mode={Uri.EscapeDataString(GetModeQueryValue())}");

        if (_mode == SubjectBrowserMode.Enquiry && _activeEnquiryView != SubjectEnquiryView.None)
        {
            query.Add($"enquiry={Uri.EscapeDataString(_activeEnquiryView.ToString())}");
        }

        var effectiveCreateClass = includeCreateState
            ? _pendingCreateSubjectClass ?? createClass
            : createClass;

        if (_mode == SubjectBrowserMode.Namespace && effectiveCreateClass.HasValue)
        {
            query.Add($"create={Uri.EscapeDataString(effectiveCreateClass.Value.ToString())}");
        }

        var effectiveRemovePreview = includeRemovePreviewState
            ? _pendingRemovalPlan is not null
            : removePreview;

        if (effectiveRemovePreview)
        {
            query.Add("removePreview=1");
        }

        if (movePanel)
        {
            query.Add("move=1");
        }

        if (addExistingPanel)
        {
            query.Add("addExisting=1");
        }

        if (!string.IsNullOrWhiteSpace(selectKey))
            query.Add($"select={Uri.EscapeDataString(selectKey)}");

        if (!string.IsNullOrWhiteSpace(returnNodeKey))
            query.Add($"returnNode={Uri.EscapeDataString(returnNodeKey)}");

        if (!string.IsNullOrWhiteSpace(_appliedNamespaceFilter))
            query.Add($"namespaceFilter={Uri.EscapeDataString(_appliedNamespaceFilter)}");

        return query.Count == 0
            ? baseUrl
            : $"{baseUrl}?{string.Join("&", query)}";
    }

    private static bool TryParseEnquiryView(string? value, out SubjectEnquiryView enquiryView)
    {
        if (Enum.TryParse(value, ignoreCase: true, out enquiryView)
            && enquiryView != SubjectEnquiryView.None)
        {
            return true;
        }

        enquiryView = SubjectEnquiryView.None;
        return false;
    }

    private void UpdateBrowserUrl()
    {
        if (_isEmbedded)
            return;

        var targetUrl = BuildUrl(
            embedded: false,
            selectKey: _selectedBranchKey,
            createClass: _pendingCreateSubjectClass,
            includeCreateState: true,
            includeRemovePreviewState: true);

        var current = NavigationManager.ToAbsoluteUri(NavigationManager.Uri);
        var target = NavigationManager.ToAbsoluteUri(targetUrl);

        if (string.Equals(current.PathAndQuery, target.PathAndQuery, StringComparison.OrdinalIgnoreCase))
            return;

        NavigationManager.NavigateTo(targetUrl, replace: true);
    }

    private string GetModeQueryValue()
    {
        return _mode.ToString();
    }

    private static bool TryParseMode(string? value, out SubjectBrowserMode mode)
    {
        return Enum.TryParse(value, ignoreCase: true, out mode);
    }

    private Task NavigateBackAsync()
    {
        var returnNode = !string.IsNullOrWhiteSpace(_returnNodeKey)
            ? _returnNodeKey
            : _selectedBranchKey;

        NavigationManager.NavigateTo(
            BuildUrl(
                embedded: false,
                selectKey: returnNode),
            forceLoad: true);

        return Task.CompletedTask;
    }

    private string? GetSelectedParentSubjectCode()
    {
        return ExtractParentSubjectCode(_selectedBranchKey);
    }

    private static string ExtractSubjectCode(string key)
    {
        if (string.IsNullOrWhiteSpace(key))
            return string.Empty;

        var segments = key.Split('.', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
        return segments.Length == 0 ? key : segments[^1];
    }

    private static string? ExtractParentSubjectCode(string? key)
    {
        if (string.IsNullOrWhiteSpace(key))
            return null;

        var segments = key.Split('.', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);

        return segments.Length < 2
            ? null
            : segments[^2];
    }

    private static string BuildExpandPath(string key)
    {
        if (string.IsNullOrWhiteSpace(key))
            return string.Empty;

        var segments = key.Split('.', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);

        if (segments.Length == 0)
            return key;

        var path = segments[0];
        var expandKeys = new List<string> { path };

        for (var i = 1; i < segments.Length; i++)
        {
            path = $"{path}.{segments[i]}";
            expandKeys.Add(path);
        }

        return string.Join('|', expandKeys);
    }

    private static TreeNode CreateLoadMoreNode(string key)
    {
        return new TreeNode(key, "Load more…", "bi-three-dots", false);
    }

    private static string CreateRootLoadMoreKey() => "loadmore::root";

    private static string CreateChildLoadMoreKey(string parentBranchKey) => $"loadmore::child::{parentBranchKey}";

    private static bool TryParseChildLoadMoreKey(string key, out string parentBranchKey)
    {
        const string prefix = "loadmore::child::";

        if (key.StartsWith(prefix, StringComparison.OrdinalIgnoreCase))
        {
            parentBranchKey = key[prefix.Length..];
            return true;
        }

        parentBranchKey = string.Empty;
        return false;
    }

    private static bool IsLoadMoreNodeKey(string? key)
    {
        return !string.IsNullOrWhiteSpace(key)
            && key.StartsWith("loadmore::", StringComparison.OrdinalIgnoreCase);
    }

    private bool CanDragTreeNode(TreeNode node)
    {
        return !IsLoadMoreNodeKey(node.Key);
    }

    private bool CanDropTreeNode(TreeNode node)
    {
        return !IsLoadMoreNodeKey(node.Key);
    }

    private async Task HandleTreeDragStartedAsync(TreeNode node)
    {
        CloseContextMenu();
        _dragSourceKey = node.Key;
        _dropTargetKey = null;
        ClearActionMessage();
        await InvokeAsync(StateHasChanged);
    }

    private async Task HandleTreeDragEndedAsync()
    {
        _dragSourceKey = null;
        _dropTargetKey = null;
        await InvokeAsync(StateHasChanged);
    }

    private async Task HandleTreeNodeDroppedAsync(DropInfo dropInfo)
    {
        if (dropInfo.Node is null)
            return;

        if (string.IsNullOrWhiteSpace(_dragSourceKey) || IsLoadMoreNodeKey(dropInfo.Node.Key))
            return;

        var sourceKey = _dragSourceKey;
        _dropTargetKey = dropInfo.Node.Key;

        try
        {
            ClearActionMessage();
            ClearCreateState();
            ClearRemovalPreview();
            ClearMoveState();
            ClearAddExistingState();

            if (string.Equals(sourceKey, dropInfo.Node.Key, StringComparison.OrdinalIgnoreCase))
            {
                await SetActionMessageAsync("A Subject cannot be dropped onto itself.", "alert-warning");
                return;
            }

            var sourceSubjectCode = ExtractSubjectCode(sourceKey);
            var targetParentSubjectCode = ExtractSubjectCode(dropInfo.Node.Key);
            var currentParentSubjectCode = ExtractParentSubjectCode(sourceKey);

            if (string.IsNullOrWhiteSpace(sourceSubjectCode) || string.IsNullOrWhiteSpace(targetParentSubjectCode))
            {
                await SetActionMessageAsync("The drag/drop operation could not be resolved.", "alert-warning");
                return;
            }

            if (dropInfo.IsCtrlKey)
            {
                await ExecuteTreeAddExistingAsync(sourceSubjectCode, dropInfo.Node.Key, targetParentSubjectCode);
                return;
            }

            if (string.IsNullOrWhiteSpace(currentParentSubjectCode))
            {
                await ExecuteTreeAddExistingAsync(sourceSubjectCode, dropInfo.Node.Key, targetParentSubjectCode);
                return;
            }

            await ExecuteTreeMoveAsync(sourceKey, sourceSubjectCode, currentParentSubjectCode, dropInfo.Node.Key, targetParentSubjectCode);
        }
        finally
        {
            _dragSourceKey = null;
            _dropTargetKey = null;
            await InvokeAsync(StateHasChanged);
        }
    }

    [JSInvokable]
    public async Task HandleHostedPageClosed(string action, string returnNode, string subjectCode)
    {
        ClearHostedDetailPage();

        if (string.Equals(action, "save", StringComparison.OrdinalIgnoreCase)
            || string.Equals(action, "delete", StringComparison.OrdinalIgnoreCase))
        {
            SubjectBrowserService.InvalidateSnapshot();
            _refreshToken++;
        }

        if (string.Equals(action, "delete", StringComparison.OrdinalIgnoreCase)
            && string.IsNullOrWhiteSpace(returnNode))
        {
            _selectedBranchKey = null;
            _selectedDetail = null;
            await InvokeAsync(StateHasChanged);
            return;
        }

        var nextSelection = !string.IsNullOrWhiteSpace(returnNode)
            ? returnNode
            : (!string.IsNullOrWhiteSpace(_selectedBranchKey) ? _selectedBranchKey : subjectCode);

        if (!string.IsNullOrWhiteSpace(nextSelection))
        {
            await LoadDetailFromKeyAsync(nextSelection);
        }

        await InvokeAsync(StateHasChanged);
    }

    private async Task HandleNodeContextMenuAsync(TreeContextMenuRequest request)
    {
        if (IsLoadMoreNodeKey(request.Node.Key))
            return;

        if (!string.Equals(_selectedBranchKey, request.Node.Key, StringComparison.OrdinalIgnoreCase))
        {
            _selectedBranchKey = request.Node.Key;
            _expandToKey = BuildExpandPath(request.Node.Key);
            await LoadDetailFromKeyAsync(request.Node.Key);
            UpdateBrowserUrl();
        }

        if (_selectedDetail is null)
        {
            CloseContextMenu();
            return;
        }

        _contextMenu = new ContextMenuState
        {
            IsOpen = true,
            NodeKey = request.Node.Key,
            X = request.X,
            Y = request.Y
        };

        await InvokeAsync(StateHasChanged);
    }

    private IReadOnlyList<SubjectBrowserAction> GetContextMenuActions()
    {
        if (_selectedDetail is null || !_contextMenu.IsOpen)
            return Array.Empty<SubjectBrowserAction>();

        var refreshAction = new SubjectBrowserAction(
            "refresh",
            "Refresh",
            "bi-arrow-clockwise",
            "dropdown-item",
            true,
            RefreshSelectedNodeAsync);

        return
        [
            refreshAction,
            .. GetDetailActions().Select(action => action with { ButtonCssClass = "dropdown-item" })
        ];
    }

    private async Task ExecuteContextMenuActionAsync(Func<Task> executeAsync)
    {
        CloseContextMenu();
        await executeAsync();
    }

    private async Task RefreshSelectedNodeAsync()
    {
        CloseContextMenu();

        if (string.IsNullOrWhiteSpace(_selectedBranchKey))
            return;

        SubjectBrowserService.InvalidateSnapshot();
        _refreshToken++;
        await LoadDetailFromKeyAsync(_selectedBranchKey);
        await SetActionMessageAsync("Subject refreshed.", "alert-success");
    }

    private void CloseContextMenu()
    {
        if (_contextMenu.IsOpen)
            _contextMenu = _contextMenu with { IsOpen = false };
    }

    private RenderFragment RenderContextMenu() => @<text>
    @if (_contextMenu.IsOpen)
    {
