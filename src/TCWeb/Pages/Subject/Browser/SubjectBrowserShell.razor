    private RenderFragment RenderDetailPaneContent()
    {
        if (ShouldRenderHostedDetailPage())
            return RenderHostedDetailPage();

        if (ShouldRenderActiveEnquiry())
            return RenderEnquiryPane();

        if (ShouldRenderAddExistingPanel())
            return RenderAddExistingPane();

        if (ShouldRenderMovePanel())
            return RenderMovePane();

        if (ShouldRenderRemovalPanel())
            return RenderRemovalPane();

        if (ShouldRenderCreatePanel())
            return RenderCreatePane();

        if (_selectedDetail is null)
            return RenderEmptyDetailPane();

        return RenderSelectedDetailPane();
    }

    private bool ShouldRenderActiveEnquiry()
    {
