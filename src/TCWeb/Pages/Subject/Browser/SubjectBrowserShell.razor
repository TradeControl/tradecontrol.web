    private async Task ConfirmRemoveNamespaceAsync()
    {
        if (_selectedDetail is null || _pendingRemovalPlan is null)
            return;

        var parentSubjectCode = GetSelectedParentSubjectCode();
        if (string.IsNullOrWhiteSpace(parentSubjectCode))
            return;

        try
        {
            _isRemovingNamespace = true;

            var currentSelectionKey = _selectedBranchKey;
            var subject = new Subjects(NodeContext, _selectedDetail.SubjectCode);
            var result = await subject.RemoveFromNamespaceAsync(parentSubjectCode);

            if (result.Succeeded)
            {
                SubjectBrowserService.InvalidateSnapshot();
                ClearRemovalPreview();

                var nextSelectionKey = ResolvePostActionSelectionKey("remove", currentSelectionKey);
                await RefreshBrowserAfterActionAsync("remove", currentSelectionKey, nextSelectionKey);
                await SetActionMessageAsync(result.Message, "alert-success");
                return;
            }

            _pendingRemovalPlan = _pendingRemovalPlan with
            {
                CanProceed = false,
                Message = result.Message
            };
        }
        catch (Exception ex)
        {
            _pendingRemovalPlan = _pendingRemovalPlan with
            {
                CanProceed = false,
                Message = ex.Message
            };
        }
        finally
        {
            _isRemovingNamespace = false;
            UpdateBrowserUrl();
            await InvokeAsync(StateHasChanged);
        }
    }

