@using System.Linq
@using Microsoft.AspNetCore.WebUtilities
@using Microsoft.JSInterop
@using Wangkanai.Detection.Models

@using TradeControl.Web.AppServices
@using TradeControl.Web.Data
@using TradeControl.Web.Pages.Shared.Tree
@using TradeControl.Web.Pages.Subject.Controls
@using TradeControl.Web.Pages.Subject.Browser.Components

@inject NavigationManager NavigationManager
@inject Wangkanai.Detection.Services.IDetectionService Detection
@inject IJSRuntime JSRuntime
@inject ISubjectBrowserService SubjectBrowserService
@inject NodeContext NodeContext

@implements IAsyncDisposable

@if (_isEmbedded)
{
    <div class="d-flex flex-column gap-3 h-100" style="min-height:0; overflow:hidden;">
        <div class="d-flex align-items-center justify-content-between gap-2">
            <button type="button"
                    class="btn tc-subject-browser-back-btn"
                    @onclick="NavigateBackAsync">
                <i class="bi bi-arrow-left" aria-hidden="true"></i>
                <span>Back</span>
            </button>

            <div class="text-muted small text-end">
                @if (_selectedDetail is not null)
                {
                    <div>@_selectedDetail.DisplayLabel</div>
                    <div><code>@_selectedDetail.SubjectCode</code></div>
                }
            </div>
        </div>

        @if (!string.IsNullOrWhiteSpace(_errorMessage))
        {
            <div class="alert alert-danger py-2 mb-0">@_errorMessage</div>
        }

        <div class="flex-grow-1 d-flex flex-column" style="min-height:0; overflow:hidden;">
            @RenderDetailPane()
        </div>
    </div>
}
else if (_isMobile)
{
    <div class="d-flex flex-column gap-3 h-100" style="min-height:0; overflow:hidden;">
        @if (!string.IsNullOrWhiteSpace(_errorMessage))
        {
            <div class="alert alert-danger py-2 mb-0" role="alert">@_errorMessage</div>
        }

        <div class="p-2 mb-1">
            <NamespaceSelector FilterText="@_namespaceFilter"
                               Suggestions="@_namespaceSuggestions"
                               IsLoadingSuggestions="@_isLoadingNamespaceSuggestions"
                               ShowApplyButton="true"
                               ApplyButtonTitle="Apply namespace filter"
                               OnFilterChanged="HandleFilterChangedAsync"
                               OnFilterCommitted="HandleFilterCommittedAsync" />
        </div>

        <div class="btn-group mb-3" role="group" aria-label="Browser mode">
            <button type="button"
                    class="btn @GetModeButtonClass(SubjectBrowserMode.Enquiry)"
                    @onclick="() => SetModeAsync(SubjectBrowserMode.Enquiry)">
                Enquiry
            </button>
            <button type="button"
                    class="btn @GetModeButtonClass(SubjectBrowserMode.Namespace)"
                    @onclick="() => SetModeAsync(SubjectBrowserMode.Namespace)">
                Namespace
            </button>
            <button type="button"
                    class="btn @GetModeButtonClass(SubjectBrowserMode.Subject)"
                    @onclick="() => SetModeAsync(SubjectBrowserMode.Subject)">
                Subject
            </button>
        </div>

        <div class="small text-muted mb-2">
            @_rootCount subject@(_rootCount == 1 ? string.Empty : "s")
        </div>

        <div class="flex-grow-1 d-flex flex-column tc-subject-browser-tree tc-tree-host"
             style="min-height:0; overflow:auto; padding-bottom:calc(96px + env(safe-area-inset-bottom));">
            @if (_rootNodes.Count == 0)
            {
                <div class="text-muted small py-2">No Subjects found.</div>
            }
            else
            {
                <SubjectBrowserBranch IsRoot="true"
                                      RootNodes="@_rootNodes"
                                      GetChildren="GetChildrenAsync"
                                      OnLeafSelected="HandleLeafSelectedAsync"
                                      OnNodeSelected="HandleNodeSelectedAsync"
                                      SelectedKey="@_selectedBranchKey"
                                      ExpandToKey="@_expandToKey"
                                      RefreshToken="@_refreshToken"
                                      CanDrag="CanDragTreeNode"
                                      CanDrop="CanDropTreeNode"
                                      DraggedKey="@_dragSourceKey"
                                      DropTargetKey="@_dropTargetKey"
                                      OnDragStarted="HandleTreeDragStartedAsync"
                                      OnDragEnded="HandleTreeDragEndedAsync"
                                      OnNodeDropped="HandleTreeNodeDroppedAsync"
                                      IsMobile="@_isMobile"
                                      OnNodeContextMenu="HandleNodeContextMenuAsync" />
            }
        </div>

        @{
            var mobileActions = GetMobileShortcutActions();
        }

        <div class="tc-mobile-actionbar tc-visible" role="toolbar" aria-label="Subject browser actions">
            <div class="tc-mobile-action-summary me-2">
                <div class="tc-mobile-action-title">@GetMobileActionTitle()</div>
                <div class="tc-mobile-action-subtitle">@GetMobileActionSubtitle()</div>
            </div>

            <button type="button"
                    class="btn-action"
                    disabled="@(!CanOpenDetails())"
                    @onclick="OpenEmbeddedDetailsAsync">
                <i class="bi bi-eye" aria-hidden="true"></i>
                <span>Details</span>
            </button>

            @foreach (var action in mobileActions)
            {
                <button type="button"
                        class="btn-action"
                        disabled="@(!action.IsEnabled)"
                        @onclick="action.ExecuteAsync">
                    <i class="bi @action.IconClass" aria-hidden="true"></i>
                    <span>@action.Text</span>
                </button>
            }
        </div>
    </div>
}
else
{
    <div class="d-flex flex-column gap-3 h-100" style="min-height:0; overflow:hidden;">

        @if (!string.IsNullOrWhiteSpace(_errorMessage))
        {
            <div class="alert alert-danger py-2 mb-0" role="alert">@_errorMessage</div>
        }

        <div class="flex-grow-1 d-flex flex-column" style="min-height:0; overflow:hidden;">
            <TreeShell IsMobile="@_isMobile">
                <LeftPane>
                    <div class="d-flex flex-column h-100" style="min-height:0; overflow:hidden;">
                        <div class="mb-3">
                            <NamespaceSelector FilterText="@_namespaceFilter"
                                               Suggestions="@_namespaceSuggestions"
                                               IsLoadingSuggestions="@_isLoadingNamespaceSuggestions"
                                               ShowApplyButton="true"
                                               ApplyButtonTitle="Apply namespace filter"
                                               OnFilterChanged="HandleFilterChangedAsync"
                                               OnFilterCommitted="HandleFilterCommittedAsync" />
                        </div>

                        <div class="btn-group mb-3" role="group" aria-label="Browser mode">
                            <button type="button"
                                    class="btn @GetModeButtonClass(SubjectBrowserMode.Enquiry)"
                                    @onclick="() => SetModeAsync(SubjectBrowserMode.Enquiry)">
                                Enquiry
                            </button>
                            <button type="button"
                                    class="btn @GetModeButtonClass(SubjectBrowserMode.Namespace)"
                                    @onclick="() => SetModeAsync(SubjectBrowserMode.Namespace)">
                                Namespace
                            </button>
                            <button type="button"
                                    class="btn @GetModeButtonClass(SubjectBrowserMode.Subject)"
                                    @onclick="() => SetModeAsync(SubjectBrowserMode.Subject)">
                                Subject
                            </button>
                        </div>

                        <div class="small text-muted mb-2">
                            @_rootCount subject@(_rootCount == 1 ? string.Empty : "s")
                        </div>

                        <div class="flex-grow-1 overflow-auto tc-subject-browser-tree" style="min-height:0;">
                            @if (_rootNodes.Count == 0)
                            {
                                <div class="text-muted small py-2">No Subjects found.</div>
                            }
                            else
                            {
                                <SubjectBrowserBranch IsRoot="true"
                                                      RootNodes="@_rootNodes"
                                                      GetChildren="GetChildrenAsync"
                                                      OnLeafSelected="HandleLeafSelectedAsync"
                                                      OnNodeSelected="HandleNodeSelectedAsync"
                                                      SelectedKey="@_selectedBranchKey"
                                                      ExpandToKey="@_expandToKey"
                                                      RefreshToken="@_refreshToken"
                                                      CanDrag="CanDragTreeNode"
                                                      CanDrop="CanDropTreeNode"
                                                      DraggedKey="@_dragSourceKey"
                                                      DropTargetKey="@_dropTargetKey"
                                                      OnDragStarted="HandleTreeDragStartedAsync"
                                                      OnDragEnded="HandleTreeDragEndedAsync"
                                                      OnNodeDropped="HandleTreeNodeDroppedAsync" />
                            }
                        </div>
                    </div>
                </LeftPane>

                <RightPane>
                    <div class="d-flex flex-column h-100" style="min-height:0; overflow:hidden;">
                        <div class="d-flex align-items-center justify-content-between mb-3">
                            <div class="fw-semibold">Subject Detail</div>
                            <div class="small text-muted">@_mode</div>
                        </div>

                        @RenderDetailPane()
                    </div>
                </RightPane>
            </TreeShell>
        </div>
    </div>
}

@RenderContextMenu()

@code {
    [Parameter] public string? InitialFilter { get; set; }

    private const int PageSize = 50;
    private const int SuggestionPageSize = 12;

    private IReadOnlyList<NamespaceSelectorSuggestion> _namespaceSuggestions = Array.Empty<NamespaceSelectorSuggestion>();
    private bool _isLoadingNamespaceSuggestions;

    private enum SubjectBrowserMode
    {
        Enquiry,
        Namespace,
        Subject
    }

    private sealed record SubjectBrowserAction(
        string Id,
        string Text,
        string IconClass,
        string ButtonCssClass,
        bool IsEnabled,
        Func<Task> ExecuteAsync);

    private bool _isMobile;
    private bool _isEmbedded;
    private string _namespaceFilter = string.Empty;
    private string _appliedNamespaceFilter = string.Empty;
    private string? _selectedBranchKey;
    private string? _expandToKey;
    private string? _returnNodeKey;
    private string? _initialSelectKey;
    private SubjectBrowserMode _mode = SubjectBrowserMode.Enquiry;
    private SubjectBrowserDetailModel? _selectedDetail;
    private string? _errorMessage;
    private string? _actionMessage;
    private string _actionMessageCssClass = "alert-warning";
    private int _rootPageNumber = 1;
    private int _rootCount;
    private long _refreshToken;
    private string? _committedNamespacePath;
    private SubjectEnquiryView _activeEnquiryView = SubjectEnquiryView.None;
    private NodeEnum.SubjectClass? _pendingCreateSubjectClass;
    private string _pendingCreateName = string.Empty;
    private string? _pendingCreateErrorMessage;
    private bool _isCreatingSubject;
    private SubjectRemovalPlan? _pendingRemovalPlan;
    private bool _isLoadingRemovalPreview;
    private bool _isRemovingNamespace;
    private bool _loadRemovalPreview;
    private string _pendingMoveTargetPath = string.Empty;
    private string _resolvedMoveTargetPath = string.Empty;
    private IReadOnlyList<NamespaceSelectorSuggestion> _moveTargetSuggestions = Array.Empty<NamespaceSelectorSuggestion>();
    private bool _isLoadingMoveTargetSuggestions;
    private SubjectReparentPlan? _pendingReparentPlan;
    private bool _isReparenting;
    private bool _isMovePanelOpen;
    private string _pendingAddSubjectPath = string.Empty;
    private string _resolvedAddSubjectPath = string.Empty;
    private IReadOnlyList<NamespaceSelectorSuggestion> _addSubjectSuggestions = Array.Empty<NamespaceSelectorSuggestion>();
    private bool _isLoadingAddSubjectSuggestions;
    private SubjectAddParentPlan? _pendingAddParentPlan;
    private bool _isAddingToNamespace;
    private bool _isAddExistingPanelOpen;
    private string? _dragSourceKey;
    private string? _dropTargetKey;
    private string? _detailPageSrc;
    private bool _loadMovePanel;
    private bool _loadAddExistingPanel;

    private DotNetObjectReference<SubjectBrowserShell>? _dotNetRef;

    private readonly List<TreeNode> _rootNodes = new();
    private readonly Dictionary<string, SubjectBrowserNode> _nodeIndex = new(StringComparer.OrdinalIgnoreCase);
    private readonly Dictionary<string, int> _childPageNumbers = new(StringComparer.OrdinalIgnoreCase);

    private ContextMenuState _contextMenu = new();

    protected override async Task OnInitializedAsync()
    {
        _namespaceFilter = InitialFilter?.Trim() ?? string.Empty;
        ParseQueryParameters();

        _isMobile = Detection?.Device?.Type == Device.Mobile;

        if (_isMobile
            && string.IsNullOrWhiteSpace(_namespaceFilter)
            && !string.IsNullOrWhiteSpace(_initialSelectKey))
        {
            _namespaceFilter = _initialSelectKey;
        }

        _appliedNamespaceFilter = _namespaceFilter;

        if (_isEmbedded)
        {
            await LoadEmbeddedAsync();
            return;
        }

        await RefreshNamespaceSuggestionsAsync();
        await LoadRootsAsync();

        if (!string.IsNullOrWhiteSpace(_initialSelectKey))
        {
            await ApplyCommittedNamespaceSelectionAsync(_initialSelectKey, _namespaceFilter, applyFilter: false);
        }
    }

    // protected override async Task OnAfterRenderAsync(bool firstRender)
    // {
    //     if (!firstRender)
    //         return;

    //     if (_isEmbedded)
    //         return;

    //     await JSRuntime.InvokeVoidAsync("subjectBrowser.updateViewportHeight");
    //     await JSRuntime.InvokeVoidAsync("subjectBrowser.updateHeaderOffset");
    //     await JSRuntime.InvokeVoidAsync("subjectBrowser.initSplit");
    // }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !_isMobile && !_isEmbedded)
        {
            _dotNetRef = DotNetObjectReference.Create(this);
            await JSRuntime.InvokeVoidAsync("subjectBrowser.initEditorMessaging", _dotNetRef);
        }
    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            if (!_isMobile && !_isEmbedded)
                await JSRuntime.InvokeVoidAsync("subjectBrowser.disposeEditorMessaging");
        }
        catch
        {
        }

        _dotNetRef?.Dispose();
    }

    private void ParseQueryParameters()
    {
        var uri = NavigationManager.ToAbsoluteUri(NavigationManager.Uri);
        var query = QueryHelpers.ParseQuery(uri.Query);

        _isEmbedded = query.TryGetValue("embedded", out var embeddedValue) && embeddedValue == "1";
        _returnNodeKey = query.TryGetValue("returnNode", out var returnValue) ? returnValue.ToString() : null;
        _initialSelectKey = query.TryGetValue("select", out var selectValue) ? selectValue.ToString() : null;
        _loadRemovalPreview = query.TryGetValue("removePreview", out var removeValue) && removeValue == "1";
        _loadMovePanel = query.TryGetValue("move", out var moveValue) && moveValue == "1";
        _loadAddExistingPanel = query.TryGetValue("addExisting", out var addExistingValue) && addExistingValue == "1";

        if (query.TryGetValue("mode", out var modeValue)
            && TryParseMode(modeValue.ToString(), out var mode))
        {
            _mode = mode;
        }

        if (query.TryGetValue("enquiry", out var enquiryValue)
            && TryParseEnquiryView(enquiryValue.ToString(), out var enquiryView))
        {
            _activeEnquiryView = enquiryView;
        }

        if (query.TryGetValue("create", out var createValue)
            && TryParseSubjectClass(createValue.ToString(), out var createClass))
        {
            _pendingCreateSubjectClass = createClass;
        }

        if (string.IsNullOrWhiteSpace(_namespaceFilter) && query.TryGetValue("namespaceFilter", out var filterValue))
        {
            _namespaceFilter = filterValue.ToString();
        }
    }

    private async Task LoadEmbeddedAsync()
    {
        _errorMessage = null;

        if (string.IsNullOrWhiteSpace(_initialSelectKey))
        {
            _selectedDetail = null;
            _selectedBranchKey = null;
            _expandToKey = null;
            ClearActionMessage();
            ClearMoveState();
            ClearAddExistingState();
            return;
        }

        await LoadDetailFromKeyAsync(_initialSelectKey);

        if (_loadAddExistingPanel)
        {
            ClearMoveState();
            _isAddExistingPanelOpen = true;
            await RefreshAddSubjectSuggestionsAsync();
        }
        else if (_loadMovePanel)
        {
            ClearAddExistingState();
            _isMovePanelOpen = true;
            await RefreshMoveTargetSuggestionsAsync();
        }

        if (_loadRemovalPreview)
        {
            await LoadRemoveNamespacePreviewAsync();
        }
    }

    private async Task HandleFilterChangedAsync(string filterText)
    {
        CloseContextMenu();

        var currentSelectionKey = _selectedBranchKey;

        _namespaceFilter = filterText?.Trim() ?? string.Empty;
        _appliedNamespaceFilter = _namespaceFilter;
        _rootPageNumber = 1;
        _childPageNumbers.Clear();
        ClearActionMessage();

        SubjectBrowserService.InvalidateSnapshot();

        await RefreshNamespaceSuggestionsAsync();
        await LoadRootsAsync();

        if (!string.IsNullOrWhiteSpace(currentSelectionKey))
        {
            await LoadDetailFromKeyAsync(currentSelectionKey);
        }
        else
        {
            _selectedBranchKey = null;
            _selectedDetail = null;
            _expandToKey = null;
        }

        UpdateBrowserUrl();
    }

    private async Task HandleFilterCommittedAsync(string filterText)
    {
        var committedFilter = filterText?.Trim() ?? string.Empty;

        if (!string.Equals(_namespaceFilter, committedFilter, StringComparison.Ordinal))
        {
            await HandleFilterChangedAsync(committedFilter);
        }

        if (committedFilter.EndsWith(".", StringComparison.Ordinal))
        {
            var branchKey = committedFilter.TrimEnd('.');

            if (!string.IsNullOrWhiteSpace(branchKey))
            {
                await ApplyCommittedNamespaceSelectionAsync(branchKey, committedFilter);
            }

            return;
        }

        var nearestMatch = GetNearestNamespaceSuggestion(committedFilter);
        if (nearestMatch is null)
            return;

        await ApplyCommittedNamespaceSelectionAsync(nearestMatch.FullPath, committedFilter);
    }

    private NamespaceSelectorSuggestion? GetNearestNamespaceSuggestion(string filterText)
    {
        if (_namespaceSuggestions.Count == 0 || string.IsNullOrWhiteSpace(filterText))
            return null;

        return _namespaceSuggestions.FirstOrDefault(suggestion =>
                   string.Equals(suggestion.FullPath, filterText, StringComparison.OrdinalIgnoreCase))
            ?? _namespaceSuggestions.FirstOrDefault(suggestion =>
                   suggestion.FullPath.StartsWith($"{filterText}.", StringComparison.OrdinalIgnoreCase))
            ?? _namespaceSuggestions.FirstOrDefault(suggestion =>
                   suggestion.FullPath.Contains(filterText, StringComparison.OrdinalIgnoreCase))
            ?? _namespaceSuggestions[0];
    }

    private async Task ApplyCommittedNamespaceSelectionAsync(
        string branchKey,
        string? filterText = null,
        bool applyFilter = true)
    {
        _committedNamespacePath = branchKey;
        _namespaceFilter = filterText ?? branchKey;

        if (applyFilter)
        {
            _appliedNamespaceFilter = _namespaceFilter;
        }

        _selectedBranchKey = branchKey;
        _expandToKey = BuildExpandPath(branchKey);

        await LoadDetailFromKeyAsync(branchKey);
        await RefreshNamespaceSuggestionsAsync();
        UpdateBrowserUrl();
        await InvokeAsync(StateHasChanged);
    }

    private async Task RefreshNamespaceSuggestionsAsync()
    {
        try
        {
            _isLoadingNamespaceSuggestions = true;
            _namespaceSuggestions = await SubjectBrowserService.GetNamespaceSuggestionsAsync(
                _namespaceFilter,
                SuggestionPageSize);
        }
        catch (Exception ex)
        {
            _errorMessage = ex.Message;
            _namespaceSuggestions = Array.Empty<NamespaceSelectorSuggestion>();
        }
        finally
        {
            _isLoadingNamespaceSuggestions = false;
        }
    }

    private async Task SetModeAsync(SubjectBrowserMode mode)
    {
        CloseContextMenu();

        _mode = mode;
        ClearActionMessage();
        ClearHostedDetailPage();

        if (mode != SubjectBrowserMode.Enquiry)
        {
            _activeEnquiryView = SubjectEnquiryView.None;
        }

        if (mode != SubjectBrowserMode.Namespace)
        {
            ClearCreateState();
            ClearRemovalPreview();
            ClearMoveState();
            ClearAddExistingState();
        }

        UpdateBrowserUrl();
        await InvokeAsync(StateHasChanged);
    }

    private string GetModeButtonClass(SubjectBrowserMode mode)
    {
        return _mode == mode ? "btn-primary" : "btn-outline-primary";
    }

    private async Task LoadRootsAsync()
    {
        try
        {
            _errorMessage = null;
            _rootNodes.Clear();
            _nodeIndex.Clear();

            var result = await SubjectBrowserService.GetRootNodesAsync(
                _appliedNamespaceFilter,
                _rootPageNumber,
                PageSize);

            _rootCount = result.TotalCount;

            foreach (var node in result.Items)
            {
                _nodeIndex[node.BranchKey] = node;
                _rootNodes.Add(node.ToTreeNode());
            }

            if (result.HasMorePages)
            {
                _rootNodes.Add(CreateLoadMoreNode(CreateRootLoadMoreKey()));
            }

            _refreshToken++;
        }
        catch (Exception ex)
        {
            _errorMessage = ex.Message;
        }
    }

    private async Task<IReadOnlyList<TreeNode>> GetChildrenAsync(TreeNode treeNode)
    {
        if (!_nodeIndex.TryGetValue(treeNode.Key, out var browserNode))
        {
            return Array.Empty<TreeNode>();
        }

        var pageNumber = _childPageNumbers.TryGetValue(browserNode.BranchKey, out var loadedPageNumber)
            ? loadedPageNumber
            : 1;

        var allNodes = new List<TreeNode>();

        for (var page = 1; page <= pageNumber; page++)
        {
            var result = await SubjectBrowserService.GetChildNodesAsync(
                browserNode.SubjectCode,
                browserNode.NamespacePath,
                _appliedNamespaceFilter,
                page,
                PageSize);

            foreach (var child in result.Items)
            {
                _nodeIndex[child.BranchKey] = child;
                allNodes.Add(child.ToTreeNode());
            }

            if (page == pageNumber && result.HasMorePages)
            {
                allNodes.Add(CreateLoadMoreNode(CreateChildLoadMoreKey(browserNode.BranchKey)));
            }
        }

        return allNodes;
    }

    private Task HandleLeafSelectedAsync(TreeNode treeNode)
    {
        return Task.CompletedTask;
    }

    private async Task HandleNodeSelectedAsync(TreeNode treeNode)
    {
        if (string.Equals(treeNode.Key, CreateRootLoadMoreKey(), StringComparison.OrdinalIgnoreCase))
        {
            _rootPageNumber++;
            await LoadRootsAsync();
            return;
        }

        if (TryParseChildLoadMoreKey(treeNode.Key, out var parentBranchKey))
        {
            if (_childPageNumbers.TryGetValue(parentBranchKey, out var pageNumber))
            {
                _childPageNumbers[parentBranchKey] = pageNumber + 1;
            }
            else
            {
                _childPageNumbers[parentBranchKey] = 2;
            }

            _refreshToken++;
            return;
        }

        await ApplyCommittedNamespaceSelectionAsync(treeNode.Key, treeNode.Key, applyFilter: false);
    }

    private async Task LoadDetailFromKeyAsync(string key)
    {
        CloseContextMenu();

        _expandToKey = BuildExpandPath(key);
        ClearActionMessage();
        ClearHostedDetailPage();

        var parentSubjectCode = ExtractParentSubjectCode(key);

        if (!_nodeIndex.TryGetValue(key, out var browserNode))
        {
            var subjectCode = ExtractSubjectCode(key);
            if (string.IsNullOrWhiteSpace(subjectCode))
                return;

            _selectedBranchKey = key;
            _selectedDetail = await SubjectBrowserService.GetDetailAsync(subjectCode, parentSubjectCode);
            return;
        }

        _selectedBranchKey = browserNode.BranchKey;
        _selectedDetail = await SubjectBrowserService.GetDetailAsync(browserNode.SubjectCode, parentSubjectCode);
    }

    private bool CanOpenDetails()
    {
        return !string.IsNullOrWhiteSpace(_selectedBranchKey) && _selectedDetail is not null;
    }

    private bool CanMaintainAddresses()
    {
        return _mode == SubjectBrowserMode.Subject
            && _selectedDetail is not null
            && !_selectedDetail.IsStructural;
    }

    private async Task BeginEditAddressAsync(string addressCode)
    {
        if (_selectedDetail is null || string.IsNullOrWhiteSpace(addressCode))
            return;

        var returnNode = !string.IsNullOrWhiteSpace(_selectedBranchKey)
            ? _selectedBranchKey
            : _selectedDetail.SubjectCode;

        var embedded = ShouldUseEmbeddedMaintenancePage(_isMobile);
        var url = BuildAddressMaintenanceUrl("EditAddress", addressCode, returnNode, embedded);

        if (_isMobile || _isEmbedded)
        {
            NavigationManager.NavigateTo(url, forceLoad: true);
            return;
        }

        _detailPageSrc = url;
        await InvokeAsync(StateHasChanged);
    }

    private async Task SetDefaultAddressAsync(string addressCode)
    {
        if (_selectedDetail is null || string.IsNullOrWhiteSpace(addressCode))
            return;

        try
        {
            var subjects = new Subjects(NodeContext, _selectedDetail.SubjectCode);
            var result = await subjects.SetDefaultAddressAsync(addressCode);

            if (result.Succeeded)
            {
                SubjectBrowserService.InvalidateSnapshot();
                _refreshToken++;

                if (!string.IsNullOrWhiteSpace(_selectedBranchKey))
                {
                    await LoadDetailFromKeyAsync(_selectedBranchKey);
                }
            }

            await SetActionMessageAsync(result.Message, result.Succeeded ? "alert-success" : "alert-warning");
        }
        catch (Exception ex)
        {
            await SetActionMessageAsync(ex.Message, "alert-danger");
        }
    }

    private async Task ConfirmDeleteAddressAsync(string addressCode)
    {
        if (_selectedDetail is null || string.IsNullOrWhiteSpace(addressCode))
            return;

        var confirmed = await JSRuntime.InvokeAsync<bool>("confirm", "Delete this address?");
        if (!confirmed)
            return;

        try
        {
            var subjects = new Subjects(NodeContext, _selectedDetail.SubjectCode);
            var result = await subjects.DeleteAddressAsync(addressCode);

            if (result.Succeeded)
            {
                SubjectBrowserService.InvalidateSnapshot();
                _refreshToken++;

                if (!string.IsNullOrWhiteSpace(_selectedBranchKey))
                {
                    await LoadDetailFromKeyAsync(_selectedBranchKey);
                }
            }

            await SetActionMessageAsync(result.Message, result.Succeeded ? "alert-success" : "alert-warning");
        }
        catch (Exception ex)
        {
            await SetActionMessageAsync(ex.Message, "alert-danger");
        }
    }

    private string BuildAddressMaintenanceUrl(string pageName, string? addressCode, string? returnNode, bool embedded)
    {
        var baseUrl = $"{NavigationManager.BaseUri.TrimEnd('/')}/Subject/Browser/{pageName}";
        var query = new List<string>
        {
            $"subjectCode={Uri.EscapeDataString(_selectedDetail!.SubjectCode)}"
        };

        if (!string.IsNullOrWhiteSpace(addressCode))
            query.Add($"addressCode={Uri.EscapeDataString(addressCode)}");

        if (!string.IsNullOrWhiteSpace(returnNode))
            query.Add($"returnNode={Uri.EscapeDataString(returnNode)}");

        if (embedded)
            query.Add("isEmbedded=1");

        return $"{baseUrl}?{string.Join("&", query)}";
    }

    private Task OpenEmbeddedDetailsAsync()
    {
        if (!CanOpenDetails())
            return Task.CompletedTask;

        NavigationManager.NavigateTo(
            BuildUrl(
                embedded: true,
                selectKey: _selectedBranchKey,
                returnNodeKey: _selectedBranchKey),
            forceLoad: true);

        return Task.CompletedTask;
    }

    private string GetMobileActionTitle()
    {
        if (_selectedDetail is null)
            return "Select a Subject";

