    private bool ShouldRenderMovePanel()
    {
        return _mode == SubjectBrowserMode.Namespace
            && _isMovePanelOpen
            && _selectedDetail is not null;
    }

    private bool ShouldRenderRemovalPanel()
    {
        return _mode == SubjectBrowserMode.Namespace
            && _pendingRemovalPlan is not null
            && _selectedDetail is not null;
