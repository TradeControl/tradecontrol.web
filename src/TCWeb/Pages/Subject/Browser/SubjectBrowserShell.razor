        <dd class="col-sm-7">@_pendingRemovalPlan.ProjectCount</dd>
    </dl>

    <div class="d-flex flex-wrap gap-2">
        <button type="button"
                class="btn btn-danger btn-sm"
                disabled="@(!_pendingRemovalPlan.CanProceed || _isRemovingNamespace)"
                @onclick="ConfirmRemoveNamespaceAsync">
            @if (_isRemovingNamespace)
            {
                <span>Removing…</span>
            }
            else
            {
                <span>Confirm</span>
            }
        </button>

        <button type="button"
                class="btn btn-outline-secondary btn-sm"
                disabled="@_isRemovingNamespace"
                @onclick="CancelRemoveNamespaceAsync">
            Cancel
        </button>
    </div>
</div>;

private RenderFragment RenderCreatePane() => @<div class="bg-white border rounded p-3">
    <div class="fw-semibold mb-1">@GetPendingCreateHeading()</div>
    <div class="text-muted small mb-3">@GetPendingCreateHelpText()</div>

    <div class="small mb-3">
        <div class="text-muted">Parent</div>
        <div class="fw-semibold">@_selectedDetail!.DisplayLabel</div>
        <div><code>@_selectedDetail.SubjectCode</code></div>
    </div>

@if (!string.IsNullOrWhiteSpace(_pendingCreateErrorMessage))
{
        <div class="alert alert-danger py-2 mb-3" role="alert">@_pendingCreateErrorMessage</div>
}

    <div class="mb-3">
        <label class="form-label">@GetPendingCreateNameLabel()</label>
        <input class="form-control"
               value="@_pendingCreateName"
               @oninput="args => _pendingCreateName = args.Value?.ToString() ?? string.Empty"
               placeholder="Enter name..." />
    </div>

    <div class="d-flex flex-wrap gap-2">
        <button type="button"
                class="btn btn-primary btn-sm"
                disabled="@_isCreatingSubject"
                @onclick="SubmitCreateAsync">
            @if (_isCreatingSubject)
            {
                <span>Creating…</span>
            }
            else
            {
                <span>Create</span>
            }
        </button>

        <button type="button"
                class="btn btn-outline-secondary btn-sm"
                disabled="@_isCreatingSubject"
                @onclick="CancelCreateAsync">
            Cancel
        </button>
    </div>
</div>;

private RenderFragment RenderEmptyDetailPane() => @<div class="text-muted">
    Select a Subject to view its details.
</div>;

private RenderFragment RenderSelectedDetailPane() => @<div class="h-100 d-flex flex-column" style="min-height:0;">
@{
    var detailActions = GetDetailActions();
}

@if (ShouldRenderHostedDetailPage())
{
    @RenderHostedDetailPage()
}
else
{
    @RenderSubjectSummaryCard()
    @RenderActionCard(detailActions)
    @RenderActionMessage()
    @RenderIdentityFieldsCard()
    @RenderNamespacePathsCard()
    @RenderAddressesCard()
    @RenderNotesCard()
}
</div>;

private RenderFragment RenderSubjectSummaryCard() => @<div class="bg-white border rounded p-3 mb-3">
    <div class="fw-semibold">@_selectedDetail!.DisplayLabel</div>

@if (!string.Equals(_selectedDetail.DisplayLabel, _selectedDetail.Name, StringComparison.OrdinalIgnoreCase))
{
        <div class="text-muted small">@_selectedDetail.Name</div>
}

    <div class="text-muted small">@_selectedDetail.SubjectCode</div>

    <div class="small mt-2">
        <span class="badge text-bg-secondary me-1">@_selectedDetail.SubjectType</span>
        <span class="badge text-bg-light border me-1">@_selectedDetail.SubjectClassName</span>

        @if (_selectedDetail.IsDefaultInNamespace)
        {
            <span class="badge @_selectedDetail.DefaultBadgeCssClass">Default</span>
        }
    </div>
</div>;

private RenderFragment RenderActionCard(IReadOnlyList<SubjectBrowserAction> detailActions) => @<text>
@if (detailActions.Count > 0)
{
        <div class="bg-white border rounded p-3 mb-3">
            <div class="fw-semibold mb-2">Actions</div>

            <div class="d-flex flex-wrap gap-2">
                @foreach (var action in detailActions)
                {
                    <button type="button"
                            class="@action.ButtonCssClass"
                            disabled="@(!action.IsEnabled)"
                            @onclick="action.ExecuteAsync">
                        <i class="bi @action.IconClass me-1" aria-hidden="true"></i>@action.Text
                    </button>
                }
            </div>
        </div>
}
</text>;

private RenderFragment RenderActionMessage() => @<text>
@if (!string.IsNullOrWhiteSpace(_actionMessage))
{
        <div class="alert @_actionMessageCssClass py-2 mb-3" role="alert">@_actionMessage</div>
}
</text>;

private RenderFragment RenderIdentityFieldsCard() => @<text>
@if (_selectedDetail!.IdentityFields.Count > 0)
{
        <div class="bg-white border rounded p-3 mb-3">
            <div class="fw-semibold mb-2">@_selectedDetail.DetailSectionTitle</div>

            <dl class="row mb-0">
                @foreach (var field in _selectedDetail.IdentityFields)
                {
                    <dt class="col-sm-4 small text-muted">@field.Label</dt>
                    <dd class="col-sm-8 small">@field.Value</dd>
                }
            </dl>
        </div>
}
</text>;

private RenderFragment RenderNamespacePathsCard() => @<div class="bg-white border rounded p-3 mb-3">
    <div class="fw-semibold mb-2">Namespace</div>

@if (_selectedDetail!.NamespacePaths.Count == 0)
{
        <div class="text-muted small">No namespace paths.</div>
}
else
{
        <ul class="list-unstyled mb-0">
            @foreach (var path in _selectedDetail.NamespacePaths)
            {
                <li class="small mb-1"><code>@path</code></li>
            }
        </ul>
}
</div>;

private RenderFragment RenderAddressesCard() => @<text>
@if (_selectedDetail is not null && !_selectedDetail.IsStructural)
{
        <div class="bg-white border rounded p-3 mb-3">
            <div class="d-flex align-items-center justify-content-between mb-2">
                <div class="fw-semibold">Addresses</div>

                @if (CanMaintainAddresses())
                {
                    <button type="button"
                            class="btn btn-outline-primary btn-sm"
                            @onclick="BeginAddAddressAsync">
                        <i class="bi bi-plus-lg me-1" aria-hidden="true"></i>Add
                    </button>
                }
            </div>

            @if (_selectedDetail.Addresses.Count == 0)
            {
                <div class="text-muted small">No addresses.</div>
            }
            else
            {
                @foreach (var address in _selectedDetail.Addresses)
                {
                    <div class="border rounded p-2 mb-2 @(address.IsDefault ? "border-primary" : string.Empty)">
                        <div class="d-flex justify-content-between align-items-start gap-2">
                            <div class="small" style="white-space:pre-line;">@address.Address</div>

                            @if (address.IsDefault)
                            {
                                <span class="badge text-bg-primary">Default</span>
                            }
                        </div>

                        @if (CanMaintainAddresses())
                        {
                            <div class="d-flex flex-wrap gap-2 mt-2">
                                <button type="button"
                                        class="btn btn-outline-secondary btn-sm"
                                        @onclick="() => BeginEditAddressAsync(address.AddressCode)">
                                    <i class="bi bi-pencil-square me-1" aria-hidden="true"></i>Edit
                                </button>

                                @if (!address.IsDefault)
                                {
                                    <button type="button"
                                            class="btn btn-outline-primary btn-sm"
                                            @onclick="() => SetDefaultAddressAsync(address.AddressCode)">
                                        <i class="bi bi-bookmark-star me-1" aria-hidden="true"></i>Set Default
                                    </button>
                                }

                                @if (address.CanDelete)
                                {
                                    <button type="button"
                                            class="btn btn-outline-danger btn-sm"
                                            @onclick="() => ConfirmDeleteAddressAsync(address.AddressCode)">
                                        <i class="bi bi-trash me-1" aria-hidden="true"></i>Delete
                                    </button>
                                }
                                else
                                {
                                    <button type="button"
                                            class="btn btn-outline-danger btn-sm"
                                            disabled="true"
                                            title="This address is referenced by @address.ProjectReferenceCount project@(address.ProjectReferenceCount == 1 ? string.Empty : "s").">
                                        <i class="bi bi-trash me-1" aria-hidden="true"></i>Delete
                                    </button>
                                }
                            </div>
                        }
                    </div>
                }
            }
        </div>
}
</text>;

private RenderFragment RenderNotesCard() => @<text>
@if (_selectedDetail is not null
    && (_selectedDetail.IsStructural || !string.IsNullOrWhiteSpace(_selectedDetail.Notes)))
{
        <div class="bg-white border rounded p-3">
            <div class="fw-semibold mb-2">Notes</div>
            <div class="small" style="white-space:pre-line;">@(string.IsNullOrWhiteSpace(_selectedDetail.Notes) ? "—" : _selectedDetail.Notes)</div>
        </div>
}
</text>;
}
