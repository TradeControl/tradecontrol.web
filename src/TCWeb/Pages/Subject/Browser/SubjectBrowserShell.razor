    private string ResolveAddSubjectPath(string? filterText)
    {
        var normalized = filterText?.Trim() ?? string.Empty;
        if (string.IsNullOrWhiteSpace(normalized))
            return string.Empty;

        var exact = _addSubjectSuggestions.FirstOrDefault(suggestion =>
            string.Equals(suggestion.FullPath, normalized, StringComparison.OrdinalIgnoreCase));

        if (exact is not null)
            return exact.FullPath;

        return _addSubjectSuggestions.FirstOrDefault()?.FullPath ?? normalized;
    }

    private async Task ConfirmAddExistingAsync()
    {
        if (_selectedDetail is null)
            return;

        var parentSubjectCode = _selectedDetail.SubjectCode;
        _resolvedAddSubjectPath = ResolveAddSubjectPath(_pendingAddSubjectPath);
        var childSubjectCode = ExtractSubjectCode(_resolvedAddSubjectPath);

        if (string.IsNullOrWhiteSpace(childSubjectCode))
        {
            _pendingAddParentPlan = new SubjectAddParentPlan
            {
                ActionCode = NodeEnum.ActionCode.Blocked,
                CanProceed = false,
                Message = "A Subject to add is required."
            };

            await InvokeAsync(StateHasChanged);
            return;
        }

        try
        {
            _isAddingToNamespace = true;

            var subject = new Subjects(NodeContext, childSubjectCode);

            var preview = await subject.PreviewAddToNamespaceAsync(parentSubjectCode);
            _pendingAddParentPlan = preview;

            if (!preview.CanProceed)
            {
                return;
            }

            var result = await subject.AddToNamespaceAsync(parentSubjectCode);

            if (!result.Succeeded)
            {
                _pendingAddParentPlan = preview with
                {
                    CanProceed = false,
                    Message = result.Message
                };
                return;
            }

            SubjectBrowserService.InvalidateSnapshot();

            var parentBranchKey = _selectedBranchKey;
            var newSelectionKey = string.IsNullOrWhiteSpace(parentBranchKey)
                ? childSubjectCode
                : $"{parentBranchKey}.{childSubjectCode}";

            ClearAddExistingState();

            if (!string.IsNullOrWhiteSpace(parentBranchKey))
            {
                _childPageNumbers.Remove(parentBranchKey);
            }

            _refreshToken++;
            _selectedBranchKey = newSelectionKey;
            _expandToKey = BuildExpandPath(newSelectionKey);
            await LoadDetailFromKeyAsync(newSelectionKey);
            await SetActionMessageAsync(result.Message, "alert-success");
        }
        finally
        {
            _isAddingToNamespace = false;
            await InvokeAsync(StateHasChanged);
        }
    }

