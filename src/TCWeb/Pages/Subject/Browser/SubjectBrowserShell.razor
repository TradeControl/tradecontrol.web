    private async Task SubmitCreateAsync()
    {
        if (_selectedDetail is null || string.IsNullOrWhiteSpace(_selectedBranchKey) || !_pendingCreateSubjectClass.HasValue)
            return;

        var subjectClass = _pendingCreateSubjectClass.Value;
        var subjectName = _pendingCreateName?.Trim() ?? string.Empty;

        if (string.IsNullOrWhiteSpace(subjectName))
        {
            _pendingCreateErrorMessage = "A name is required.";
            await InvokeAsync(StateHasChanged);
            return;
        }

        try
        {
            _isCreatingSubject = true;
            _pendingCreateErrorMessage = null;

            var subjects = new Subjects(NodeContext);
            SubjectActionResult result = subjectClass switch
            {
                NodeEnum.SubjectClass.Structural => await subjects.AddStructuralChildAsync(_selectedDetail.SubjectCode, subjectName),
                NodeEnum.SubjectClass.Real => await subjects.AddRealChildAsync(_selectedDetail.SubjectCode, subjectName),
                NodeEnum.SubjectClass.Virtual => await subjects.AddVirtualChildAsync(_selectedDetail.SubjectCode, subjectName),
                _ => SubjectActionResult.Failure("Unsupported Subject class.")
            };

            if (!result.Succeeded)
            {
                _pendingCreateErrorMessage = result.Message;
                return;
            }

            SubjectBrowserService.InvalidateSnapshot();

            var parentBranchKey = _selectedBranchKey;
            var createdBranchKey = BuildCreatedBranchKey(parentBranchKey, result.SelectedSubjectCode);

            ClearCreateState();
            await SetActionMessageAsync(result.Message, "alert-success");
            await RefreshCreatedChildAsync(parentBranchKey, createdBranchKey);
            await OpenCreatedSubjectEditorAsync(subjectClass, createdBranchKey, result.SelectedSubjectCode);
        }
        catch (Exception ex)
        {
            _pendingCreateErrorMessage = ex.Message;
        }
        finally
        {
            _isCreatingSubject = false;
        }
    }

    private async Task OpenCreatedSubjectEditorAsync(NodeEnum.SubjectClass subjectClass, string? createdBranchKey, string? subjectCode)
    {
        if (subjectClass is not (NodeEnum.SubjectClass.Real or NodeEnum.SubjectClass.Virtual))
            return;

        if (string.IsNullOrWhiteSpace(subjectCode))
            return;

        var pageName = subjectClass == NodeEnum.SubjectClass.Real
            ? "EditReal"
            : "EditVirtual";

        var returnNode = !string.IsNullOrWhiteSpace(createdBranchKey)
            ? createdBranchKey
            : subjectCode;

        var embedded = ShouldUseEmbeddedMaintenancePage(_isMobile);
        var url = BuildSubjectMaintenanceUrl(pageName, returnNode, embedded, subjectCode);

        if (_isMobile || _isEmbedded)
        {
            NavigationManager.NavigateTo(url, forceLoad: true);
            return;
        }

        _detailPageSrc = url;
        await InvokeAsync(StateHasChanged);
    }

    private async Task RefreshCreatedChildAsync(string? parentBranchKey, string? createdBranchKey)
    {
        if (!string.IsNullOrWhiteSpace(parentBranchKey))
        {
            _childPageNumbers.Remove(parentBranchKey);
        }

        _refreshToken++;

        if (!string.IsNullOrWhiteSpace(createdBranchKey))
        {
            _selectedBranchKey = createdBranchKey;
            _expandToKey = BuildExpandPath(createdBranchKey);
            await LoadDetailFromKeyAsync(createdBranchKey);
        }

        if (_isEmbedded)
        {
            NavigationManager.NavigateTo(
                BuildUrl(
                    embedded: true,
                    selectKey: _selectedBranchKey,
                    returnNodeKey: _returnNodeKey ?? parentBranchKey),
                replace: true);
        }
        else
        {
            UpdateBrowserUrl();
            await InvokeAsync(StateHasChanged);
        }
    }

    private static string? BuildCreatedBranchKey(string? parentBranchKey, string? selectedSubjectCode)
    {
        if (string.IsNullOrWhiteSpace(selectedSubjectCode))
            return parentBranchKey;

        return string.IsNullOrWhiteSpace(parentBranchKey)
            ? selectedSubjectCode
            : $"{parentBranchKey}.{selectedSubjectCode}";
    }

