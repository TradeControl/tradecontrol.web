@using System.Linq
@using Microsoft.JSInterop
@using TradeControl.Web.AppServices
@using TradeControl.Web.Pages.Cash.Manager.Components
@using TradeControl.Web.Pages.Shared.Tree
@using TradeControl.Web.Pages.Subject.Controls
@using TradeControl.Web.Data
@using Wangkanai.Detection.Models

@inject Wangkanai.Detection.Services.IDetectionService Detection
@inject ICashManagerService CashManagerService
@inject ICashStatementQueryService CashStatementQueryService
@inject ISubjectBrowserService SubjectBrowserService
@inject IJSRuntime JSRuntime

@if (_isMobile)
{
    @if (_mobileView == CashManagerMobileView.Detail)
    {
        <div class="d-flex flex-column h-100" style="min-height:0; overflow:hidden;">
            <div class="d-flex align-items-center justify-content-between mb-2">
                <button type="button"
                        class="btn tc-back-btn"
                        @onclick="NavigateToMobileTreeAsync">
                    <i class="bi bi-arrow-left" aria-hidden="true"></i>
                    <span>Back</span>
                </button>

                <div class="fw-semibold text-truncate ms-2">@GetMobileDetailHeader()</div>
            </div>

            <div class="small text-muted mb-3">@GetMobileDetailSubtitle()</div>

            <div class="tc-mobile-card-list-host flex-grow-1 border rounded bg-light p-2 d-flex flex-column" style="min-height:0; overflow:hidden;">
                <CashManagerDetailHost IsMobile="@_isMobile"
                                       SelectedAccount="@_selectedAccount"
                                       SelectedSection="@_selectedSection"
                                       Years="@_years"
                                       Periods="@_periods"
                                       SelectedYearNumber="@_selectedYearNumber"
                                       SelectedPeriodStartOn="@_selectedPeriodStartOn"
                                       NamespaceFilter="@_namespaceFilter"
                                       CashCodeFilter="@_cashCodeFilter"
                                       CashCodeOptions="@_cashCodeOptions"
                                       InitialPaymentCode="@InitialPaymentCode"
                                       NamespaceSuggestions="@_namespaceSuggestions"
                                       IsLoadingNamespaceSuggestions="@_isLoadingNamespaceSuggestions"
                                       IsLoadingStatement="@_isLoadingStatement"
                                       ErrorMessage="@_errorMessage"
                                       Statement="@_statement"
                                       OnYearSelected="HandleYearSelectedAsync"
                                       OnPeriodSelected="HandlePeriodSelectedAsync"
                                       OnNamespaceFilterChanged="HandleNamespaceFilterChangedAsync"
                                       OnNamespaceFilterCommitted="HandleNamespaceFilterCommittedAsync"
                                       OnCashCodeFilterCommitted="HandleCashCodeFilterCommittedAsync"
                                       OnAccountSaved="HandleAccountSavedAsync"
                                       OnAccountDeleted="HandleAccountDeletedAsync" />
            </div>
        </div>
    }
    else
    {
        <div class="d-flex flex-column gap-3 h-100 position-relative" style="min-height:0; overflow:hidden;">
            <div class="d-flex flex-wrap align-items-center justify-content-between gap-2">
                <div>
                    <h1 class="h4 mb-1">Cash Manager</h1>
                    <div class="text-muted small">@GetSubtitle()</div>
                </div>

                <div class="small text-muted">
                    @(_accounts.Count) account@(_accounts.Count == 1 ? string.Empty : "s")
                </div>
            </div>

            @if (!string.IsNullOrWhiteSpace(_errorMessage))
            {
                <div class="alert alert-danger py-2 mb-0" role="alert">@_errorMessage</div>
            }

            <div class="flex-grow-1 border rounded bg-white p-3 tc-tree-host"
                 style="min-height:0; overflow:auto; padding-bottom:calc(96px + env(safe-area-inset-bottom));">
                <CashManagerTree Accounts="@_accounts"
                                 Years="@_years"
                                 Periods="@_periods"
                                 SelectedAccount="@_selectedAccount"
                                 SelectedAccountCode="@_selectedAccount?.AccountCode"
                                 SelectedSection="@_selectedSection"
                                 SelectedYearNumber="@_selectedYearNumber"
                                 SelectedPeriodStartOn="@_selectedPeriodStartOn"
                                 ShowWorkspaces="false"
                                 OnAccountSelected="HandleAccountSelectedAsync"
                                 OnSectionSelected="HandleSectionSelectedAsync"
                                 OnYearSelected="HandleYearSelectedAsync"
                                 OnPeriodSelected="HandlePeriodSelectedAsync" />
            </div>

            @if (_showMobileActionMenu && CanOpenMobileMoreActions())
            {
                <div class="position-fixed start-0 end-0 px-3" style="bottom:calc(92px + env(safe-area-inset-bottom)); z-index:1055;">
                    <div class="card shadow-sm">
                        <div class="card-body p-2">
                            <div class="small text-muted px-2 pt-1 pb-2">More</div>

                            <div class="d-grid gap-2">
                                @foreach (var section in GetMobileMenuSections())
                                {
                                    <button type="button"
                                            class="btn @(section == _selectedSection ? "btn-primary" : "btn-outline-secondary") btn-sm text-start"
                                            @onclick="() => OpenMobileSectionAsync(section)">
                                        @CashManagerSectionCatalog.GetLabel(section)
                                    </button>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            }

            <div class="tc-mobile-actionbar tc-visible" role="toolbar" aria-label="Cash manager actions">
                <div class="tc-mobile-action-summary me-2">
                    <div class="tc-mobile-action-title">@GetMobileActionTitle()</div>
                    <div class="tc-mobile-action-subtitle">@GetMobileActionSubtitle()</div>
                </div>

                <button type="button"
                        class="btn-action"
                        style="flex:0 0 64px; width:64px; min-height:68px;"
                        disabled="@(!CanOpenMobileStatement())"
                        @onclick="OpenMobileStatementAsync">
                    <i class="bi bi-journal-text" aria-hidden="true"></i>
                    <span>Statement</span>
                </button>

                <button type="button"
                        class="btn-action"
                        style="flex:0 0 64px; width:64px; min-height:68px;"
                        disabled="@(!CanOpenPrimaryMobileAction())"
                        @onclick="OpenPrimaryMobileActionAsync">
                    <i class="bi @GetPrimaryMobileActionIconClass()" aria-hidden="true"></i>
                    <span>@GetPrimaryMobileActionLabel()</span>
                </button>

                <button type="button"
                        class="btn-action"
                        style="flex:0 0 64px; width:64px; min-height:68px;"
                        disabled="@(!CanOpenMobileMoreActions())"
                        @onclick="ToggleMobileActionMenuAsync">
                    <i class="bi bi-grid-3x3-gap" aria-hidden="true"></i>
                    <span>More</span>
                </button>
            </div>
        </div>
    }
}
else
{
    <div class="d-flex flex-column gap-3 h-100" style="min-height:0; overflow:hidden;">
        <div class="d-flex flex-wrap align-items-center justify-content-between gap-2">
            <div>
                <h1 class="h4 mb-1">Cash Manager</h1>
                <div class="text-muted small">@GetSubtitle()</div>
            </div>

            <div class="small text-muted">
                @(_accounts.Count) account@(_accounts.Count == 1 ? string.Empty : "s")
            </div>
        </div>

        <div class="flex-grow-1 d-flex flex-column" style="min-height:0; overflow:hidden;">
            <TreeShell IsMobile="@_isMobile">
                <LeftPane>
                    <CashManagerTree Accounts="@_accounts"
                                     Years="@_years"
                                     Periods="@_periods"
                                     SelectedAccount="@_selectedAccount"
                                     SelectedAccountCode="@_selectedAccount?.AccountCode"
                                     SelectedSection="@_selectedSection"
                                     SelectedYearNumber="@_selectedYearNumber"
                                     SelectedPeriodStartOn="@_selectedPeriodStartOn"
                                     ShowWorkspaces="true"
                                     OnAccountSelected="HandleAccountSelectedAsync"
                                     OnSectionSelected="HandleSectionSelectedAsync"
                                     OnYearSelected="HandleYearSelectedAsync"
                                     OnPeriodSelected="HandlePeriodSelectedAsync" />
                </LeftPane>

                <RightPane>
                    <CashManagerDetailHost IsMobile="@_isMobile"
                                           SelectedAccount="@_selectedAccount"
                                           SelectedSection="@_selectedSection"
                                           Years="@_years"
                                           Periods="@_periods"
                                           SelectedYearNumber="@_selectedYearNumber"
                                           SelectedPeriodStartOn="@_selectedPeriodStartOn"
                                           NamespaceFilter="@_namespaceFilter"
                                           CashCodeFilter="@_cashCodeFilter"
                                           CashCodeOptions="@_cashCodeOptions"
                                           InitialPaymentCode="@InitialPaymentCode"
                                           NamespaceSuggestions="@_namespaceSuggestions"
                                           IsLoadingNamespaceSuggestions="@_isLoadingNamespaceSuggestions"
                                           IsLoadingStatement="@_isLoadingStatement"
                                           ErrorMessage="@_errorMessage"
                                           Statement="@_statement"
                                           OnYearSelected="HandleYearSelectedAsync"
                                           OnPeriodSelected="HandlePeriodSelectedAsync"
                                           OnNamespaceFilterChanged="HandleNamespaceFilterChangedAsync"
                                           OnNamespaceFilterCommitted="HandleNamespaceFilterCommittedAsync"
                                           OnCashCodeFilterCommitted="HandleCashCodeFilterCommittedAsync"
                                           OnAccountSaved="HandleAccountSavedAsync"
                                           OnAccountDeleted="HandleAccountDeletedAsync" />
                </RightPane>
            </TreeShell>
        </div>
    </div>
}

@code {
    [Parameter] public string? InitialAccountCode { get; set; }
    [Parameter] public string? InitialPaymentCode { get; set; }

    private IReadOnlyList<CashManagerSelectOption> _cashCodeOptions = Array.Empty<CashManagerSelectOption>();
    private const int NamespaceSuggestionPageSize = 12;

    private enum CashManagerMobileView
    {
        Tree,
        Detail
    }

    private bool _isMobile;
    private bool _isLoadingStatement;
    private bool _isLoadingNamespaceSuggestions;
    private bool _showMobileActionMenu;
    private string? _errorMessage;
    private string _namespaceFilter = string.Empty;
    private string _cashCodeFilter = string.Empty;
    private IReadOnlyList<CashManagerAccountSummary> _accounts = Array.Empty<CashManagerAccountSummary>();
    private IReadOnlyList<CashManagerYearOption> _years = Array.Empty<CashManagerYearOption>();
    private IReadOnlyList<CashManagerPeriodOption> _periods = Array.Empty<CashManagerPeriodOption>();
    private IReadOnlyList<NamespaceSelectorSuggestion> _namespaceSuggestions = Array.Empty<NamespaceSelectorSuggestion>();
    private CashManagerAccountSummary? _selectedAccount;
    private CashManagerSection _selectedSection = CashManagerSection.Statement;
    private CashManagerStatementResult _statement = CashManagerStatementResult.Empty;
    private short? _selectedYearNumber;
    private DateTime? _selectedPeriodStartOn;
    private CashManagerMobileView _mobileView = CashManagerMobileView.Tree;

    protected override async Task OnInitializedAsync()
    {
        _isMobile = Detection.Device.Type == Device.Mobile;
        await InitializeShellAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_isMobile)
        {
            return;
        }

        try
        {
            await JSRuntime.InvokeVoidAsync("cashManager.updateViewportHeight");
            await JSRuntime.InvokeVoidAsync("cashManager.updateHeaderOffset");
            await JSRuntime.InvokeVoidAsync("cashManager.initSplit");
        }
        catch (InvalidOperationException)
        {
        }
        catch (JSDisconnectedException)
        {
        }
        catch (JSException)
        {
        }
    }

    private async Task InitializeShellAsync()
    {
        _cashCodeOptions = await CashManagerService.GetCashCodeOptionsAsync();

        var preferredAccountCode = InitialAccountCode;

        if (string.IsNullOrWhiteSpace(preferredAccountCode)
            && !string.IsNullOrWhiteSpace(InitialPaymentCode))
        {
            preferredAccountCode = await CashManagerService.GetAccountCodeByPaymentCodeAsync(InitialPaymentCode);
        }

        await RefreshAccountsAsync(preferredAccountCode);
        _years = await CashManagerService.GetYearsAsync();

        var defaultPeriod = await CashManagerService.GetDefaultPeriodAsync();
        _selectedYearNumber = defaultPeriod?.YearNumber ?? _years.FirstOrDefault()?.YearNumber;
        _selectedPeriodStartOn = defaultPeriod?.StartOn;

        await LoadPeriodsAsync(_selectedYearNumber);
        await ReloadStatementAsync();
    }

    private async Task RefreshAccountsAsync(string? preferredAccountCode = null)
    {
        var includeClosed = _selectedSection == CashManagerSection.CashAccounts;

        _accounts = await CashManagerService.GetAccountsAsync(includeClosed);

        var selectedCode = !string.IsNullOrWhiteSpace(preferredAccountCode)
            ? preferredAccountCode
            : _selectedAccount?.AccountCode;

        _selectedAccount = !string.IsNullOrWhiteSpace(selectedCode)
            ? _accounts.FirstOrDefault(account => string.Equals(account.AccountCode, selectedCode, StringComparison.OrdinalIgnoreCase))
            : null;

        _selectedAccount ??= ResolveInitialAccount();
    }

    private CashManagerAccountSummary? ResolveInitialAccount()
    {
        if (_accounts.Count == 0)
        {
            return null;
        }

        if (!string.IsNullOrWhiteSpace(InitialAccountCode))
        {
            var initial = _accounts.FirstOrDefault(account => string.Equals(account.AccountCode, InitialAccountCode, StringComparison.OrdinalIgnoreCase));

            if (initial is not null)
            {
                return initial;
            }
        }

        return _accounts.First();
    }

    private async Task HandleAccountSelectedAsync(string accountCode)
    {
        _selectedAccount = _accounts.FirstOrDefault(account => string.Equals(account.AccountCode, accountCode, StringComparison.OrdinalIgnoreCase));
        _showMobileActionMenu = false;
        NormalizeSection();

        if (_selectedSection == CashManagerSection.Statement)
        {
            await ReloadStatementAsync();
        }
    }

    private async Task HandleSectionSelectedAsync(CashManagerSection section)
    {
        _selectedSection = section;
        _showMobileActionMenu = false;
        await RefreshAccountsAsync();
        NormalizeSection();

        if (_selectedSection == CashManagerSection.Statement)
        {
            await ReloadStatementAsync();
        }
    }

    private async Task OpenMobileStatementAsync()
    {
        await OpenMobileSectionAsync(CashManagerSection.Statement);
    }

    private async Task OpenPrimaryMobileActionAsync()
    {
        var primarySection = GetPrimaryMobileActionSection();

        if (!primarySection.HasValue)
        {
            return;
        }

        await OpenMobileSectionAsync(primarySection.Value);
    }

    private async Task OpenMobileSectionAsync(CashManagerSection section)
    {
        _selectedSection = section;
        _showMobileActionMenu = false;
        await RefreshAccountsAsync();
        NormalizeSection();

        if (_selectedSection == CashManagerSection.Statement)
        {
            await ReloadStatementAsync();
        }

        _mobileView = CashManagerMobileView.Detail;
    }

    private Task ToggleMobileActionMenuAsync()
    {
        _showMobileActionMenu = !_showMobileActionMenu;
        return Task.CompletedTask;
    }

    private Task NavigateToMobileTreeAsync()
    {
        _showMobileActionMenu = false;
        _mobileView = CashManagerMobileView.Tree;
        return Task.CompletedTask;
    }

    private async Task HandleYearSelectedAsync(short yearNumber)
    {
        _selectedYearNumber = yearNumber;
        await LoadPeriodsAsync(_selectedYearNumber);

        if (_selectedSection == CashManagerSection.Statement)
        {
            await ReloadStatementAsync();
        }
    }

    private async Task HandlePeriodSelectedAsync(DateTime? startOn)
    {
        _selectedPeriodStartOn = startOn;

        if (_selectedSection == CashManagerSection.Statement)
        {
            await ReloadStatementAsync();
        }
    }

    private async Task HandleAccountSavedAsync(string accountCode)
    {
        _selectedSection = CashManagerSection.CashAccounts;
        _showMobileActionMenu = false;
        await RefreshAccountsAsync(accountCode);
        NormalizeSection();

        if (_isMobile)
        {
            _mobileView = CashManagerMobileView.Detail;
        }

        StateHasChanged();
    }

    private async Task HandleAccountDeletedAsync(string accountCode)
    {
        _selectedSection = CashManagerSection.CashAccounts;
        _showMobileActionMenu = false;
        await RefreshAccountsAsync(accountCode);
        NormalizeSection();

        if (_isMobile)
        {
            _mobileView = CashManagerMobileView.Detail;
        }

        StateHasChanged();
    }

    private async Task HandleNamespaceFilterChangedAsync(string filterText)
    {
        var updatedFilter = filterText ?? string.Empty;
        var wasCleared = !string.IsNullOrWhiteSpace(_namespaceFilter)
            && string.IsNullOrWhiteSpace(updatedFilter);

        _namespaceFilter = updatedFilter;

        if (string.IsNullOrWhiteSpace(_namespaceFilter))
        {
            _namespaceSuggestions = Array.Empty<NamespaceSelectorSuggestion>();
            _isLoadingNamespaceSuggestions = false;
            await ReloadStatementAsync();
            return;
        }

        _isLoadingNamespaceSuggestions = true;
        StateHasChanged();

        try
        {
            _namespaceSuggestions = await SubjectBrowserService.GetNamespaceSuggestionsAsync(
                _namespaceFilter,
                NamespaceSuggestionPageSize);
        }
        finally
        {
            _isLoadingNamespaceSuggestions = false;
        }

        if (wasCleared)
        {
            await ReloadStatementAsync();
        }
    }

    private async Task HandleNamespaceFilterCommittedAsync(string filterText)
    {
        _namespaceFilter = filterText ?? string.Empty;
        await ReloadStatementAsync();
    }

    private async Task HandleCashCodeFilterCommittedAsync(string filterText)
    {
        _cashCodeFilter = filterText ?? string.Empty;
        await ReloadStatementAsync();
    }

    private async Task LoadPeriodsAsync(short? yearNumber)
    {
        if (!yearNumber.HasValue)
        {
            _periods = Array.Empty<CashManagerPeriodOption>();
            _selectedPeriodStartOn = null;
            return;
        }

        _periods = await CashManagerService.GetPeriodsAsync(yearNumber.Value);

        if (_periods.Count == 0)
        {
            _selectedPeriodStartOn = null;
            return;
        }

        if (_selectedPeriodStartOn.HasValue
            && _periods.Any(period => period.StartOn == _selectedPeriodStartOn.Value))
        {
            return;
        }

        _selectedPeriodStartOn = _periods[0].StartOn;
    }

    private async Task ReloadStatementAsync()
    {
        if (_selectedAccount is null || !_selectedYearNumber.HasValue)
        {
            _statement = CashManagerStatementResult.Empty;
            return;
        }

        _isLoadingStatement = true;
        _errorMessage = null;
        StateHasChanged();

        try
        {
            _statement = await CashStatementQueryService.GetStatementAsync(
                _selectedAccount.AccountCode,
                _selectedYearNumber.Value,
                _selectedPeriodStartOn,
                _namespaceFilter,
                _cashCodeFilter);
        }
        catch (Exception exception)
        {
            _statement = CashManagerStatementResult.Empty;
            _errorMessage = exception.Message;
        }
        finally
        {
            _isLoadingStatement = false;
        }
    }

    private void NormalizeSection()
    {
        if (_selectedAccount is null)
        {
            if (_selectedSection != CashManagerSection.CashAccounts)
            {
                _selectedSection = CashManagerSection.Statement;
            }

            return;
        }

        var availableSections = CashManagerSectionCatalog.GetSections(_selectedAccount.AccountType);

        if (!availableSections.Contains(_selectedSection))
        {
            _selectedSection = availableSections[0];
        }
    }

    private bool CanOpenMobileStatement()
    {
        return _selectedAccount is not null;
    }

    private bool CanOpenPrimaryMobileAction()
    {
        return GetPrimaryMobileActionSection().HasValue;
    }

    private bool CanOpenMobileMoreActions()
    {
        return GetMobileMenuSections().Count > 0;
    }

    private CashManagerSection? GetPrimaryMobileActionSection()
    {
        if (_selectedAccount is null)
        {
            return null;
        }

        return _selectedAccount.AccountType switch
        {
            NodeEnum.CashAccountType.Cash => CashManagerSection.Payments,
            NodeEnum.CashAccountType.Asset => CashManagerSection.Assets,
            NodeEnum.CashAccountType.Dummy => CashManagerSection.Payments,
            _ => null
        };
    }

    private IReadOnlyList<CashManagerSection> GetMobileMenuSections()
    {
        if (_selectedAccount is null)
        {
            return new[] { CashManagerSection.CashAccounts };
        }

        var primarySection = GetPrimaryMobileActionSection();

        return CashManagerSectionCatalog.GetSections(_selectedAccount.AccountType)
            .Where(section =>
                section != CashManagerSection.Statement
                && (!primarySection.HasValue || section != primarySection.Value))
            .ToArray();
    }

    private string GetPrimaryMobileActionLabel()
    {
        var primarySection = GetPrimaryMobileActionSection();

        return primarySection.HasValue
            ? CashManagerSectionCatalog.GetLabel(primarySection.Value)
            : "Action";
    }

    private string GetPrimaryMobileActionIconClass()
    {
        var primarySection = GetPrimaryMobileActionSection();

        return primarySection switch
        {
            CashManagerSection.Payments => "bi-cash-stack",
            CashManagerSection.Assets => "bi-box-seam",
            CashManagerSection.Transfers => "bi-arrow-left-right",
            _ => "bi-grid"
        };
    }

    private string GetMobileActionTitle()
    {
        return _selectedAccount?.AccountName ?? "Cash Manager";
    }

    private string GetMobileActionSubtitle()
    {
        if (_selectedAccount is null)
        {
            return _accounts.Count == 0
                ? "No cash accounts available"
                : "Select an account, then choose an action";
        }

        return $"{_selectedAccount.AccountCode} • {CashManagerSectionCatalog.GetLabel(_selectedSection)}";
    }

    private string GetMobileDetailHeader()
    {
        return CashManagerSectionCatalog.GetLabel(_selectedSection);
    }

    private string GetMobileDetailSubtitle()
    {
        if (_selectedAccount is null)
        {
            return "Create and maintain cash accounts within Cash Manager.";
        }

        return $"{_selectedAccount.AccountName} • {_selectedAccount.AccountCode}";
    }

    private string GetSubtitle()
    {
        if (_selectedAccount is null)
        {
            return _selectedSection == CashManagerSection.CashAccounts
                ? "Create and maintain cash accounts within Cash Manager."
                : "Select an account to begin the namespace-aware cash workflow.";
        }

        var yearLabel = CashManagerSectionCatalog.GetYearLabel(_years, _selectedYearNumber);
        var periodLabel = CashManagerSectionCatalog.GetPeriodScopeLabel(_periods, _selectedPeriodStartOn);
        return $"{_selectedAccount.AccountName} • {yearLabel} • {periodLabel}";
    }
}
