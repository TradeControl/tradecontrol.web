private async Task ReloadStatementAsync()
{
    if (Account is null)
    {
        _currentStatement = CashManagerStatementResult.Empty;
        return;
    }

    _currentStatement = await CashStatementQueryService.GetStatementAsync(
        Account.AccountCode,
        SelectedYearNumber.GetValueOrDefault(),
        SelectedPeriodStartOn,
        NamespaceFilter);
}

private string GetSortIconClass(CashManagerStatementSortColumn column)
{
    if (_sortColumn != column)
    {
        return "bi-arrow-down-up";
    }

    return _sortDescending
        ? "bi-sort-down"
        : "bi-sort-up";
}

private string GetSelectedPeriodValue()
{
    return SelectedPeriodStartOn?.ToString("O", CultureInfo.InvariantCulture) ?? string.Empty;
}

private Task ToggleHeaderAsync()
{
    _isHeaderExpanded = !_isHeaderExpanded;
    return Task.CompletedTask;
}

private Task ToggleSortAsync(CashManagerStatementSortColumn column)
{
    if (_sortColumn == column)
    {
        _sortDescending = !_sortDescending;
    }
    else
    {
        _sortColumn = column;
        _sortDescending = column == CashManagerStatementSortColumn.EntryNumber
            || column == CashManagerStatementSortColumn.PaidOn
            || column == CashManagerStatementSortColumn.RunningBalance;
    }

    return Task.CompletedTask;
}

private async Task HandleYearChangedAsync(ChangeEventArgs args)
{
    if (short.TryParse(args.Value?.ToString(), out var yearNumber))
    {
        await OnYearSelected.InvokeAsync(yearNumber);
        return;
    }

    await OnYearSelected.InvokeAsync(0);
}

private async Task HandlePeriodChangedAsync(ChangeEventArgs args)
{
    var value = args.Value?.ToString();

    if (string.IsNullOrWhiteSpace(value))
    {
        await OnPeriodSelected.InvokeAsync(null);
        return;
    }

    if (DateTime.TryParse(
        value,
        CultureInfo.InvariantCulture,
        DateTimeStyles.RoundtripKind,
        out var startOn))
    {
        await OnPeriodSelected.InvokeAsync(startOn);
    }
}

private Task OnFilterChangedAsync(string filterText)
{
    return OnNamespaceFilterChanged.InvokeAsync(filterText);
}

private Task OnFilterCommittedAsync(string filterText)
{
    return OnNamespaceFilterCommitted.InvokeAsync(filterText);
}
}
