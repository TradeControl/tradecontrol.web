private Task HandleSelectPostedPaymentAsync(CashManagerPostedPaymentSearchResult payment)
{
    _selectedPostedPayment = payment;
    _selectedReversalPayment = null;
    ApplySourcePaymentSelection(payment, false);
    return Task.CompletedTask;
}

private Task HandleSelectReversalPaymentAsync(CashManagerPostedPaymentSearchResult payment)
{
    _selectedReversalPayment = payment;
    _selectedPostedPayment = null;
    ApplySourcePaymentSelection(payment, true);
    return Task.CompletedTask;
}

private void ApplySourcePaymentSelection(CashManagerPostedPaymentSearchResult payment, bool forceReversalSeries)
{
    var sourceReference = string.IsNullOrWhiteSpace(payment.PaymentReference)
        ? payment.PaymentCode
        : payment.PaymentReference;

    _workspace.Draft.PaidOn = payment.PaidOn;
    _workspace.Draft.GenerateReversalSeries = forceReversalSeries || payment.DeltaValue < 0m;

    if (forceReversalSeries)
    {
        _workspace.Draft.NamespaceFilter = payment.SubjectCode ?? string.Empty;
        _workspace.Draft.SubjectCode = payment.SubjectCode ?? string.Empty;
        _workspace.Draft.SubjectName = payment.SubjectName ?? string.Empty;
        _workspace.Draft.CashCode = payment.CashCode ?? string.Empty;
        _workspace.Draft.TaxCode = string.Empty;
        _workspace.Draft.PaymentReference = $"Write off - {sourceReference}";
        _workspace.Draft.ReversalPeriods = 5;
        _workspace.Draft.ReversalIntervalMonths = 12;
    }
    else
    {
        _workspace.Draft.PaymentReference = sourceReference;
    }

    if (payment.DeltaValue < 0m)
    {
        _workspace.Draft.PaidInValue = Math.Abs(payment.DeltaValue);
        _workspace.Draft.PaidOutValue = 0m;
    }
    else
    {
        _workspace.Draft.PaidOutValue = Math.Abs(payment.DeltaValue);
        _workspace.Draft.PaidInValue = 0m;
    }

    var candidateCashCodes = GetCashCodesForSourcePayment(payment);

    if (string.IsNullOrWhiteSpace(_workspace.Draft.CashCode)
        || !candidateCashCodes.Any(item => string.Equals(item.CashCode, _workspace.Draft.CashCode, StringComparison.OrdinalIgnoreCase)))
    {
        _workspace.Draft.CashCode = payment.CashCode ?? string.Empty;
        _workspace.Draft.TaxCode = string.Empty;
    }
}

private Task HandleEditAsync(CashManagerAssetRow row)
{
    _editingPaymentCode = row.PaymentCode;
    _mode = AssetEntryMode.Freehand;
    _isModePanelCollapsed = false;
    _scrollEntryWorkspaceIntoView = true;
    _message = null;
    _errorMessage = null;
    _selectedPostedPayment = null;
    _selectedReversalPayment = null;

    _workspace.Draft.NamespaceFilter = row.SubjectCode;
    _workspace.Draft.SubjectCode = row.SubjectCode;
    _workspace.Draft.SubjectName = row.SubjectName;
    _workspace.Draft.PaidOn = row.PaidOn;
    _workspace.Draft.CashCode = row.CashCode;
    _workspace.Draft.TaxCode = string.Empty;
    _workspace.Draft.PaymentReference = row.PaymentReference;
    _workspace.Draft.PaidOutValue = row.PaidOutValue;
    _workspace.Draft.PaidInValue = row.PaidInValue;
    _workspace.Draft.GenerateReversalSeries = false;

    return Task.CompletedTask;
}

private async Task HandleCancelEditAsync()
{
    if (SelectedAccount is null)
    {
        return;
    }

    await LoadWorkspaceAsync(SelectedAccount.AccountCode);
}

private async Task HandleAddFreehandAsync()
{
    if (SelectedAccount is null || string.IsNullOrWhiteSpace(_currentAspNetUserId))
    {
        return;
    }

    _message = null;
    _errorMessage = null;

    try
    {
        _isBusy = true;

        if (string.IsNullOrWhiteSpace(_editingPaymentCode))
        {
            await CashAssetsWorkspaceService.AddFreehandAsync(
                SelectedAccount.AccountCode,
                _workspace.Draft,
                _currentAspNetUserId);

            _message = "Asset transaction added.";
        }
        else
        {
            await CashAssetsWorkspaceService.UpdateAsync(
                _editingPaymentCode,
                SelectedAccount.AccountCode,
                _workspace.Draft,
                _currentAspNetUserId,
                _isPrivileged);

            _message = "Asset transaction updated.";
        }

        await LoadWorkspaceAsync(SelectedAccount.AccountCode);
    }
    catch (Exception exception)
    {
        _errorMessage = exception.Message;
    }
    finally
    {
        _isBusy = false;
    }
}

