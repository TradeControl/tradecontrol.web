            @buttonText
        </button>
    </div>
</div>;

private IReadOnlyList<CashManagerAssetCodeOption> GetCashCodesForSourcePayment(CashManagerPostedPaymentSearchResult? payment)
{
    if (payment is null)
    {
        return _workspace.CashCodes;
    }

    var requiredPolarityCode = payment.DeltaValue < 0m
        ? (short)NodeEnum.CashPolarity.Income
        : (short)NodeEnum.CashPolarity.Expense;

    var cashCodes = _workspace.CashCodes
        .Where(item =>
            item.CashPolarityCode == (short)NodeEnum.CashPolarity.Neutral
            || item.CashPolarityCode == requiredPolarityCode)
        .ToList();

    if (!string.IsNullOrWhiteSpace(payment.CashCode)
        && !cashCodes.Any(item => string.Equals(item.CashCode, payment.CashCode, StringComparison.OrdinalIgnoreCase)))
    {
        cashCodes.Insert(0, new CashManagerAssetCodeOption(
            payment.CashCode,
            payment.CashDescription,
            string.Empty,
            string.Empty,
            requiredPolarityCode));
    }

    return cashCodes;
}

private string GetModeButtonClass(AssetEntryMode mode)
{
    return _mode == mode ? "btn-primary" : "btn-outline-primary";
}

private string GetEntryWorkspaceHostStyle()
{
    if (_isModePanelCollapsed)
    {
        return "flex:0 0 auto; overflow:hidden;";
    }

    return $"height:{_entryWorkspaceHeightPx:0}px; min-height:{MinimumEntryWorkspaceHeightPx:0}px; max-height:{MaximumEntryWorkspaceHeightPx:0}px; flex:0 0 auto; overflow:hidden;";
}

private string GetRootUserSelectStyle()
{
    return _isResizingEntryWorkspace ? "user-select:none;" : string.Empty;
}

private void SetMode(AssetEntryMode mode)
{
    _mode = mode;
    _message = null;
    _errorMessage = null;
}

private void ToggleModePanel()
{
    _isModePanelCollapsed = !_isModePanelCollapsed;
    _isResizingEntryWorkspace = false;
}

private Task HandleSplitterPointerDownAsync(PointerEventArgs args)
{
    if (_isModePanelCollapsed)
    {
        return Task.CompletedTask;
    }

    _isResizingEntryWorkspace = true;
    _lastPointerClientY = args.ClientY;
    return Task.CompletedTask;
}

private Task HandleSplitterPointerMoveAsync(PointerEventArgs args)
{
    if (!_isResizingEntryWorkspace)
    {
        return Task.CompletedTask;
    }

    var delta = args.ClientY - _lastPointerClientY;

    if (Math.Abs(delta) < double.Epsilon)
    {
        return Task.CompletedTask;
    }

    _entryWorkspaceHeightPx = Math.Clamp(
        _entryWorkspaceHeightPx + delta,
        MinimumEntryWorkspaceHeightPx,
        MaximumEntryWorkspaceHeightPx);

    _lastPointerClientY = args.ClientY;
    return InvokeAsync(StateHasChanged);
}

private Task HandleSplitterPointerUpAsync(PointerEventArgs args)
{
    _isResizingEntryWorkspace = false;
    return Task.CompletedTask;
}

private async Task HandleNamespaceFilterChangedAsync(string filterText)
{
    _workspace.Draft.NamespaceFilter = filterText ?? string.Empty;

    if (string.IsNullOrWhiteSpace(_workspace.Draft.NamespaceFilter))
    {
        _namespaceSuggestions = Array.Empty<NamespaceSelectorSuggestion>();
        _workspace.Draft.SubjectCode = string.Empty;
        _workspace.Draft.SubjectName = string.Empty;
        _isLoadingNamespaceSuggestions = false;
        return;
    }

    _isLoadingNamespaceSuggestions = true;

    try
    {
        _namespaceSuggestions = await SubjectBrowserService.GetNamespaceSuggestionsAsync(
            _workspace.Draft.NamespaceFilter,
            NamespaceSuggestionPageSize);
    }
    finally
    {
        _isLoadingNamespaceSuggestions = false;
    }
}

private async Task HandleNamespaceCommittedAsync(string filterText)
{
    _workspace.Draft.NamespaceFilter = filterText ?? string.Empty;

    if (string.IsNullOrWhiteSpace(_workspace.Draft.NamespaceFilter))
    {
        _workspace.Draft.SubjectCode = string.Empty;
        _workspace.Draft.SubjectName = string.Empty;
        return;
    }

    try
    {
        var subject = await CashAssetsWorkspaceService.ResolveSubjectAsync(_workspace.Draft.NamespaceFilter);
        _workspace.Draft.SubjectCode = subject.SubjectCode;
        _workspace.Draft.SubjectName = subject.SubjectName;
        _workspace.Draft.NamespaceFilter = subject.NamespaceFilter;
        _errorMessage = null;
    }
    catch (Exception exception)
    {
        _errorMessage = exception.Message;
    }
}

