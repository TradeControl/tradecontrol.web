            </div>

            <div class="col-12 col-md-4">
                <label class="form-label small text-muted mb-1" for="assetSourceReversalInterval">Interval (months)</label>
                <InputNumber id="assetSourceReversalInterval"
                             class="form-control"
                             @bind-Value="_workspace.Draft.ReversalIntervalMonths" />
            </div>

            <div class="col-12 col-md-4">
                <label class="form-label small text-muted mb-1" for="assetSourceReversalStartOn">Start On</label>
                <InputDate id="assetSourceReversalStartOn"
                           class="form-control"
                           @bind-Value="_workspace.Draft.ReversalStartOn" />
