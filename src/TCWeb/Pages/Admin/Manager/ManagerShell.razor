@using Microsoft.AspNetCore.Components
@using Microsoft.JSInterop
@using TradeControl.Web.AppServices
@using TradeControl.Web.Pages.Admin.Manager.Components

@inject Wangkanai.Detection.Services.IDetectionService Detection

<div class="tc-tree-manager">
    <div class="tc-tree-manager-frame border rounded bg-white p-2">
        @if (_isMobile)
        {
            @if (_selected == ManagerTreeHost.ManagerNode.EventViewer)
            {
                <div class="d-flex flex-column" style="min-height:0; height:100%;">
                    <div class="d-flex align-items-center justify-content-between mb-2">
                        <button type="button"
                                class="tc-back-btn"
                                @onclick="NavigateToMobileTreeAsync">
                            <i class="bi bi-arrow-left me-1" aria-hidden="true"></i>Back
                        </button>

                        <div class="fw-semibold text-truncate ms-2">@RightHeader</div>
                    </div>

                    <div class="flex-grow-1 border rounded bg-light p-2 d-flex flex-column" style="min-height:0;">
                        <EventViewerPanel IsMobile="true"
                                          InitialEventType="@_initialEventType" />
                    </div>
                </div>
            }
            else if (_selected == ManagerTreeHost.ManagerNode.Setup)
            {
                <div class="d-flex flex-column" style="min-height:0; height:100%;">
                    <div class="d-flex align-items-center justify-content-between mb-2">
                        <button type="button"
                                class="tc-back-btn"
                                @onclick="NavigateToMobileTreeAsync">
                            <i class="bi bi-arrow-left me-1" aria-hidden="true"></i>Back
                        </button>

                        <div class="fw-semibold text-truncate ms-2">@RightHeader</div>
                    </div>

                    <div class="flex-grow-1 border rounded bg-light p-2 d-flex flex-column" style="min-height:0;">
                        <SetupPanel />
                    </div>
                </div>
            }
            else if (_selected == ManagerTreeHost.ManagerNode.Users)
            {
                <div class="d-flex flex-column" style="min-height:0; height:100%;">
                    <div class="d-flex align-items-center justify-content-between mb-2">
                        <button type="button"
                                class="tc-back-btn"
                                @onclick="NavigateToMobileTreeAsync">
                            <i class="bi bi-arrow-left me-1" aria-hidden="true"></i>Back
                        </button>

                        <div class="fw-semibold text-truncate ms-2">@RightHeader</div>
                    </div>

                    <div class="flex-grow-1 border rounded bg-light p-2 d-flex flex-column" style="min-height:0;">
                        <UsersPanel IsMobile="true" />
                    </div>
                </div>
            }
            else if (_selected == ManagerTreeHost.ManagerNode.Periods)
            {
                <div class="d-flex flex-column" style="min-height:0; height:100%;">
                    <div class="d-flex align-items-center justify-content-between mb-2">
                        <button type="button"
                                class="tc-back-btn"
                                @onclick="NavigateToMobileTreeAsync">
                            <i class="bi bi-arrow-left me-1" aria-hidden="true"></i>Back
                        </button>

                        <div class="fw-semibold text-truncate ms-2">@RightHeader</div>
                    </div>

                    <div class="flex-grow-1 border rounded bg-light p-2 d-flex flex-column" style="min-height:0;">
                        <PeriodsPanel IsMobile="true" />
                    </div>
                </div>
            }
            else if (_selected == ManagerTreeHost.ManagerNode.TaxSettings)
            {
                <div class="d-flex flex-column" style="min-height:0; height:100%;">
                    <div class="d-flex align-items-center justify-content-between mb-2">
                        <button type="button"
                                class="tc-back-btn"
                                @onclick="NavigateToMobileTreeAsync">
                            <i class="bi bi-arrow-left me-1" aria-hidden="true"></i>Back
                        </button>

                        <div class="fw-semibold text-truncate ms-2">@RightHeader</div>
                    </div>

                    <div class="flex-grow-1 border rounded bg-light p-2 d-flex flex-column" style="min-height:0;">
                        <TaxSettingsPanel IsMobile="true" />
                    </div>
                </div>
            }
            else if (_selected == ManagerTreeHost.ManagerNode.TaxCode)
            {
                <div class="d-flex flex-column" style="min-height:0; height:100%;">
                    <div class="d-flex align-items-center justify-content-between mb-2">
                        <button type="button"
                                class="tc-back-btn"
                                @onclick="NavigateToMobileTreeAsync">
                            <i class="bi bi-arrow-left me-1" aria-hidden="true"></i>Back
                        </button>

                        <div class="fw-semibold text-truncate ms-2">@RightHeader</div>
                    </div>

                    <div class="flex-grow-1 border rounded bg-light p-2 d-flex flex-column" style="min-height:0;">
                        <TaxCodePanel IsMobile="true" />
                    </div>
                </div>
            }
            else if (_selected == ManagerTreeHost.ManagerNode.TaxRates)
            {
                <div class="d-flex flex-column" style="min-height:0; height:100%;">
                    <div class="d-flex align-items-center justify-content-between mb-2">
                        <button type="button"
                                class="tc-back-btn"
                                @onclick="NavigateToMobileTreeAsync">
                            <i class="bi bi-arrow-left me-1" aria-hidden="true"></i>Back
                        </button>

                        <div class="fw-semibold text-truncate ms-2">@RightHeader</div>
                    </div>

                    <div class="flex-grow-1 border rounded bg-light p-2 d-flex flex-column" style="min-height:0;">
                        <TaxRatesPanel IsMobile="true" />
                    </div>
                </div>
            }
            else if (_selected == ManagerTreeHost.ManagerNode.Host)
            {
                <div class="d-flex flex-column" style="min-height:0; height:100%;">
                    <div class="d-flex align-items-center justify-content-between mb-2">
                        <button type="button"
                                class="tc-back-btn"
                                @onclick="NavigateToMobileTreeAsync">
                            <i class="bi bi-arrow-left me-1" aria-hidden="true"></i>Back
                        </button>

                        <div class="fw-semibold text-truncate ms-2">@RightHeader</div>
                    </div>

                    <div class="flex-grow-1 border rounded bg-light p-2 d-flex flex-column" style="min-height:0;">
                        <HostPanel IsMobile="true" />
                    </div>
                </div>
            }
            else if (_selected == ManagerTreeHost.ManagerNode.SubjectType)
            {
                <div class="d-flex flex-column" style="min-height:0; height:100%;">
                    <div class="d-flex align-items-center justify-content-between mb-2">
                        <button type="button"
                                class="tc-back-btn"
                                @onclick="NavigateToMobileTreeAsync">
                            <i class="bi bi-arrow-left me-1" aria-hidden="true"></i>Back
                        </button>

                        <div class="fw-semibold text-truncate ms-2">@RightHeader</div>
                    </div>

                    <div class="flex-grow-1 border rounded bg-light p-2 d-flex flex-column" style="min-height:0;">
                        <SubjectTypePanel IsMobile="true" />
                    </div>
                </div>
            }
            else if (_selected == ManagerTreeHost.ManagerNode.InvoiceSettings)
            {
                <div class="d-flex flex-column" style="min-height:0; height:100%;">
                    <div class="d-flex align-items-center justify-content-between mb-2">
                        <button type="button"
                                class="tc-back-btn"
                                @onclick="NavigateToMobileTreeAsync">
                            <i class="bi bi-arrow-left me-1" aria-hidden="true"></i>Back
                        </button>

                        <div class="fw-semibold text-truncate ms-2">@RightHeader</div>
                    </div>

                    <div class="flex-grow-1 border rounded bg-light p-2 d-flex flex-column" style="min-height:0;">
                        <InvoiceSettingsPanel IsMobile="true" />
                    </div>
                </div>
            }
            else if (_selected == ManagerTreeHost.ManagerNode.DemoData)
            {
                <div class="d-flex flex-column" style="min-height:0; height:100%;">
                    <div class="d-flex align-items-center justify-content-between mb-2">
                        <button type="button"
                                class="tc-back-btn"
                                @onclick="NavigateToMobileTreeAsync">
                            <i class="bi bi-arrow-left me-1" aria-hidden="true"></i>Back
                        </button>

                        <div class="fw-semibold text-truncate ms-2">@RightHeader</div>
                    </div>

                    <div class="flex-grow-1 border rounded bg-light p-2 d-flex flex-column" style="min-height:0;">
                        <DemoDataPanel />
                    </div>
                </div>
            }
            else if (_selected == ManagerTreeHost.ManagerNode.FileTransfer || _selected == ManagerTreeHost.ManagerNode.FileTransferContentType)
            {
                <div class="d-flex flex-column" style="min-height:0; height:100%;">
                    <div class="d-flex align-items-center justify-content-between mb-2">
                        <button type="button"
                                class="tc-back-btn"
                                @onclick="NavigateToMobileTreeAsync">
                            <i class="bi bi-arrow-left me-1" aria-hidden="true"></i>Back
                        </button>

                        <div class="fw-semibold text-truncate ms-2">@RightHeader</div>
                    </div>

                    <div class="flex-grow-1 border rounded bg-light p-2 d-flex flex-column" style="min-height:0;">
                        <FileTransferPanel IsMobile="true"
                                           InitialContentType="@_selectedContentType" />
                    </div>
                </div>
            }
            else if (_selected == ManagerTreeHost.ManagerNode.TemplateInvoices)
            {
                <div class="d-flex flex-column" style="min-height:0; height:100%;">
                    <div class="d-flex align-items-center justify-content-between mb-2">
                        <button type="button"
                                class="tc-back-btn"
                                @onclick="NavigateToMobileTreeAsync">
                            <i class="bi bi-arrow-left me-1" aria-hidden="true"></i>Back
                        </button>

                        <div class="fw-semibold text-truncate ms-2">@RightHeader</div>
                    </div>

                    <div class="flex-grow-1 border rounded bg-light p-2 d-flex flex-column" style="min-height:0;">
                        <TemplateInvoicesPanel IsMobile="true"
                                               InitialTemplateKey="@_initialTemplateKey"
                                               Selection="@_templateSelection"
                                               OnTemplatesChanged="RefreshTemplateInvoicesTreeAsync" />
                    </div>
                </div>
            }
            else if (_selected == ManagerTreeHost.ManagerNode.TemplateSystem)
            {
                <div class="d-flex flex-column" style="min-height:0; height:100%;">
                    <div class="d-flex align-items-center justify-content-between mb-2">
                        <button type="button"
                                class="tc-back-btn"
                                @onclick="NavigateToMobileTreeAsync">
                            <i class="bi bi-arrow-left me-1" aria-hidden="true"></i>Back
                        </button>

                        <div class="fw-semibold text-truncate ms-2">@RightHeader</div>
                    </div>

                    <div class="flex-grow-1 border rounded bg-light p-2 d-flex flex-column" style="min-height:0;">
                        <TemplateSystemPanel IsMobile="true" />
                    </div>
                </div>
            }
            else
            {
                <div class="d-flex flex-column" style="min-height:0; height:100%;">
                    <div class="flex-grow-1 border rounded bg-white p-2" style="min-height:0;">
                        <ManagerTreeHost @ref="_treeHost"
                                         RootLabel="@_companyName"
                                         IsMobile="true"
                                         InitialSelectedNode="@_selected"
                                         InitialContentType="@_selectedContentType"
                                         InitialTemplateKey="@_initialTemplateKey"
                                         OnNodeSelected="HandleNodeSelectedAsync"
                                         OnNodeSelectedEx="HandleNodeSelectedExAsync"
                                         OnTreeAction="HandleTreeActionAsync"
                                         OnTemplateSelection="HandleTemplateSelectionAsync" />
                    </div>
                </div>
            }
        }
        else
        {
            <div class="tc-tree-split">
                <div id="leftCol" class="tc-pane tc-initial-left">
                    <div class="flex-grow-1 border rounded p-2 bg-white" style="min-height:220px;">
                        <ManagerTreeHost @ref="_treeHost"
                                         RootLabel="@_companyName"
                                         IsMobile="false"
                                         InitialSelectedNode="@_selected"
                                         InitialContentType="@_selectedContentType"
                                         InitialTemplateKey="@_initialTemplateKey"
                                         OnNodeSelected="HandleNodeSelectedAsync"
                                         OnNodeSelectedEx="HandleNodeSelectedExAsync"
                                         OnTreeAction="HandleTreeActionAsync"
                                         OnTemplateSelection="HandleTemplateSelectionAsync" />
                    </div>
                </div>

                <div id="rightCol" class="tc-pane tc-initial-right d-none d-lg-flex">
                    <div class="flex-grow-1 border rounded p-2 bg-light d-flex flex-column">
                        <div class="d-flex align-items-center justify-content-between mb-2">
                            <div class="fw-semibold">
                                <i class="bi bi-building me-2" aria-hidden="true"></i>@RightHeader
                            </div>
                        </div>

                        @RenderRightPane()
                    </div>
                </div>
            </div>
        }
    </div>
</div>

@code {
    [Parameter] public string CompanyName { get; set; } = "Business";

    private bool _isMobile;
    private string _companyName = "Business";
    private ManagerTreeHost.ManagerNode _selected = ManagerTreeHost.ManagerNode.Root;
    private ManagerTreeHost.ManagerNode? _mobileReturnNode;
    private string? _selectedContentType;
    private string? _iframeSrc;
    private string? _initialTemplateKey;
    private short? _initialEventType;
    private int _fileTransferPageSize = 25;

    private ManagerTreeHost.TemplateSelection? _templateSelection;

    private string RightHeader => _selected switch
    {
        ManagerTreeHost.ManagerNode.Root => _companyName,
        ManagerTreeHost.ManagerNode.Setup => $"{_companyName} / Setup",
        ManagerTreeHost.ManagerNode.DemoData => $"{_companyName} / Synthetic Demo Data",
        ManagerTreeHost.ManagerNode.FileTransfer => $"{_companyName} / File Transfer",
        ManagerTreeHost.ManagerNode.FileTransferContentType => $"{_companyName} / File Transfer / {_selectedContentType}",
        ManagerTreeHost.ManagerNode.Host => $"{_companyName} / Mail Host",
        ManagerTreeHost.ManagerNode.Users => $"{_companyName} / Users",
        ManagerTreeHost.ManagerNode.Templates => $"{_companyName} / Templates",
        ManagerTreeHost.ManagerNode.TemplateInvoices => $"{_companyName} / Templates / Invoices",
        ManagerTreeHost.ManagerNode.TemplateSystem => $"{_companyName} / Templates / System",
        ManagerTreeHost.ManagerNode.Periods => $"{_companyName} / Financial Periods",
        ManagerTreeHost.ManagerNode.TaxSettings => $"{_companyName} / Tax Settings",
        ManagerTreeHost.ManagerNode.TaxCode => $"{_companyName} / Tax Codes",
        ManagerTreeHost.ManagerNode.TaxRates => $"{_companyName} / Tax Rates & Adjustments",
        ManagerTreeHost.ManagerNode.InvoiceSettings => $"{_companyName} / Invoice Settings",
        ManagerTreeHost.ManagerNode.SubjectType => $"{_companyName} / Subject Types",
        ManagerTreeHost.ManagerNode.EventViewer => $"{_companyName} / Diagnostics / Event Viewer",
        _ => _companyName
    };

    private RenderFragment RenderRightPane() => _selected switch
    {
        ManagerTreeHost.ManagerNode.Root => RenderRootSummaryPane(),
        ManagerTreeHost.ManagerNode.Templates => RenderTemplatesSummaryPane(),

        ManagerTreeHost.ManagerNode.EventViewer =>
            @<div class="bg-white border rounded p-2 d-flex flex-column h-100" style="min-height:0;">
    <EventViewerPanel IsMobile="false"
                      InitialEventType="@_initialEventType" />
</div>,

        ManagerTreeHost.ManagerNode.Setup =>
            @<div class="bg-white border rounded p-2 d-flex flex-column h-100" style="min-height:0;">
    <SetupPanel />
</div>,

        ManagerTreeHost.ManagerNode.DemoData =>
            @<div class="bg-white border rounded p-2 d-flex flex-column h-100" style="min-height:0;">
    <DemoDataPanel />
</div>,

        ManagerTreeHost.ManagerNode.FileTransfer =>
            @<div class="bg-white border rounded p-2 d-flex flex-column h-100" style="min-height:0;">
    <FileTransferPanel IsMobile="false"
                       InitialContentType="@_selectedContentType" />
</div>,

        ManagerTreeHost.ManagerNode.FileTransferContentType =>
            @<div class="bg-white border rounded p-2 d-flex flex-column h-100" style="min-height:0;">
    <FileTransferPanel IsMobile="false"
                       InitialContentType="@_selectedContentType" />
</div>,

        ManagerTreeHost.ManagerNode.TemplateInvoices =>
            @<div class="bg-white border rounded p-2 d-flex flex-column h-100" style="min-height:0;">
    <TemplateInvoicesPanel IsMobile="false"
                           InitialTemplateKey="@_initialTemplateKey"
                           Selection="@_templateSelection"
                           OnTemplatesChanged="RefreshTemplateInvoicesTreeAsync" />
</div>,

        ManagerTreeHost.ManagerNode.TemplateSystem =>
            @<div class="bg-white border rounded p-2 d-flex flex-column h-100" style="min-height:0;">
    <TemplateSystemPanel IsMobile="false" />
</div>,

        ManagerTreeHost.ManagerNode.Users =>
            @<div class="bg-white border rounded p-2 d-flex flex-column h-100" style="min-height:0;">
    <UsersPanel IsMobile="false" />
</div>,

        ManagerTreeHost.ManagerNode.Periods =>
            @<div class="bg-white border rounded p-2 d-flex flex-column h-100" style="min-height:0;">
    <PeriodsPanel IsMobile="false" />
</div>,

        ManagerTreeHost.ManagerNode.TaxSettings =>
            @<div class="bg-white border rounded p-2 d-flex flex-column h-100" style="min-height:0;">
    <TaxSettingsPanel IsMobile="false" />
</div>,

        ManagerTreeHost.ManagerNode.TaxCode =>
            @<div class="bg-white border rounded p-2 d-flex flex-column h-100" style="min-height:0;">
    <TaxCodePanel IsMobile="false" />
</div>,

        ManagerTreeHost.ManagerNode.TaxRates =>
            @<div class="bg-white border rounded p-2 d-flex flex-column h-100" style="min-height:0;">
    <TaxRatesPanel IsMobile="false" />
</div>,

        ManagerTreeHost.ManagerNode.Host =>
            @<div class="bg-white border rounded p-2 d-flex flex-column h-100" style="min-height:0;">
    <HostPanel IsMobile="false" />
</div>,

        ManagerTreeHost.ManagerNode.SubjectType =>
            @<div class="bg-white border rounded p-2 d-flex flex-column h-100" style="min-height:0;">
    <SubjectTypePanel IsMobile="false" />
</div>,

        ManagerTreeHost.ManagerNode.InvoiceSettings =>
            @<div class="bg-white border rounded p-2 d-flex flex-column h-100" style="min-height:0;">
    <InvoiceSettingsPanel IsMobile="false" />
</div>,

        _ when !string.IsNullOrWhiteSpace(_iframeSrc) =>
            @<iframe class="w-100 border rounded bg-white tc-details-frame"
                     title="Details"
                     src="@_iframeSrc"></iframe>,

        _ => RenderRootSummaryPane()
    };

    private RenderFragment RenderRootSummaryPane() => @<div class="bg-white border rounded p-3">
        <div class="small text-uppercase text-muted mb-2" style="letter-spacing:0.06em;">Admin Manager</div>
        <p class="text-muted mb-0">
            Select a section from the tree to configure company settings, documents, tax, classifications, and diagnostics.
        </p>
    </div>;

    private RenderFragment RenderTemplatesSummaryPane() => @<div class="bg-white border rounded p-3">
        <h2 class="h6 mb-2">Templates</h2>
        <p class="text-muted mb-0">
            Templates are HTML documents that include tags like <code>[CompanyName]</code> and <code>[InvoiceDetails]</code>.
            When an email is sent, Trade Control replaces tags with data from the relevant document and embeds any referenced images.
        </p>
    </div>;

    [Inject] private NavigationManager NavigationManager { get; set; } = default!;
    [Inject] private IJSRuntime JSRuntime { get; set; } = default!;

    private ManagerTreeHost? _treeHost;
    private DotNetObjectReference<ManagerShell>? _dotNetRef;

    protected override void OnParametersSet()
    {
        _companyName = CompanyName;
        _isMobile = Detection?.Device?.Type == Wangkanai.Detection.Models.Device.Mobile;
        _mobileReturnNode = null;
        _initialEventType = null;

        var uri = NavigationManager.ToAbsoluteUri(NavigationManager.Uri);
        var qs = Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(uri.Query);

        if (qs.TryGetValue("node", out var nodeValue))
        {
            if (Enum.TryParse<ManagerTreeHost.ManagerNode>(nodeValue.ToString(), ignoreCase: true, out var node))
                _selected = node;
        }

        if (qs.TryGetValue("returnNode", out var returnNodeValue))
        {
            if (Enum.TryParse<ManagerTreeHost.ManagerNode>(returnNodeValue.ToString(), ignoreCase: true, out var returnNode))
                _mobileReturnNode = returnNode;
        }

        if (qs.TryGetValue("eventType", out var eventTypeValue)
            && short.TryParse(eventTypeValue.ToString(), out var eventTypeCode))
        {
            _initialEventType = eventTypeCode;
        }

        if (qs.TryGetValue("pageSize", out var pageSizeValue))
        {
            if (int.TryParse(pageSizeValue.ToString(), out var ps) && ps > 0)
                _fileTransferPageSize = ps;
        }

        if (qs.TryGetValue("contentType", out var ct))
            _selectedContentType = ct.ToString();
        else if (_selected != ManagerTreeHost.ManagerNode.FileTransferContentType)
            _selectedContentType = null;

        if (qs.TryGetValue("templateKey", out var tk))
            _initialTemplateKey = tk.ToString();
        else
            _initialTemplateKey = null;

        _iframeSrc = null;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !_isMobile)
        {
            _dotNetRef = DotNetObjectReference.Create(this);
            await JSRuntime.InvokeVoidAsync("adminManager.registerTemplateRefreshListener", _dotNetRef);

            await JSRuntime.InvokeVoidAsync("adminManager.initSplit");
            await RefreshFileTransferPageSizeAsync();

            StateHasChanged();
        }
    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            if (!_isMobile)
                await JSRuntime.InvokeVoidAsync("adminManager.unregisterTemplateRefreshListener");
        }
        catch
        {
        }

        _dotNetRef?.Dispose();
    }

    [JSInvokable]
    public void RefreshInvoiceTypeTemplates(short invoiceTypeCode) => _treeHost?.RequestRefreshTemplatesForInvoiceType(invoiceTypeCode);

    [JSInvokable]
    public void RefreshInvoiceTypeAttachments(short invoiceTypeCode) => _treeHost?.RequestRefreshTemplatesForInvoiceType(invoiceTypeCode);

    [JSInvokable]
    public void RefreshTemplateImages(int templateId) => _treeHost?.RequestRefreshTemplatesForInvoiceType(0);

    private async Task RefreshTemplateInvoicesTreeAsync(short invoiceTypeCode)
    {
        _treeHost?.RequestRefreshTemplatesForInvoiceType(invoiceTypeCode);
        await InvokeAsync(StateHasChanged);
    }

    private async Task RefreshFileTransferPageSizeAsync()
    {
        try
        {
            _fileTransferPageSize = await JSRuntime.InvokeAsync<int>("adminManager.getFileTransferPageSize");
        }
        catch
        {
            _fileTransferPageSize = 25;
        }
    }

    private Task HandleNodeSelectedAsync(ManagerTreeHost.ManagerNode node)
    {
        var previousNode = _selected;
        _selected = node;
        _iframeSrc = null;

        if (node == ManagerTreeHost.ManagerNode.EventViewer)
            _initialEventType = null;

        if (_isMobile)
        {
            if (node == ManagerTreeHost.ManagerNode.EventViewer)
            {
                var returnNode = previousNode == ManagerTreeHost.ManagerNode.EventViewer
                    ? ManagerTreeHost.ManagerNode.Root
                    : previousNode;

                NavigationManager.NavigateTo($"/Admin/Manager/Index?node=EventViewer&returnNode={returnNode}", forceLoad: true);
                return Task.CompletedTask;
            }

            if (node == ManagerTreeHost.ManagerNode.Setup)
            {
                var returnNode = previousNode == ManagerTreeHost.ManagerNode.Setup
                    ? ManagerTreeHost.ManagerNode.Root
                    : previousNode;

                NavigationManager.NavigateTo($"/Admin/Manager/Index?node=Setup&returnNode={returnNode}", forceLoad: true);
                return Task.CompletedTask;
            }

            if (node == ManagerTreeHost.ManagerNode.DemoData)
            {
                var returnNode = previousNode == ManagerTreeHost.ManagerNode.DemoData
                    ? ManagerTreeHost.ManagerNode.Root
                    : previousNode;

                NavigationManager.NavigateTo($"/Admin/Manager/Index?node=DemoData&returnNode={returnNode}", forceLoad: true);
                return Task.CompletedTask;
            }

            if (node == ManagerTreeHost.ManagerNode.FileTransfer)
            {
                var returnNode = previousNode == ManagerTreeHost.ManagerNode.FileTransfer
                    ? ManagerTreeHost.ManagerNode.Root
                    : previousNode;

                NavigationManager.NavigateTo($"/Admin/Manager/Index?node=FileTransfer&returnNode={returnNode}&pageSize={_fileTransferPageSize}", forceLoad: true);
                return Task.CompletedTask;
            }

            if (node == ManagerTreeHost.ManagerNode.FileTransferContentType)
                return Task.CompletedTask;

            if (node == ManagerTreeHost.ManagerNode.TemplateInvoices)
            {
                var returnNode = previousNode == ManagerTreeHost.ManagerNode.TemplateInvoices
                    ? ManagerTreeHost.ManagerNode.Templates
                    : previousNode;

                NavigationManager.NavigateTo($"/Admin/Manager/Index?node=TemplateInvoices&returnNode={returnNode}", forceLoad: true);
                return Task.CompletedTask;
            }

            if (node == ManagerTreeHost.ManagerNode.TemplateSystem)
            {
                var returnNode = previousNode == ManagerTreeHost.ManagerNode.TemplateSystem
                    ? ManagerTreeHost.ManagerNode.Templates
                    : previousNode;

                NavigationManager.NavigateTo($"/Admin/Manager/Index?node=TemplateSystem&returnNode={returnNode}", forceLoad: true);
                return Task.CompletedTask;
            }

            if (node == ManagerTreeHost.ManagerNode.Users)
            {
                var returnNode = previousNode == ManagerTreeHost.ManagerNode.Users
                    ? ManagerTreeHost.ManagerNode.Root
                    : previousNode;

                NavigationManager.NavigateTo($"/Admin/Manager/Index?node=Users&returnNode={returnNode}", forceLoad: true);
                return Task.CompletedTask;
            }

            if (node == ManagerTreeHost.ManagerNode.Periods)
            {
                var returnNode = previousNode == ManagerTreeHost.ManagerNode.Periods
                    ? ManagerTreeHost.ManagerNode.Root
                    : previousNode;

                NavigationManager.NavigateTo($"/Admin/Manager/Index?node=Periods&returnNode={returnNode}", forceLoad: true);
                return Task.CompletedTask;
            }

            if (node == ManagerTreeHost.ManagerNode.TaxSettings)
            {
                var returnNode = previousNode == ManagerTreeHost.ManagerNode.TaxSettings
                    ? ManagerTreeHost.ManagerNode.Root
                    : previousNode;

                NavigationManager.NavigateTo($"/Admin/Manager/Index?node=TaxSettings&returnNode={returnNode}", forceLoad: true);
                return Task.CompletedTask;
            }

            if (node == ManagerTreeHost.ManagerNode.TaxCode)
            {
                var returnNode = previousNode == ManagerTreeHost.ManagerNode.TaxCode
                    ? ManagerTreeHost.ManagerNode.Root
                    : previousNode;

                NavigationManager.NavigateTo($"/Admin/Manager/Index?node=TaxCode&returnNode={returnNode}", forceLoad: true);
                return Task.CompletedTask;
            }

            if (node == ManagerTreeHost.ManagerNode.TaxRates)
            {
                var returnNode = previousNode == ManagerTreeHost.ManagerNode.TaxRates
                    ? ManagerTreeHost.ManagerNode.Root
                    : previousNode;

                NavigationManager.NavigateTo($"/Admin/Manager/Index?node=TaxRates&returnNode={returnNode}", forceLoad: true);
                return Task.CompletedTask;
            }

            if (node == ManagerTreeHost.ManagerNode.Host)
            {
                var returnNode = previousNode == ManagerTreeHost.ManagerNode.Host
                    ? ManagerTreeHost.ManagerNode.Root
                    : previousNode;

                NavigationManager.NavigateTo($"/Admin/Manager/Index?node=Host&returnNode={returnNode}", forceLoad: true);
                return Task.CompletedTask;
            }

            if (node == ManagerTreeHost.ManagerNode.SubjectType)
            {
                var returnNode = previousNode == ManagerTreeHost.ManagerNode.SubjectType
                    ? ManagerTreeHost.ManagerNode.Root
                    : previousNode;

                NavigationManager.NavigateTo($"/Admin/Manager/Index?node=SubjectType&returnNode={returnNode}", forceLoad: true);
                return Task.CompletedTask;
            }

            if (node == ManagerTreeHost.ManagerNode.InvoiceSettings)
            {
                var returnNode = previousNode == ManagerTreeHost.ManagerNode.InvoiceSettings
                    ? ManagerTreeHost.ManagerNode.Root
                    : previousNode;

                NavigationManager.NavigateTo($"/Admin/Manager/Index?node=InvoiceSettings&returnNode={returnNode}", forceLoad: true);
                return Task.CompletedTask;
            }

            if (node == ManagerTreeHost.ManagerNode.Templates)
                NavigationManager.NavigateTo("/Admin/Manager/Index?node=Templates", forceLoad: true);

            return Task.CompletedTask;
        }

        if (node is ManagerTreeHost.ManagerNode.Root
            or ManagerTreeHost.ManagerNode.Setup
            or ManagerTreeHost.ManagerNode.DemoData
            or ManagerTreeHost.ManagerNode.FileTransfer
            or ManagerTreeHost.ManagerNode.FileTransferContentType
            or ManagerTreeHost.ManagerNode.TemplateInvoices
            or ManagerTreeHost.ManagerNode.TemplateSystem
            or ManagerTreeHost.ManagerNode.EventViewer
            or ManagerTreeHost.ManagerNode.Users
            or ManagerTreeHost.ManagerNode.Periods
            or ManagerTreeHost.ManagerNode.TaxSettings
            or ManagerTreeHost.ManagerNode.TaxCode
            or ManagerTreeHost.ManagerNode.TaxRates
            or ManagerTreeHost.ManagerNode.Host
            or ManagerTreeHost.ManagerNode.SubjectType
            or ManagerTreeHost.ManagerNode.InvoiceSettings)
        {
            return Task.CompletedTask;
        }

        _iframeSrc = null;
        return Task.CompletedTask;
    }

    private async Task HandleNodeSelectedExAsync((ManagerTreeHost.ManagerNode Node, string? ContentType) selection)
    {
        _selected = selection.Node;
        _selectedContentType = selection.ContentType;

        await RefreshFileTransferPageSizeAsync();

        if (_selected == ManagerTreeHost.ManagerNode.FileTransfer)
        {
            _selectedContentType = null;
            return;
        }

        if (_selected == ManagerTreeHost.ManagerNode.FileTransferContentType && !string.IsNullOrWhiteSpace(_selectedContentType))
        {
            if (_isMobile)
            {
                NavigationManager.NavigateTo($"/Admin/Manager/Index?node=FileTransferContentType&contentType={Uri.EscapeDataString(_selectedContentType)}&returnNode=FileTransfer&pageSize={_fileTransferPageSize}", forceLoad: true);
                return;
            }

            StateHasChanged();
        }
    }

    private Task NavigateToMobileTreeAsync()
    {
        var returnNode = _mobileReturnNode ?? ManagerTreeHost.ManagerNode.Root;

        if (returnNode == ManagerTreeHost.ManagerNode.Root)
        {
            NavigationManager.NavigateTo("/Admin/Manager/Index", forceLoad: true);
            return Task.CompletedTask;
        }

        NavigationManager.NavigateTo($"/Admin/Manager/Index?node={returnNode}", forceLoad: true);
        return Task.CompletedTask;
    }

    private async Task HandleTreeActionAsync(ManagerTreeHost.TreeAction action)
    {
        await RefreshFileTransferPageSizeAsync();

        if (action.ActionType == ManagerTreeHost.TreeActionType.FileTransferSync)
        {
            var contentType = !string.IsNullOrWhiteSpace(_selectedContentType)
                ? Uri.EscapeDataString(_selectedContentType)
                : "All";

            if (_isMobile)
            {
                NavigationManager.NavigateTo($"/Admin/FileTransfer/Index?handler=SyncFiles&returnNode=FileTransfer&contentType={contentType}&pageNumber=1&pageSize={_fileTransferPageSize}", forceLoad: true);
                return;
            }

            _iframeSrc = $"/Admin/FileTransfer/Index?handler=SyncFiles&embedded=1&returnNode=FileTransfer&contentType={contentType}&pageNumber=1&pageSize={_fileTransferPageSize}";
            return;
        }

        if (action.ActionType == ManagerTreeHost.TreeActionType.FileTransferUpload && !string.IsNullOrWhiteSpace(action.ContentType))
        {
            if (_isMobile)
            {
                NavigationManager.NavigateTo($"/Admin/FileTransfer/Upload?returnNode=FileTransfer&contentType={Uri.EscapeDataString(action.ContentType)}", forceLoad: true);
                return;
            }

            _selected = ManagerTreeHost.ManagerNode.FileTransferContentType;
            _selectedContentType = action.ContentType;
            _iframeSrc = $"/Admin/FileTransfer/Upload?embedded=1&returnNode=FileTransfer&contentType={Uri.EscapeDataString(action.ContentType)}";
        }
    }

    private Task HandleTemplateSelectionAsync(ManagerTreeHost.TemplateSelection selection)
    {
        _templateSelection = selection;
        _selected = ManagerTreeHost.ManagerNode.TemplateInvoices;
        _initialTemplateKey = selection.Key;
        _iframeSrc = null;

        if (_isMobile)
        {
            NavigationManager.NavigateTo($"/Admin/Manager/Index?node=TemplateInvoices&returnNode=Templates&templateKey={Uri.EscapeDataString(selection.Key)}", forceLoad: true);
            return Task.CompletedTask;
        }

        StateHasChanged();
        return Task.CompletedTask;
    }
}
