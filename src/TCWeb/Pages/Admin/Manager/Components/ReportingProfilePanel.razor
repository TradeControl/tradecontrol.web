@using System.Data
@using System.Globalization
@using System.Text.Json
@using System.Text.RegularExpressions
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.Data.SqlClient
@using Microsoft.EntityFrameworkCore
@using TradeControl.Web.Authorization
@using TradeControl.Web.Data
@inject NodeContext Db
@inject AuthenticationStateProvider AuthenticationStateProvider

<div class="d-flex flex-column h-100" style="min-height:0;overflow:auto">
@if (_loading) { <div class="text-muted p-3">Loading reporting profiles…</div> }
else if (!_admin) { <div class="alert alert-warning">Administrator access is required to maintain statutory reporting profiles.</div> }
else {
    @if (_message is not null) { <div class="alert @($"alert-{_tone}") py-2">@_message</div> }
    <p class="text-muted small">Maintain durable authority identifiers and filing settings for the home subject. Available configuration is determined by the node jurisdiction.</p>
    @if (_types.Count == 0) { <div class="alert alert-warning">No reporting types are configured for this jurisdiction.</div> }
    else {
    @if (_cards.Count > 1)
    {
        <ul class="nav nav-tabs mb-3" role="tablist" aria-label="Reporting profiles">
        @foreach (var card in _cards)
        {
            <li class="nav-item" role="presentation" @key="card.Code">
                <button type="button"
                        class="nav-link @(card.Code == _typeCode ? "active" : null)"
                        role="tab"
                        aria-selected="@(card.Code == _typeCode)"
                        @onclick="() => SelectTypeAsync(card.Code)">
                    @card.Name
                    <span class="badge @CardBadgeClass(card) ms-1">@CardState(card)</span>
                </button>
            </li>
        }
        </ul>
    }
    <div class="card mb-3"><div class="card-header d-flex justify-content-between"><span>@Selected?.Name</span><span class="badge @(_ready ? "text-bg-success" : "text-bg-warning")">@(_ready ? "Ready" : "Incomplete")</span></div>
    <div class="card-body"><div class="row g-3">
        <div class="col-12 col-lg-6"><label class="form-label">Reporting subject</label><input class="form-control" value="@_subjectName" disabled /></div>
        <div class="col-12 col-lg-6"><label class="form-label">Authority</label><input class="form-control" value="@Selected?.AuthorityName" disabled /></div>
        @if (Selected?.RequiresSource == true) {
        <div class="col-12 col-lg-6"><label class="form-label">Tax source</label><select class="form-select" @bind="_sourceCode"><option value="">Select a configured Tax Source</option>@foreach(var x in _sources){<option value="@x.Code">@x.Name (@x.Code)</option>}</select>@if(_sources.Count==0){<div class="form-text text-warning">No Tax Source is configured for this reporting type.</div>}</div> }
        <div class="col-12 col-lg-6"><label class="form-label">@Selected?.AuthorityName reference</label><input class="form-control" autocomplete="off" data-form-type="other" @bind="_authorityReference" /></div>
        @foreach(var x in _registrations){<div class="col-12 col-md-6" @key="x.Code"><label class="form-label">@x.Name</label><div class="input-group"><input class="form-control" type="text" style="@(x.Sensitive && !x.Revealed ? "-webkit-text-security:disc" : null)" autocomplete="off" data-form-type="other" spellcheck="false" @bind="x.Value" />@if(x.Sensitive){<button type="button" class="btn btn-outline-secondary" title="@(x.Revealed ? "Hide value" : "Show value")" aria-label="@(x.Revealed ? $"Hide {x.Name}" : $"Show {x.Name}")" @onclick="() => x.Revealed = !x.Revealed"><i class="bi @(x.Revealed ? "bi-eye-slash" : "bi-eye")" aria-hidden="true"></i></button>}</div>@if(x.Masked is not null&&!x.Revealed){<div class="form-text">Stored value: @x.Masked</div>}</div>}
        @foreach(var x in _settings){<div class="col-12 col-md-6" @key="x.Code"><label class="form-label">@x.Name</label>
            @if(x.Allowed.Count>0){<select class="form-select" @bind="x.Value"><option value="">Select a value</option>@foreach(var v in x.Allowed){<option value="@v">@Label(v)</option>}</select>}
            else if(x.Type=="BOOLEAN"){<select class="form-select" @bind="x.Value"><option value="">Not specified</option><option value="true">Yes</option><option value="false">No</option></select>}
            else {<input class="form-control" type="@InputType(x)" autocomplete="off" @bind="x.Value" />}
        </div>}
        <div class="col-12 col-md-4"><label class="form-label">Effective from</label><input type="date" class="form-control" @bind="_validFrom" @bind:format="yyyy-MM-dd" /></div>
        <div class="col-12 col-md-4 d-flex align-items-end"><div class="form-check mb-2"><input type="checkbox" class="form-check-input" id="profile-reviewed" @bind="_reviewed" /><label class="form-check-label" for="profile-reviewed">Reviewed and active</label></div></div>
    </div></div></div>
    @if(_findings.Count>0){<div class="card mb-3"><div class="card-header">Readiness findings</div><div class="list-group list-group-flush">@foreach(var x in _findings){<div class="list-group-item"><span class="badge @(x.Error ? "text-bg-danger" : "text-bg-warning") me-2">@x.Severity</span><b>@x.Code</b><span class="ms-2">@x.Message</span></div>}</div></div>}
    <div class="d-flex gap-2"><button class="btn btn-primary" @onclick="SaveAsync" disabled="@_saving">@(_saving ? "Saving…" : "Save profile")</button><button class="btn btn-outline-secondary" @onclick="ReloadAsync" disabled="@_saving">Reload</button></div>
    }
}
</div>

@code {
 [Parameter] public bool IsMobile {get;set;}
 sealed record RType(string Code,string Name,string AuthorityCode,string AuthorityName,bool RequiresSource);
 sealed record Source(string Code,string Name);
 sealed record ProfileCard(string Code,string Name,string AuthorityName,bool Configured,bool Reviewed,bool Active,string? TaxSourceName,int ErrorCount);
 sealed class Reg { public string Code=""; public string Name=""; public string? Pattern; public bool Sensitive; public bool Revealed; public bool ExistingActive; public string? RecordCode; public string? Value=""; public string? StoredValue; public string? Masked; public DateTime ValidFrom; }
 sealed class Setting { public string Code=""; public string Name=""; public string Type=""; public string? Pattern; public bool Sensitive; public List<string> Allowed=[]; public string Value=""; }
 sealed record Finding(string Code,string Severity,string Message){public bool Error=>Severity.Equals("ERROR",StringComparison.OrdinalIgnoreCase);}
 readonly List<RType> _types=[]; readonly List<ProfileCard> _cards=[]; readonly List<Source> _sources=[]; readonly List<Reg> _registrations=[]; readonly List<Setting> _settings=[]; readonly List<Finding> _findings=[];
 bool _admin,_loading=true,_saving,_ready,_reviewed; string _subject="",_subjectName="",_jurisdiction="",_typeCode="",_sourceCode="",_authorityReference="",_valueSource="",_tone="info"; string? _profileCode,_message; DateTime _validFrom=DateTime.Today; short _active,_inactive;
 RType? Selected=>_types.FirstOrDefault(x=>x.Code==_typeCode);
 protected override async Task OnInitializedAsync(){_admin=(await AuthenticationStateProvider.GetAuthenticationStateAsync()).User.IsInRole(Constants.AdministratorsRole);if(_admin)await ReloadAsync();else _loading=false;}
 async Task ReloadAsync(){_loading=true;_message=null;try{
   var o=await Db.App_tbOptions.AsNoTracking().SingleAsync();_subject=o.SubjectCode;_jurisdiction=o.JurisdictionCode;
   var n=await Db.Subject_tbSubjects.AsNoTracking().Where(x=>x.SubjectCode==_subject).Select(x=>x.SubjectName).SingleAsync();_subjectName=$"{n} ({_subject})";
   var statuses=await Db.App_tbStatutoryStatuses.AsNoTracking().ToListAsync();_active=statuses.Single(x=>x.IsActive).StatusCode;_inactive=statuses.First(x=>!x.IsActive).StatusCode;
   _valueSource=await Db.App_tbValueSources.AsNoTracking().Where(x=>x.ValueSourceCode=="USER").Select(x=>x.ValueSourceCode).SingleAsync();
   var applicableCodes=await Db.Cash_tbReportingProfiles.AsNoTracking().Where(x=>x.SubjectCode==_subject).Select(x=>x.ReportingTypeCode).Distinct().ToListAsync();
   _types.Clear();_types.AddRange(await(from t in Db.App_tbReportingTypes.AsNoTracking() join a in Db.App_tbAuthorities.AsNoTracking() on t.AuthorityCode equals a.AuthorityCode where applicableCodes.Contains(t.ReportingTypeCode)&&t.IsEnabled&&a.IsEnabled&&a.JurisdictionCode==_jurisdiction orderby a.AuthorityName,t.ReportingTypeName select new RType(t.ReportingTypeCode,t.ReportingTypeName,a.AuthorityCode,a.AuthorityName,t.RequiresTaxSource)).ToListAsync());
   var existing=await Db.Cash_tbReportingProfiles.AsNoTracking().Where(x=>x.SubjectCode==_subject).OrderByDescending(x=>x.ValidFrom).Select(x=>x.ReportingTypeCode).FirstOrDefaultAsync();
   if(!_types.Any(x=>x.Code==_typeCode))_typeCode=_types.Any(x=>x.Code==existing)?existing!:_types.FirstOrDefault()?.Code??"";await RefreshCardsAsync();if(_typeCode!="")await LoadTypeAsync();
 }catch(Exception ex){_message="Unable to load the reporting profiles.";_tone="danger";await Db.ErrorLog(ex);}finally{_loading=false;}}
 async Task SelectTypeAsync(string code){if(code==_typeCode)return;_typeCode=code;_message=null;await LoadTypeAsync();}
 async Task LoadTypeAsync(){var type=Selected??throw new InvalidOperationException("Select a reporting type.");
   var p=await Db.Cash_tbReportingProfiles.AsNoTracking().Where(x=>x.SubjectCode==_subject&&x.ReportingTypeCode==type.Code).OrderByDescending(x=>x.ValidFrom).FirstOrDefaultAsync();
   _sources.Clear();_sources.AddRange(await Db.Cash_tbTaxTagSources.AsNoTracking().Where(x=>x.ReportingTypeCode==type.Code).OrderBy(x=>x.SourceName).Select(x=>new Source(x.TaxSourceCode,x.SourceName)).ToListAsync());
   var schemeCodes=Db.App_tbReportingTypeRegistrationSchemes.AsNoTracking().Where(x=>x.ReportingTypeCode==type.Code).Select(x=>x.RegistrationSchemeCode);var schemes=await Db.App_tbRegistrationSchemes.AsNoTracking().Where(x=>schemeCodes.Contains(x.RegistrationSchemeCode)&&x.IsEnabled).OrderBy(x=>x.SchemeName).ToListAsync();var regs=await Db.Subject_tbRegistrations.AsNoTracking().Where(x=>x.SubjectCode==_subject).OrderByDescending(x=>x.ValidFrom).ToListAsync();_registrations.Clear();foreach(var s in schemes){var r=regs.FirstOrDefault(x=>x.RegistrationSchemeCode==s.RegistrationSchemeCode);var active=r?.StatusCode==_active;_registrations.Add(new(){Code=s.RegistrationSchemeCode,Name=s.SchemeName,Pattern=s.ValidationPattern,Sensitive=s.IsSensitive,ExistingActive=active,RecordCode=r?.RegistrationCode,Value=active?r?.RegistrationValue:"",StoredValue=r?.RegistrationValue,Masked=active&&s.IsSensitive?Mask(r?.RegistrationValue):null,ValidFrom=r?.ValidFrom??_validFrom});}
   var defs=await Db.App_tbSettingDefinitions.AsNoTracking().Where(x=>x.IsEnabled&&x.ReportingTypeCode==type.Code&&(x.JurisdictionCode==null||x.JurisdictionCode==_jurisdiction)&&(x.AuthorityCode==null||x.AuthorityCode==type.AuthorityCode)).OrderBy(x=>x.SettingName).ToListAsync();var vals=p is null?[]:await Db.Cash_tbReportingProfileSettings.AsNoTracking().Where(x=>x.SubjectCode==_subject&&x.ReportingProfileCode==p.ReportingProfileCode).OrderByDescending(x=>x.EffectiveFrom).ToListAsync();_settings.Clear();foreach(var d in defs){var v=vals.FirstOrDefault(x=>x.SettingCode==d.SettingCode);_settings.Add(new(){Code=d.SettingCode,Name=d.SettingName,Type=d.ValueTypeCode.ToUpperInvariant(),Pattern=d.ValidationPattern,Sensitive=d.IsSensitive,Allowed=Allowed(d.AllowedValues),Value=Format(v,d.ValueTypeCode)});}
   _profileCode=p?.ReportingProfileCode;_sourceCode=p?.TaxSourceCode??_sources.FirstOrDefault()?.Code??"";_authorityReference=p?.AuthorityReference??"";_validFrom=p?.ValidFrom??DateTime.Today;_reviewed=p?.IsReviewed==true;await ReadinessAsync();}
 async Task SaveAsync(){_saving=true;_message=null;try{Validate();await using var tx=await Db.Database.BeginTransactionAsync();foreach(var r in _registrations.Where(x=>!string.IsNullOrWhiteSpace(x.Value)||x.ExistingActive))r.RecordCode=await SaveRegAsync(r);_profileCode=await SaveProfileAsync();foreach(var s in _settings.Where(x=>!string.IsNullOrWhiteSpace(x.Value)))await SaveSettingAsync(s);await tx.CommitAsync();Db.ChangeTracker.Clear();_message="Reporting profile updated.";_tone="success";await LoadTypeAsync();await RefreshCardsAsync();if(_reviewed&&!_ready){_message="The profile was saved but remains incomplete. Review the readiness findings below.";_tone="warning";}}
   catch(Exception ex){_message=Friendly(ex);_tone="danger";try{if(ex is not InvalidOperationException)await Db.ErrorLog(ex);}catch{/* Preserve the Blazor circuit if secondary error logging fails. */}}finally{_saving=false;}}
 void Validate(){var t=Selected??throw new InvalidOperationException("Select a reporting type.");if(t.RequiresSource&&string.IsNullOrWhiteSpace(_sourceCode))throw new InvalidOperationException("Select a configured Tax Source.");foreach(var r in _registrations.Where(x=>!string.IsNullOrWhiteSpace(x.Value)&&x.Pattern is not null))if(!Regex.IsMatch(r.Value!.Trim().ToUpperInvariant(),r.Pattern!))throw new InvalidOperationException($"{r.Name} is not in the required format.");foreach(var s in _settings.Where(x=>x.Value!="")){if(s.Allowed.Count>0&&!s.Allowed.Contains(s.Value))throw new InvalidOperationException($"{s.Name} is not an allowed value.");Parse(s);}}
 async Task<string?> SaveRegAsync(Reg r){var removing=string.IsNullOrWhiteSpace(r.Value);var output=Out("@RegistrationCode",r.RecordCode);var value=new SqlParameter("@Value",SqlDbType.NVarChar,255){Value=removing?DBNull.Value:r.Value!.Trim().ToUpperInvariant()};await Db.Database.ExecuteSqlRawAsync("EXEC Subject.proc_RegistrationSave @SubjectCode,@Scheme,@Value,@ValidFrom,NULL,@Status,@Source,@Reviewed,@RegistrationCode OUTPUT",new SqlParameter("@SubjectCode",_subject),new SqlParameter("@Scheme",r.Code),value,new SqlParameter("@ValidFrom",removing?r.ValidFrom:_validFrom.Date),new SqlParameter("@Status",removing?_inactive:(_reviewed?_active:_inactive)),new SqlParameter("@Source",_valueSource),new SqlParameter("@Reviewed",!removing&&_reviewed),output);return Convert.ToString(output.Value);}
 async Task<string?> SaveProfileAsync(){var output=Out("@ProfileCode",_profileCode);await Db.Database.ExecuteSqlRawAsync("EXEC Cash.proc_ReportingProfileSave @SubjectCode,@Type,@TaxSource,@Reference,@ValidFrom,NULL,@Status,@Source,@Reviewed,@ProfileCode OUTPUT",new SqlParameter("@SubjectCode",_subject),new SqlParameter("@Type",_typeCode),new SqlParameter("@TaxSource",DbNull(_sourceCode)),new SqlParameter("@Reference",DbNull(_authorityReference)),new SqlParameter("@ValidFrom",_validFrom.Date),new SqlParameter("@Status",_reviewed?_active:_inactive),new SqlParameter("@Source",_valueSource),new SqlParameter("@Reviewed",_reviewed),output);return Convert.ToString(output.Value);}
 async Task SaveSettingAsync(Setting s){if(_profileCode is null)throw new InvalidOperationException("Reporting profile code was not generated.");var v=Parse(s);await Db.Database.ExecuteSqlRawAsync("EXEC Cash.proc_ReportingProfileSettingSave @Subject,@Profile,@Setting,@From,NULL,@Text,@Integer,@Decimal,@Date,@Boolean,@Status,@Source,@Reviewed",new SqlParameter("@Subject",_subject),new SqlParameter("@Profile",_profileCode),new SqlParameter("@Setting",s.Code),new SqlParameter("@From",_validFrom.Date),new SqlParameter("@Text",v.text??DBNull.Value),new SqlParameter("@Integer",v.integer??DBNull.Value),new SqlParameter("@Decimal",v.decimalValue??DBNull.Value),new SqlParameter("@Date",v.date??DBNull.Value),new SqlParameter("@Boolean",v.boolean??DBNull.Value),new SqlParameter("@Status",_reviewed?_active:_inactive),new SqlParameter("@Source",_valueSource),new SqlParameter("@Reviewed",_reviewed));}
 async Task ReadinessAsync(){_findings.Clear();var c=Db.Database.GetDbConnection();var close=c.State!=ConnectionState.Open;if(close)await c.OpenAsync();try{await using var q=c.CreateCommand();q.CommandText="SELECT FindingCode,SeverityCode,FindingMessage FROM App.fnStatutoryContextReadiness(@Subject,@Type,@Source,NULL,NULL,@Date)";q.Parameters.Add(new SqlParameter("@Subject",_subject));q.Parameters.Add(new SqlParameter("@Type",_typeCode));q.Parameters.Add(new SqlParameter("@Source",DbNull(_sourceCode)));q.Parameters.Add(new SqlParameter("@Date",DateTime.Today));await using var reader=await q.ExecuteReaderAsync();while(await reader.ReadAsync())_findings.Add(new(reader.GetString(0),reader.GetString(1),reader.GetString(2)));}finally{if(close)await c.CloseAsync();}_ready=_reviewed&&_findings.All(x=>!x.Error);}
 async Task RefreshCardsAsync(){
   var profiles=await Db.Cash_tbReportingProfiles.AsNoTracking().Where(x=>x.SubjectCode==_subject).OrderByDescending(x=>x.ValidFrom).ToListAsync();
   var sources=await Db.Cash_tbTaxTagSources.AsNoTracking().ToDictionaryAsync(x=>x.TaxSourceCode,x=>x.SourceName);
   _cards.Clear();foreach(var type in _types){var p=profiles.FirstOrDefault(x=>x.ReportingTypeCode==type.Code);var errors=await ReadinessErrorCountAsync(type.Code,p?.TaxSourceCode);_cards.Add(new(type.Code,type.Name,type.AuthorityName,p is not null,p?.IsReviewed==true,p?.StatusCode==_active,p?.TaxSourceCode is not null&&sources.TryGetValue(p.TaxSourceCode,out var name)?name:null,errors));}}
 async Task<int> ReadinessErrorCountAsync(string typeCode,string? sourceCode){var count=0;var c=Db.Database.GetDbConnection();var close=c.State!=ConnectionState.Open;if(close)await c.OpenAsync();try{await using var q=c.CreateCommand();q.CommandText="SELECT COUNT(*) FROM App.fnStatutoryContextReadiness(@Subject,@Type,@Source,NULL,NULL,@Date) WHERE SeverityCode=N'ERROR'";q.Parameters.Add(new SqlParameter("@Subject",_subject));q.Parameters.Add(new SqlParameter("@Type",typeCode));q.Parameters.Add(new SqlParameter("@Source",DbNull(sourceCode)));q.Parameters.Add(new SqlParameter("@Date",DateTime.Today));count=Convert.ToInt32(await q.ExecuteScalarAsync());}finally{if(close)await c.CloseAsync();}return count;}
 static string CardState(ProfileCard card)=>!card.Configured?"Not configured":card.ErrorCount>0?"Incomplete":card.Reviewed&&card.Active?"Ready":"Review required";
 static string CardBadgeClass(ProfileCard card)=>!card.Configured?"text-bg-secondary":card.ErrorCount>0?"text-bg-danger":card.Reviewed&&card.Active?"text-bg-success":"text-bg-warning";
 static string Friendly(Exception ex)=>ex is InvalidOperationException?ex.Message:ex.Message.Contains("UX_Cash_tbReportingProfile_AuthorityReference",StringComparison.OrdinalIgnoreCase)||ex.Message.Contains("Cannot insert duplicate key",StringComparison.OrdinalIgnoreCase)?"That authority reference is already assigned to another reporting profile. Check that the browser has not filled this field with your sign-in email.":"Unable to update the reporting profile.";
 static SqlParameter Out(string name,string? value)=>new(name,SqlDbType.NVarChar,20){Direction=ParameterDirection.InputOutput,Value=(object?)value??DBNull.Value};static object DbNull(string? x)=>string.IsNullOrWhiteSpace(x)?DBNull.Value:x.Trim();
 static (object? text,object? integer,object? decimalValue,object? date,object? boolean) Parse(Setting s)=>s.Type switch{"INTEGER"=>(null,long.Parse(s.Value,CultureInfo.InvariantCulture),null,null,null),"DECIMAL"=>(null,null,decimal.Parse(s.Value,CultureInfo.InvariantCulture),null,null),"DATE"=>(null,null,null,DateTime.Parse(s.Value,CultureInfo.InvariantCulture).Date,null),"BOOLEAN"=>(null,null,null,null,bool.Parse(s.Value)),_=>(s.Value,null,null,null,null)};
 static string Format(Models.Cash_tbReportingProfileSetting? v,string type)=>type.ToUpperInvariant() switch{"INTEGER"=>v?.IntegerValue?.ToString(CultureInfo.InvariantCulture)??"","DECIMAL"=>v?.DecimalValue?.ToString(CultureInfo.InvariantCulture)??"","DATE"=>v?.DateValue?.ToString("yyyy-MM-dd")??"","BOOLEAN"=>v?.BooleanValue?.ToString()?.ToLowerInvariant()??"",_=>v?.TextValue??""};
 static List<string> Allowed(string? json){try{return string.IsNullOrWhiteSpace(json)?[]:JsonSerializer.Deserialize<List<string>>(json)??[];}catch(JsonException){return[];}}static string InputType(Setting s)=>s.Sensitive?"password":s.Type is "INTEGER" or "DECIMAL"?"number":s.Type=="DATE"?"date":"text";static string Label(string x)=>CultureInfo.CurrentCulture.TextInfo.ToTitleCase(x.Replace('-',' ').ToLowerInvariant());static string? Mask(string? x)=>string.IsNullOrWhiteSpace(x)?null:new string('*',Math.Max(0,x.Length-2))+x[^Math.Min(2,x.Length)..];
}
