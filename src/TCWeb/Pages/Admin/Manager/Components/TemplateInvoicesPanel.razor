    private TemplateInvoicesTab ResolveInitialTab()
    {
        return Selection?.Kind switch
        {
            "AttachmentsFolder" or "Attachment" => TemplateInvoicesTab.Attachments,
            "ImagesFolder" or "Image" => TemplateInvoicesTab.Images,
            _ => TemplateInvoicesTab.Templates
        };
    }

    private static bool TryGetInvoiceTypeCode(string? key, out short invoiceTypeCode)
    {
        invoiceTypeCode = default;

        if (string.IsNullOrWhiteSpace(key))
            return false;

        if (!key.StartsWith("invoiceType:", StringComparison.OrdinalIgnoreCase))
            return false;

        var parts = key.Split(':');
        return parts.Length >= 2 && short.TryParse(parts[1], out invoiceTypeCode);
    }

    private static bool TryGetTemplateId(string? key, out int templateId)
    {
        templateId = default;

        if (string.IsNullOrWhiteSpace(key))
            return false;

        var parts = key.Split(':');

        for (var i = 0; i < parts.Length - 1; i++)
        {
            if (string.Equals(parts[i], "template", StringComparison.OrdinalIgnoreCase)
                && int.TryParse(parts[i + 1], out templateId))
            {
                return true;
            }
        }

        return false;
    }

    private static IReadOnlyList<ParseSection> GetErrorSections(TemplateParseResult result)
    {
        return
        [
            new ParseSection { Title = "Invalid field tags", Items = result.InvalidFieldTags },
            new ParseSection { Title = "Missing embed directives", Items = result.MissingEmbedDirectives },
            new ParseSection { Title = "Missing embedded templates", Items = result.MissingEmbedTemplates },
            new ParseSection { Title = "Invalid embedded templates", Items = result.InvalidEmbedTemplates },
            new ParseSection { Title = "Missing required output tags", Items = result.MissingRequiredOutputTags },
            new ParseSection { Title = "Image tags without assignment", Items = result.ImageTagsWithoutAssignment },
            new ParseSection { Title = "Assigned images missing files", Items = result.AssignedImagesMissingFiles }
        ];
    }

    private static IReadOnlyList<ParseSection> GetWarningSections(TemplateParseResult result)
    {
        return
        [
            new ParseSection { Title = "Assigned image tags without usage", Items = result.AssignedImageTagsWithoutUsage },
            new ParseSection { Title = "Unused available fields", Items = result.UnusedAvailableFields }
        ];
    }
