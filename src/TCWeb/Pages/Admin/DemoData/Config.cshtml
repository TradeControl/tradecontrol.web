@page
@model TradeControl.Web.Pages.Admin.DemoData.ConfigModel
@{
    ViewData["Title"] = "Synthetic Demo Data Setup";

    var embedded = false;
    if (Request?.Query.ContainsKey("embedded") == true)
    {
        embedded = string.Equals(Request.Query["embedded"], "1", StringComparison.OrdinalIgnoreCase)
            || string.Equals(Request.Query["embedded"], "true", StringComparison.OrdinalIgnoreCase);
    }

    var returnNode = (Request?.Query.ContainsKey("returnNode") == true)
        ? (Request.Query["returnNode"].ToString() ?? string.Empty)
        : string.Empty;

    if (embedded)
    {
        Layout = "/Pages/Shared/_EmbeddedLayout.cshtml";
    }

    var cancelHref = embedded
        ? (!string.IsNullOrWhiteSpace(returnNode)
            ? $"/Admin/DemoData/Index?embedded=1&returnNode={Uri.EscapeDataString(returnNode)}"
            : "/Admin/DemoData/Index?embedded=1")
        : (!string.IsNullOrWhiteSpace(returnNode)
            ? $"/Admin/Manager/Index?node={Uri.EscapeDataString(returnNode)}"
            : "/Admin/Manager/Index");
}

<div class="container-fluid py-2">
    @if (!embedded)
    {
        <h1 class="h4 mb-3">@ViewData["Title"]</h1>
    }

    <form method="post" class="tc-setup-form">
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

        <div class="row g-3">
            <div class="col-12 col-lg-6 d-flex">
                <div class="card shadow-sm h-100 w-100">
                    <div class="card-header bg-white">
                        <div class="fw-semibold">Template</div>
                        <div class="text-muted small">Select a template and matching synthetic scenario.</div>
                    </div>
                    <div class="card-body">
                        <div class="mb-3">
                            <label asp-for="DemoData.TemplateName" class="form-label"></label>
                            <select asp-for="DemoData.TemplateName"
                                    asp-items="Model.TemplateNames"
                                    class="form-control"
                                    id="templateName"></select>
                            <div class="alert alert-info mt-2 mb-0" role="note" id="templateDescription"></div>
                        </div>

                        <div class="d-flex align-items-center justify-content-between gap-3 flex-wrap">
                            <div>
                                <div class="fw-semibold">VAT registration</div>
                                <div class="text-muted small">The available scenarios are filtered by the current VAT setting.</div>
                            </div>

                            <input asp-for="DemoData.IsVatRegistered" type="hidden" id="isVatRegistered" />

                            <button type="button"
                                    class="btn"
                                    id="vatToggle"
                                    aria-pressed="false">
                                VAT: Off
                            </button>
                        </div>

                        <hr class="my-3" />

                        <div>
                            <label asp-for="DemoData.DatasetCode" class="form-label"></label>
                            <select asp-for="DemoData.DatasetCode" class="form-control" id="datasetCode">
                                <option value="">-- Select synthetic dataset --</option>
                            </select>
                            <span asp-validation-for="DemoData.DatasetCode" class="text-danger"></span>
                            <div class="form-text" id="datasetHint">Select a scenario to queue synthetic demo data installation.</div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-12">
                <div class="d-flex gap-2 flex-wrap">
                    <button type="submit" class="btn btn-primary">Queue synthetic dataset</button>
                    <a href="@cancelHref" class="btn btn-outline-secondary">Cancel</a>
                </div>
            </div>
        </div>
    </form>
</div>

<script>
    (function ()
    {
        const descriptions = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.TemplateDescriptions));
        const vatDefaults = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.TemplateVatDefaults));
        const datasetMap = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.TemplateDatasets));
        const initialDatasetCode = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.DemoData?.DatasetCode ?? string.Empty));

        const templateSelect = document.getElementById("templateName");
        const descriptionBox = document.getElementById("templateDescription");
        const vatToggle = document.getElementById("vatToggle");
        const vatField = document.getElementById("isVatRegistered");
        const datasetSelect = document.getElementById("datasetCode");
        const datasetHint = document.getElementById("datasetHint");

        if (!templateSelect || !descriptionBox || !vatToggle || !vatField || !datasetSelect)
        {
            return;
        }

        function escapeHtml(text)
        {
            const span = document.createElement("span");
            span.textContent = text || "";
            return span.innerHTML;
        }

        function getVatState()
        {
            return vatField.value === "true";
        }

        function getTemplateDatasets()
        {
            const templateName = templateSelect.value;
            return datasetMap[templateName] || [];
        }

        function getFilteredDatasets()
        {
            const isVat = getVatState();

            return getTemplateDatasets().filter(function (item)
            {
                if (item.IsVatRegistered === null || item.IsVatRegistered === undefined)
                {
                    return true;
                }

                return item.IsVatRegistered === isVat;
            });
        }

        function setVatVisual(isVat)
        {
            vatField.value = isVat ? "true" : "false";
            vatToggle.setAttribute("aria-pressed", isVat ? "true" : "false");
            vatToggle.textContent = isVat ? "VAT: On" : "VAT: Off";

            vatToggle.classList.remove("btn-success", "btn-danger");
            vatToggle.classList.add(isVat ? "btn-success" : "btn-danger");
        }

        function populateDatasetOptions(preferredValue)
        {
            const datasets = getFilteredDatasets();

            datasetSelect.innerHTML = "";

            const blank = document.createElement("option");
            blank.value = "";
            blank.textContent = "-- Select synthetic dataset --";
            datasetSelect.appendChild(blank);

            datasets.forEach(function (item)
            {
                const option = document.createElement("option");
                option.value = item.DatasetCode;
                option.textContent = item.DatasetTitle;
                datasetSelect.appendChild(option);
            });

            if (preferredValue && datasets.some(function (item) { return item.DatasetCode === preferredValue; }))
            {
                datasetSelect.value = preferredValue;
            }
            else
            {
                datasetSelect.value = "";
            }

            if (datasetHint)
            {
                datasetHint.textContent = datasets.length === 0
                    ? "No synthetic scenarios are available for the current template and VAT setting."
                    : "Select a scenario to queue synthetic demo data installation.";
            }
        }

        function setDescription()
        {
            const parts = [];
            const templateText = descriptions[templateSelect.value] || "";
            const selectedCode = datasetSelect.value;
            const selectedDataset = getFilteredDatasets().find(function (item)
            {
                return item.DatasetCode === selectedCode;
            });

            if (templateText.length > 0)
            {
                parts.push(templateText);
            }

            if (selectedDataset && selectedDataset.Notes)
            {
                parts.push(selectedDataset.Notes);
            }

            if (parts.length === 0)
            {
                descriptionBox.innerHTML = "";
                descriptionBox.style.display = "none";
                return;
            }

            descriptionBox.innerHTML = parts.map(function (text, index)
            {
                const css = index === parts.length - 1 ? "mb-0" : "mb-2";
                return `<p class="${css}">${escapeHtml(text)}</p>`;
            }).join("");

            descriptionBox.style.display = "";
        }

        function setVatDefaultFromTemplate()
        {
            const templateName = templateSelect.value;
            const isVat = !!vatDefaults[templateName];
            setVatVisual(isVat);
        }

        templateSelect.addEventListener("change", function ()
        {
            setVatDefaultFromTemplate();
            populateDatasetOptions("");
            setDescription();
        });

        vatToggle.addEventListener("click", function ()
        {
            setVatVisual(!getVatState());
            populateDatasetOptions("");
            setDescription();
        });

        datasetSelect.addEventListener("change", function ()
        {
            setDescription();
        });

        setVatDefaultFromTemplate();
        populateDatasetOptions(initialDatasetCode);
        setDescription();
    })();
</script>
