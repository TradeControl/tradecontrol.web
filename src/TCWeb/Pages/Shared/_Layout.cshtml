@using Microsoft.AspNetCore.Identity
@using TradeControl.Web.Areas.Identity.Data
@using TradeControl.Web.Data
@using TradeControl.Web.Tenancy
@inject Wangkanai.Detection.Services.IDetectionService Detection
@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery
@inject ITenantContext TenantContext
@inject UserManager<TradeControlWebUser> UserManager
@inject NodeContext NodeContext

@{
    var requestVerificationToken = Antiforgery.GetAndStoreTokens(ViewContext.HttpContext).RequestToken;
    var themeCssFile = "theme-blue.css";
    var companyName = ViewData["CompanyName"] as string;

    if (string.IsNullOrWhiteSpace(companyName) && TenantContext.IsResolved)
        companyName = await NodeContext.CompanyName();

    if (string.IsNullOrWhiteSpace(companyName))
        companyName = "Trade Control";

    ViewData["CompanyName"] = companyName;

    if (User?.Identity?.IsAuthenticated == true && TenantContext.IsResolved)
    {
        var user = await UserManager.GetUserAsync(User);
        if (user != null)
        {
            var profile = new Profile(NodeContext);
            themeCssFile = await profile.GetUserThemeCssFile(user.Id);
        }
    }
}
<meta name="request-verification-token" content="@requestVerificationToken" />

<!DOCTYPE html>
<html lang="en">
<head>
    <base href="~/" />
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - @companyName</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css"
          integrity="sha384-tViUnnbYAV00FLIhhi3v/dWt3Jxw4gZQcNoSCxCIFNJVCx7/D55/wXsrNIRANwdD"
          crossorigin="anonymous" />
    <link rel="stylesheet" href="~/css/base.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/themes/@themeCssFile" asp-append-version="true" />
    <link rel="icon" type="image/svg+xml" href="~/favicon.svg" />
    <!-- Optional fallbacks (recommended for older browsers) -->
    <!-- <link rel="icon" type="image/png" href="~/favicon.png" /> -->
    <!-- <link rel="shortcut icon" href="~/favicon.ico" /> -->
</head>
<body class="@ViewData["BodyClass"]">
    <partial name="_Navigation" />
    <div class="container-fluid">
        <div>
            <main role="main">
                @RenderBody()
            </main>
        </div>
    </div>

    <partial name="_Footer" model="Detection" />
    <partial name="_DisplayControls" />

    <script src="~/lib/jquery/dist/jquery.min.js" asp-append-version="true"></script>

    <environment include="Development">
        <script src="~/lib/jquery-validation/dist/jquery.validate.js" asp-append-version="true"></script>
        <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.js" asp-append-version="true"></script>
    </environment>
    <environment exclude="Development">
        <script src="~/lib/jquery-validation/dist/jquery.validate.min.js" asp-append-version="true"></script>
        <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js" asp-append-version="true"></script>
    </environment>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @RenderSection("Scripts", required: false)
</body>
</html>
